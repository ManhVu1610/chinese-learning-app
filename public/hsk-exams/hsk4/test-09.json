ext":"CBA"},{"label":"D","text":"CAB"}]},{"n":60,"type":"reading_ordering","section":"reading","answer":0,"part":2,"sentences":[{"label":"A","text":"和暑假比起来，我还是比较喜欢寒假"},{"label":"B","text":"因为过寒假时有最重要的节日——春节"},{"label":"C","text":"并且我的生日也在寒假"}],"orders":["ABC","BAC","CBA","CAB"],"options":[{"label":"A","text":"ABC"},{"label":"B","text":"BAC"},{"label":"C","text":"CBA"},{"label":"D","text":"CAB"}]},{"n":61,"type":"reading_ordering","section":"reading","answer":1,"part":2,"sentences":[{"label":"A","text":"一定要允许其他人有反对意见"},{"label":"B","text":"一个合格的公司管理者"},{"label":"C","text":"甚至表达自己的不满"}],"orders":["ABC","BAC","CBA","CAB"],"options":[{"label":"A","text":"ABC"},{"label":"B","text":"BAC"},{"label":"C","text":"CBA"},{"label":"D","text":"CAB"}]},{"n":62,"type":"reading_ordering","section":"reading","answer":1,"part":2,"sentences":[{"label":"A","text":"最好先弄清楚究竟是怎么回事"},{"label":"B","text":"生气多是由误会引起的"},{"label":"C","text":"因此当你觉得自己要生气的时候"}],"orders":["ABC","BCA","CBA","CAB"],"options":[{"label":"A","text":"ABC"},{"label":"B","text":"BCA"},{"label":"C","text":"CBA"},{"label":"D","text":"CAB"}]},{"n":63,"type":"reading_ordering","section":"reading","answer":1,"part":2,"sentences":[{"label":"A","text":"还有判断力，有时候是十分危险的"},{"label":"B","text":"走路的时候戴着耳机听音乐"},{"label":"C","text":"会影响你的注意力"}],"orders":["ABC","BCA","CBA","CAB"],"options":[{"label":"A","text":"ABC"},{"label":"B","text":"BCA"},{"label":"C","text":"CBA"},{"label":"D","text":"CAB"}]},{"n":64,"type":"reading_ordering","section":"reading","answer":0,"part":2,"sentences":[{"label":"A","text":"参加了那么多场国际比赛，你紧张吗"},{"label":"B","text":"中国著名运动员邓亚萍的回答是"},{"label":"C","text":"想赢就不会紧张，怕输才紧张"}],"orders":["ABC","BAC","CBA","CAB"],"options":[{"label":"A","text":"ABC"},{"label":"B","text":"BAC"},{"label":"C","text":"CBA"},{"label":"D","text":"CAB"}]},{"n":65,"type":"reading_ordering","section":"reading","answer":0,"part":2,"sentences":[{"label":"A","text":"我觉得你暂时先别考虑出国留学"},{"label":"B","text":"至少你得先打好语言基础"},{"label":"C","text":"否则，在国外和人们交流都会有困难"}],"orders":["ABC","BAC","CBA","CAB"],"options":[{"label":"A","text":"ABC"},{"label":"B","text":"BAC"},{"label":"C","text":"CBA"},{"label":"D","text":"CAB"}]},{"n":66,"type":"reading_comprehension","section":"reading","answer":3,"part":3,"passage":"阅读短文：篮球不是一个人的运动或表演。即使你很厉害、很优秀，没有其他球员的努力，也不能赢得一场比赛。篮球需要所有球员的共同努力。","question":"问题：根据这段话，打篮球需要：","options":[{"label":"A","text":"个子高"},{"label":"B","text":"热情的观众"},{"label":"C","text":"丰富的经验"},{"label":"D","text":"大家一起努力"}]},{"n":67,"type":"reading_comprehension","section":"reading","answer":2,"part":3,"passage":"阅读短文：一般来说，睡觉时间短的人比睡觉时间长的人更容易长胖。据调查，每天睡7到8小时的人，要比每天睡5到6小时的人瘦。","question":"问题：调查结果说明：","options":[{"label":"A","text":"做梦不好"},{"label":"B","text":"要多跑步"},{"label":"C","text":"睡觉少易变胖"},{"label":"D","text":"早起床对身体好"}]},{"n":68,"type":"reading_comprehension","section":"reading","answer":0,"part":3,"passage":"阅读短文：广告越来越多，几乎无处不在。不只是广播、电视、网站有广告，公共汽车、地铁上也有很多广告，连我家的电梯里都挂着三个广告。广告虽然给我们带来很多方便，但数量太多也会让人觉得讨厌。","question":"问题：作者认为广告：","options":[{"label":"A","text":"太多了"},{"label":"B","text":"内容无聊"},{"label":"C","text":"很受欢迎"},{"label":"D","text":"范围要扩大"}]},{"n":69,"type":"reading_comprehension","section":"reading","answer":1,"part":3,"passage":"阅读短文：\"读书好，读好书，好读书。\"首先，说的是读书有很多好处；其次，每个人的时间都是有限的，不可能把世界上每一本书都读完，所以要读好的书；最后，就是要养成阅读的习惯，使读书真正成为自己的兴趣爱好。","question":"问题：根据这段话，读书：","options":[{"label":"A","text":"需要耐心"},{"label":"B","text":"需要选择"},{"label":"C","text":"有时间限制"},{"label":"D","text":"能改变性格"}]},{"n":70,"type":"reading_comprehension","section":"reading","answer":3,"part":3,"passage":"阅读短文：很多大学生毕业后，选择的第一个职业，往往和自己的专业没什么关系，这种情况现在越来越普遍。","question":"问题：许多大学生的第一份工作往往：","options":[{"label":"A","text":"挺辛苦"},{"label":"B","text":"没意思"},{"label":"C","text":"工资很低"},{"label":"D","text":"与专业不符"}]},{"n":71,"type":"reading_comprehension","section":"reading","answer":1,"part":3,"passage":"阅读短文：先生，对不起，我们宾馆有规定，这里禁止抽烟。前面有专门的抽烟室，往前走就能看到，就在楼梯右边，请。","question":"问题：抽烟室在：","options":[{"label":"A","text":"厨房左边"},{"label":"B","text":"楼梯旁边"},{"label":"C","text":"宾馆外面"},{"label":"D","text":"会议室对面"}]},{"n":72,"type":"reading_comprehension","section":"reading","answer":1,"part":3,"passage":"阅读短文：一个城市的交通，反映这个城市的经济发展水平，尤其是公共交通，对社会的发展有很大影响。","question":"问题：根据这段话，为了社会的发展，城市应该：","options":[{"label":"A","text":"发展文化"},{"label":"B","text":"重视交通"},{"label":"C","text":"保护环境"},{"label":"D","text":"减少浪费"}]},{"n":73,"type":"reading_comprehension","section":"reading","answer":2,"part":3,"passage":"阅读短文：人比动物聪明，但动物仍然有很多值得人学习的地方。拿狮子来说，它们困的时候才睡觉，饿的时候才进食，永远不为昨天的事烦恼，也不为明天的事担心。如果能有和它们一样的生命态度，人们一定会健康快乐很多。","question":"问题：狮子有什么特点？","options":[{"label":"A","text":"很懒"},{"label":"B","text":"很脏"},{"label":"C","text":"很快乐"},{"label":"D","text":"很孤单"}]},{"n":74,"type":"reading_comprehension","section":"reading","answer":0,"part":3,"passage":"阅读短文：我们乘坐的航班没有按时起飞，乘客们都很着急。机场很快就向乘客们做出解释：由于天气原因，航班不得不推迟起飞。","question":"问题：关于本次航班，可以知道：","options":[{"label":"A","text":"还没起飞"},{"label":"B","text":"还没加油"},{"label":"C","text":"速度正常"},{"label":"D","text":"机长生病了"}]},{"n":75,"type":"reading_comprehension","section":"reading","answer":2,"part":3,"passage":"阅读短文：她换上了新买的那双鞋，穿了一条裙子，看起来特别精神，又说又笑，好像变了一个人。同事们都明白了，她今天要去约会。","question":"问题：她今天：","options":[{"label":"A","text":"要出差"},{"label":"B","text":"很害羞"},{"label":"C","text":"很高兴"},{"label":"D","text":"请假了"}]},{"n":76,"type":"reading_comprehension","section":"reading","answer":3,"part":3,"passage":"阅读短文：遇到解决不了的问题或者无法完成的任务时，我们要学会拒绝。有时候，拒绝并不代表不愿意帮忙，而是表示对事情或任务负责。","question":"问题：根据这段话，有时候拒绝别人：","options":[{"label":"A","text":"让人感动"},{"label":"B","text":"得不到支持"},{"label":"C","text":"会受到批评"},{"label":"D","text":"说明有责任心"}]},{"n":77,"type":"reading_comprehension","section":"reading","answer":3,"part":3,"passage":"阅读短文：尽管地球上大部分地方是海洋，但海水是咸的，不能直接饮用，人们的生活用水主要从江河和雨水而来。","question":"问题：地球上的水：","options":[{"label":"A","text":"都能喝"},{"label":"B","text":"污染严重"},{"label":"C","text":"温度很高"},{"label":"D","text":"主要在海洋"}]},{"n":78,"type":"reading_comprehension","section":"reading","answer":0,"part":3,"passage":"阅读短文：李经理让我告诉大家一个好消息，经过会议讨论决定，这个月每人多发1500元的奖金，感谢大家这三个月来的辛苦工作。 问题：\"好消息\"","question":"指的是：","options":[{"label":"A","text":"多发奖金"},{"label":"B","text":"去看演出"},{"label":"C","text":"商店在打折"},{"label":"D","text":"经理要请客"}]},{"n":79,"type":"reading_comprehension","section":"reading","answer":2,"part":3,"passage":"阅读短文：耳朵每天都被人使用，但它却不像眼睛、鼻子和嘴那样受到重视，很多时候人们都感觉不到它，忘记了它。可是，仔细看看耳朵吧，有研究发现，通过它可以看出一个人是不是健康，甚至是什么样的性格。","question":"问题：这段话主要讲：","options":[{"label":"A","text":"有趣的脚"},{"label":"B","text":"怎样选眼镜"},{"label":"C","text":"重新认识耳朵"},{"label":"D","text":"怎样打扮自己"}]},{"n":80,"type":"reading_comprehension","section":"reading","answer":2,"part":3,"passage":"阅读短文：现在，城市里越来越多的\"汽车族\"变成了\"弃车族\"，走路上下班成为他们共同的生活习惯。人们放弃开车，不仅锻炼了身体，节约了金钱，还减少了道路堵车情况，这样一来，连空气也变新鲜了。 问题：\"弃车族\"","question":"指的是什么样的人？","options":[{"label":"A","text":"车丢了"},{"label":"B","text":"没钱买车"},{"label":"C","text":"有车不开"},{"label":"D","text":"开车技术不好"}]},{"n":81,"type":"reading_comprehension","section":"reading","answer":1,"part":3,"passage":"阅读短文：现在，城市里越来越多的\"汽车族\"变成了\"弃车族\"，走路上下班成为他们共同的生活习惯。人们放弃开车，不仅锻炼了身体，节约了金钱，还减少了道路堵车情况，这样一来，连空气也变新鲜了。 问题：那些人为什么要成为\"弃车族\"","question":"？","options":[{"label":"A","text":"更安全"},{"label":"B","text":"想多运动"},{"label":"C","text":"节约时间"},{"label":"D","text":"压力太大"}]},{"n":82,"type":"reading_comprehension","section":"reading","answer":2,"part":3,"passage":"阅读短文：你对别人好，别人也会对你好。实际上，我们很多人做不到这一点。当我们看到别人的缺点时，总是按照自己的理解去教育别人。但是每个人都有自己的生活，谁都不能把自己的想法加在别人身上。试着尊重他人的想法与生活习惯，更多地帮助他们，你会发现，他们真的觉得你很好，也会真的对你好。","question":"问题：发现别人有缺点时，应该：","options":[{"label":"A","text":"保护他"},{"label":"B","text":"同情他"},{"label":"C","text":"帮助他"},{"label":"D","text":"反对他"}]},{"n":83,"type":"reading_comprehension","section":"reading","answer":3,"part":3,"passage":"阅读短文：你对别人好，别人也会对你好。实际上，我们很多人做不到这一点。当我们看到别人的缺点时，总是按照自己的理解去教育别人。但是每个人都有自己的生活，谁都不能把自己的想法加在别人身上。试着尊重他人的想法与生活习惯，更多地帮助他们，你会发现，他们真的觉得你很好，也会真的对你好。","question":"问题：这段话主要告诉我们什么？","options":[{"label":"A","text":"人都有缺点"},{"label":"B","text":"要信任别人"},{"label":"C","text":"什么是幸福"},{"label":"D","text"