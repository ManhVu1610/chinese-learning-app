{"videoId":"Vd6g3QLYg0g","title":"最怕朋友~忽然的关心","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":111,"source":"ocr","order":65,"segments":[{"start":0.83,"end":1.71,"text":"好想去哈尔滨","meaning":"Muốn đi Cáp Nhĩ Tân quá"},{"start":1.71,"end":2.75,"text":"当南方小土豆啊","meaning":"Làm \"khoai tây nhỏ miền Nam\" nè"},{"start":2.88,"end":4.25,"text":"就怕嘴巴冻得我张不开","meaning":"Chỉ sợ cái miệng đóng băng mở không ra"},{"start":4.21,"end":5.08,"text":"哇","meaning":"Oa"},{"start":5.04,"end":5.91,"text":"要这样的话","meaning":"Mà vậy thì"},{"start":6.08,"end":7.29,"text":"那我能清净不少啊","meaning":"Tui yên tĩnh được khối luôn"},{"start":9,"end":9.37,"text":"哎","meaning":"Ài"},{"start":9.33,"end":10.66,"text":"你老大呢?","meaning":"Đại ca ông đâu?"},{"start":11.38,"end":12.41,"text":"他吃席去了","meaning":"Ổng đi ăn tiệc rồi"},{"start":12.38,"end":13,"text":"啊","meaning":"Hả"},{"start":13,"end":13.62,"text":"吃鸡!","meaning":"Ăn gà!"},{"start":15,"end":16.66,"text":"这么凶残","meaning":"Tàn nhẫn dữ vậy"},{"start":16.62,"end":17.95,"text":"你耳朵毛堵住了吗","meaning":"Lông tai bít lỗ tai hả"},{"start":17.92,"end":22.08,"text":"我说的是吃席","meaning":"Tui nói là ăn tiệc"},{"start":22.62,"end":23.62,"text":"我也想吃","meaning":"Tui cũng muốn ăn"},{"start":24.96,"end":25.54,"text":"这样啊","meaning":"Vậy hả"},{"start":25.71,"end":28.08,"text":"那我建议你最近少穿点衣服","meaning":"Vậy tui khuyên ông dạo này mặc ít đồ lại"},{"start":28.04,"end":28.62,"text":"为什么?","meaning":"Tại sao?"},{"start":28.79,"end":30.25,"text":"刚好这段时间天气冷","meaning":"Đúng dạo này trời lạnh"},{"start":30.21,"end":30.91,"text":"你少穿点","meaning":"Ông mặc ít vô"},{"start":30.88,"end":31.5,"text":"说不定哪天","meaning":"Biết đâu hôm nào"},{"start":31.46,"end":33.41,"text":"我们就吃到你的席了","meaning":"Tụi tui ăn được tiệc của ông"},{"start":33.38,"end":34.37,"text":"哎","meaning":"Ài"},{"start":34.58,"end":35.7,"text":"你什么意思啊","meaning":"Ý mày là sao hả"},{"start":35.71,"end":36.58,"text":"信不信我一巴掌","meaning":"Tin không tao một tát"},{"start":36.54,"end":37.25,"text":"把你呼墙上","meaning":"Dán mày lên tường"},{"start":37.21,"end":38.33,"text":"抠都抠不下来","meaning":"Cạy cũng cạy không ra"},{"start":38.29,"end":38.7,"text":"哼","meaning":"Hừ"},{"start":41.08,"end":42.58,"text":"我有个十万火急的事","meaning":"Tui có chuyện khẩn cấp cực kỳ"},{"start":42.54,"end":43.87,"text":"什么事?","meaning":"Chuyện gì?"},{"start":43.83,"end":47.41,"text":"关心一下你","meaning":"Là quan tâm ông chút"},{"start":47.42,"end":48.66,"text":"你当妖怪多久了?","meaning":"Ông làm yêu quái bao lâu rồi?"},{"start":48.71,"end":51.04,"text":"一个月挣多少钱啊?","meaning":"Một tháng kiếm được bao nhiêu?"},{"start":51.33,"end":52,"text":"当妖怪好玩吗?","meaning":"Làm yêu quái vui không?"},{"start":52.38,"end":53.58,"text":"我看你天天都来","meaning":"Tui thấy ngày nào ông cũng tới"},{"start":53.54,"end":54.91,"text":"是不是没有双休啊?","meaning":"Có phải không được nghỉ cuối tuần không?"},{"start":55.04,"end":57.29,"text":"有加班费吗?","meaning":"Có tiền tăng ca không?"},{"start":57.25,"end":58.41,"text":"替我分散火力啊","meaning":"Chia lửa giùm tui đi"},{"start":58.46,"end":60.04,"text":"你还是单身吗?","meaning":"Ông còn độc thân không?"},{"start":60.12,"end":61.04,"text":"啊","meaning":"Hả"},{"start":61,"end":62.54,"text":"你的牛粪山女神追到了吗?","meaning":"Nữ thần núi phân bò của ông cưa đổ chưa?"},{"start":62.5,"end":63.75,"text":"明年能结婚吗?","meaning":"Sang năm cưới được không?"},{"start":63.71,"end":64.96,"text":"什么时候要孩子啊?","meaning":"Khi nào có con?"},{"start":64.92,"end":66.08,"text":"准备生几胎呀?","meaning":"Định đẻ mấy lứa?"},{"start":66.12,"end":67.83,"text":"哎 你怎么不回答我呀?","meaning":"Ê, sao ông không trả lời tui vậy?"},{"start":67.79,"end":68.54,"text":"是年纪大了","meaning":"Do già rồi"},{"start":68.5,"end":69.91,"text":"反应变迟钝了吗?","meaning":"Phản xạ chậm đi hả?"},{"start":69.88,"end":73.12,"text":"你今年快30了吧?","meaning":"Năm nay ông gần 30 rồi hả?"},{"start":73.21,"end":73.96,"text":"啊啊啊","meaning":"A a a"},{"start":77.29,"end":78.83,"text":"你刚说什么十万火急啊","meaning":"Ông vừa nói chuyện khẩn cấp gì vậy"},{"start":79.17,"end":80,"text":"啊","meaning":"Hả"},{"start":80.46,"end":82.12,"text":"就是我感觉这里有个屁","meaning":"Là tui thấy chỗ này có cái rắm"},{"start":82.08,"end":83.33,"text":"现在憋得很用力","meaning":"Giờ đang nín rất mạnh"},{"start":83.29,"end":84.71,"text":"憋久了","meaning":"Nín lâu quá"},{"start":84.67,"end":85.41,"text":"会便秘","meaning":"Sẽ bị táo bón"},{"start":87.71,"end":89.66,"text":"我想要放他出去","meaning":"Tui muốn thả nó ra"},{"start":89.62,"end":90.87,"text":"关 关我什么事啊","meaning":"Liên... liên quan gì tới tui"},{"start":91.21,"end":93.04,"text":"我需要征得你的同意","meaning":"Tui cần xin phép ông trước"},{"start":94.42,"end":95.33,"text":"你搞什么rap","meaning":"Ông bày trò rap gì vậy"},{"start":95.29,"end":96.25,"text":"顺口溜啊","meaning":"Vè vần vèo đó"},{"start":105.67,"end":107.79,"text":"年轻就是好","meaning":"Trẻ vẫn là tuyệt nhất"},{"start":107.83,"end":108.21,"text":"催眠大师","meaning":"Đại sư thôi miên"}]}