{"videoId":"4cN0U6mGp1I","title":"都什么年代了，还搞传统姐弟恋？","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":149,"source":"ocr","order":62,"segments":[{"start":0.17,"end":2.21,"text":"嘿嘿...","meaning":"Hề hề..."},{"start":2.17,"end":3.71,"text":"你笑的如此春心荡漾","meaning":"Mày cười xuân tình phơi phới thế kia"},{"start":3.88,"end":4.91,"text":"是发情了吗?","meaning":"Động dục rồi hả?"},{"start":4.88,"end":5.46,"text":"啊!","meaning":"Á!"},{"start":5.42,"end":6.62,"text":"你才发情呢","meaning":"Mày mới động dục đó"},{"start":6.75,"end":8.16,"text":"如果我没猜错的话","meaning":"Nếu tao đoán không sai"},{"start":8.12,"end":9.7,"text":"那一定是猜对喽","meaning":"Thì chắc chắn là đoán đúng rồi chứ gì"},{"start":9.67,"end":11.33,"text":"如果你能少说点废话的话","meaning":"Nếu mày bớt nói nhảm một chút"},{"start":11.29,"end":13.04,"text":"也就不至于这么多废话了","meaning":"Thì đâu đến nỗi nhiều lời thế này"},{"start":14.54,"end":15.45,"text":"你看上谁了呀","meaning":"Mày phải lòng ai rồi?"},{"start":15.5,"end":17.04,"text":"哦","meaning":"Ồ"},{"start":17.17,"end":17.66,"text":"嗯...","meaning":"Ừm..."},{"start":17.75,"end":18.41,"text":"你喜欢上了","meaning":"Mày thích"},{"start":18.38,"end":20.87,"text":"白素贞","meaning":"Bạch Tố Trinh"},{"start":20.83,"end":22.37,"text":"一千多岁呢","meaning":"Hơn một ngàn tuổi rồi đó"},{"start":22.5,"end":22.91,"text":"哦","meaning":"Ồ"},{"start":22.88,"end":23.45,"text":"对哦","meaning":"Ờ ha"},{"start":23.5,"end":24.2,"text":"她这个岁数","meaning":"Cái tuổi của bả"},{"start":24.17,"end":26.95,"text":"当你的太奶奶的","meaning":"Làm cụ tổ mày"},{"start":26.92,"end":28.04,"text":"都绰绰有余了","meaning":"Còn dư dả nữa là"},{"start":28,"end":30.04,"text":"哎...","meaning":"Hừm..."},{"start":30.21,"end":31.41,"text":"该不会是小青吧","meaning":"Chẳng lẽ là Tiểu Thanh"},{"start":31.42,"end":31.87,"text":"嗯...","meaning":"Ừm..."},{"start":31.83,"end":32.95,"text":"她好像年轻一点","meaning":"Hình như cổ trẻ hơn chút"},{"start":32.92,"end":36.08,"text":"只比你大五百岁","meaning":"Chỉ lớn hơn mày năm trăm tuổi"},{"start":36.04,"end":37.37,"text":"啊","meaning":"Hả"},{"start":37.67,"end":38.91,"text":"女大三 抱金砖","meaning":"Gái hơn ba tuổi ôm gạch vàng"},{"start":38.92,"end":40.66,"text":"现在流行姐弟恋","meaning":"Giờ đang mốt chị em yêu nhau mà"},{"start":40.62,"end":43.16,"text":"人家说的女大三","meaning":"Người ta nói gái hơn ba tuổi"},{"start":43.25,"end":45.45,"text":"你这都大了30多轮了","meaning":"Mày hơn đến ba mươi mấy giáp rồi"},{"start":45.42,"end":45.91,"text":"哦","meaning":"Ồ"},{"start":45.88,"end":49.83,"text":"那人家抱的是金砖","meaning":"Vậy người ta ôm là gạch vàng"},{"start":50,"end":50.41,"text":"啊","meaning":"Hả"},{"start":50.38,"end":51.12,"text":"你...你别把他","meaning":"Mày... mày đừng có"},{"start":51.08,"end":52.25,"text":"给压死了球","meaning":"Đè chết nó đó"},{"start":53.58,"end":55.16,"text":"你到底看上谁了嘛","meaning":"Rốt cuộc mày phải lòng ai hả"},{"start":55.12,"end":55.66,"text":"好想知道","meaning":"Tò mò quá đi"},{"start":55.62,"end":56.66,"text":"谁这么倒霉","meaning":"Ai mà xui vậy trời"},{"start":56.62,"end":57.16,"text":"啊","meaning":"Hả"},{"start":57.25,"end":58.33,"text":"你倒是说呀","meaning":"Mày nói đi chứ"},{"start":60.62,"end":62.58,"text":"就上次来闹事的那个啦","meaning":"Thì cái người lần trước tới quậy đó"},{"start":63.04,"end":63.41,"text":"啊","meaning":"Hả"},{"start":63.38,"end":65.21,"text":"就那个黑的像鬼的蛤蟆呀","meaning":"Là con cóc đen thui như ma đó"},{"start":65.17,"end":65.62,"text":"哎呀","meaning":"Trời ơi"},{"start":65.58,"end":67.83,"text":"我还不确定了啦","meaning":"Tui còn chưa chắc mà"},{"start":67.79,"end":70.62,"text":"就想着……我是牛","meaning":"Chỉ nghĩ là... tui là bò"},{"start":70.58,"end":71.87,"text":"以后我们的孩子","meaning":"Sau này con tụi mình"},{"start":71.83,"end":72.96,"text":"就叫牛蛙","meaning":"Sẽ tên là Ếch Bò"},{"start":72.92,"end":74.29,"text":"哼哼呵呵嘻嘻","meaning":"Hừ hừ hô hô hí hí"},{"start":74.5,"end":75.37,"text":"牛蛙!?","meaning":"Ếch Bò!?"},{"start":75.75,"end":77,"text":"我再给你配点田七","meaning":"Để tao thêm cho mày chút tam thất"},{"start":76.96,"end":77.96,"text":"一锅炖了得了","meaning":"Hầm một nồi cho rồi"},{"start":77.92,"end":79.5,"text":"你连孩子的名字都想好了","meaning":"Mày nghĩ tên con xong luôn rồi"},{"start":79.46,"end":80.66,"text":"竟然还说 不确定","meaning":"Mà còn dám nói không chắc"},{"start":80.83,"end":81.46,"text":"嗯","meaning":"Ừm"},{"start":82.08,"end":82.71,"text":"呃...","meaning":"Ờ..."},{"start":82.71,"end":83.71,"text":"说实在的","meaning":"Nói thật nhé"},{"start":83.79,"end":84.66,"text":"你的口味","meaning":"Khẩu vị của mày"},{"start":84.62,"end":86.5,"text":"有一丢丢重哦","meaning":"Hơi bị nặng đó nha"},{"start":86.46,"end":88.12,"text":"我也想追天鹅姐姐呀","meaning":"Tui cũng muốn cưa chị Thiên Nga mà"},{"start":88.08,"end":89.41,"text":"可是一照镜子","meaning":"Nhưng vừa soi gương"},{"start":89.42,"end":90.96,"text":"还是觉得蛤蟆比较适合我","meaning":"Vẫn thấy cóc hợp với tui hơn"},{"start":90.92,"end":94.16,"text":"嘿嘿","meaning":"Hề hề"},{"start":95.17,"end":99.21,"text":"哎","meaning":"Ài"},{"start":99.17,"end":99.79,"text":"啊","meaning":"Hả"},{"start":100,"end":102.54,"text":"鸡...","meaning":"Gà..."},{"start":102.79,"end":104.87,"text":"机会留给有准备的人","meaning":"Cơ hội dành cho người có chuẩn bị"},{"start":105.04,"end":105.41,"text":"啊","meaning":"Hả"},{"start":105.38,"end":106.79,"text":"美个容送个礼","meaning":"Làm đẹp rồi tặng quà"},{"start":106.75,"end":108.41,"text":"就能追到大美女","meaning":"Là cưa được mỹ nữ"},{"start":108.5,"end":112.33,"text":"快去收拾一下你的小花脸吧","meaning":"Mau đi dọn dẹp cái mặt hoa của mày đi"},{"start":112.5,"end":112.91,"text":"哇","meaning":"Oa"},{"start":112.96,"end":115.37,"text":"自信心直接拉满咧","meaning":"Tự tin đầy bình luôn"},{"start":115.33,"end":117.46,"text":"你只能用星光璀璨的白","meaning":"Mày chỉ có thể dùng màu trắng lấp lánh như sao"},{"start":117.42,"end":119.83,"text":"才配得上她那五彩斑斓的黑","meaning":"Mới xứng với màu đen rực rỡ của nàng"},{"start":119.79,"end":121.46,"text":"这张脸加这个礼物","meaning":"Cái mặt này cộng với món quà này"},{"start":121.42,"end":122.5,"text":"真的可以吗","meaning":"Thật sự được không?"},{"start":122.62,"end":124.08,"text":"她那么温柔、娴熟","meaning":"Nàng dịu dàng, lão luyện thế kia"},{"start":124.08,"end":124.83,"text":"就喜欢小白脸","meaning":"Chỉ thích trai trắng thôi"},{"start":125.08,"end":128.16,"text":"你可以的","meaning":"Mày làm được mà"},{"start":128.12,"end":130.29,"text":"钵呀 钵钵鸡","meaning":"Bát ơi bát bát gà"},{"start":130.33,"end":134.62,"text":"看什么看","meaning":"Nhìn cái gì mà nhìn"},{"start":134.62,"end":136.04,"text":"礼物可以收","meaning":"Quà thì nhận được"},{"start":136,"end":136.66,"text":"恋爱不能谈","meaning":"Yêu đương thì không nha"},{"start":136.83,"end":139.41,"text":"拿来吧你","meaning":"Đưa đây coi mày"},{"start":139.62,"end":140.16,"text":"等一下","meaning":"Khoan đã"},{"start":143.5,"end":145.16,"text":"你妈贵姓啊","meaning":"Mẹ mày họ gì vậy hả"},{"start":145.17,"end":146.16,"text":"哎...","meaning":"Ài..."}]}