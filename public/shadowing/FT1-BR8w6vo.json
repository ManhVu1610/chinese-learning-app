{"videoId":"FT1-BR8w6vo","title":"鸡和蛙结婚？疯了吧！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":72,"source":"ocr","order":20,"segments":[{"start":0.08,"end":1.54,"text":"蛤蟆和鸡结婚？","meaning":"Cóc mà cưới gà á?"},{"start":1.5,"end":2.21,"text":"你疯了吧？","meaning":"Điên rồi hả?"},{"start":2.42,"end":3.75,"text":"为什么不能结婚","meaning":"Sao lại không được cưới?"},{"start":3.71,"end":5.41,"text":"因为你们根本就不配","meaning":"Vì hai người căn bản không xứng đôi."},{"start":5.38,"end":6.79,"text":"他是鸡 你是蛙","meaning":"Ảnh là gà, cô là ếch,"},{"start":6.75,"end":8.2,"text":"你们就不是同类","meaning":"hai người đâu cùng loài."},{"start":8.75,"end":10.41,"text":"谁说我们不是同类？","meaning":"Ai nói tụi tui không cùng loài?"},{"start":10.5,"end":11.54,"text":"严格上来说…","meaning":"Nói cho nghiêm túc thì..."},{"start":11.79,"end":12.66,"text":"我也是鸡","meaning":"tui cũng là gà đó."},{"start":12.71,"end":13.45,"text":"啊","meaning":"Hả?"},{"start":13.54,"end":15.2,"text":"我们蛤蟆也叫田鸡","meaning":"Cóc tụi tui còn gọi là \"điền kê\" (gà ruộng) nữa đó,"},{"start":15.17,"end":16.25,"text":"你们不知道吗？","meaning":"mấy người không biết hả?"},{"start":16.21,"end":16.79,"text":"田鸡是鸡？","meaning":"Điền kê là gà hả?"},{"start":17.96,"end":19.75,"text":"叫田鸡又不是真的鸡","meaning":"Gọi là gà ruộng chứ có phải gà thiệt đâu."},{"start":19.71,"end":20.62,"text":"我说是就是","meaning":"Tui nói phải là phải."},{"start":20.88,"end":22.62,"text":"干嘛那么多嘴？","meaning":"Lắm mồm làm gì?"},{"start":22.58,"end":23.62,"text":"对吧哥哥","meaning":"Đúng không anh yêu?"},{"start":24.17,"end":25.41,"text":"好端端的蛙不当","meaning":"Đang yên đang lành không làm ếch,"},{"start":25.38,"end":26.7,"text":"非要跑来当鸡","meaning":"cứ phải chạy đi làm gà,"},{"start":27,"end":27.83,"text":"真的是","meaning":"thiệt tình!"},{"start":29.29,"end":30.33,"text":"还是不行","meaning":"Vẫn không được."},{"start":30.33,"end":31,"text":"为什么？","meaning":"Tại sao?"},{"start":31.25,"end":32.41,"text":"它们鸡是卵生动物","meaning":"Gà là loài đẻ trứng,"},{"start":32.38,"end":33.45,"text":"是要生蛋的","meaning":"phải đẻ trứng."},{"start":33.5,"end":34.79,"text":"我们蛤蟆也要生蛋啊","meaning":"Cóc tụi tui cũng đẻ trứng mà,"},{"start":34.75,"end":36.12,"text":"而且能生很多","meaning":"lại còn đẻ được rất nhiều,"},{"start":36.08,"end":37.2,"text":"一串一串的","meaning":"từng chuỗi từng chuỗi luôn."},{"start":37.17,"end":38.7,"text":"所以我们特别适合在一起","meaning":"Nên tụi tui đặc biệt hợp nhau,"},{"start":38.67,"end":40.41,"text":"适合在一起扯蛋","meaning":"hợp nhau để cùng... chém gió."},{"start":40.96,"end":41.5,"text":"适合扯蛋？","meaning":"Hợp chém gió á?"},{"start":42.38,"end":43.58,"text":"但是鸡和蛙结婚","meaning":"Nhưng mà gà với ếch cưới nhau"},{"start":43.54,"end":45.08,"text":"我还是觉得有点离谱","meaning":"tui vẫn thấy hơi phi lý."},{"start":45.04,"end":46.25,"text":"有什么好离谱的","meaning":"Có gì mà phi lý?"},{"start":46.21,"end":47.62,"text":"你没听说过混血吗","meaning":"Chưa nghe nói tới con lai hả?"},{"start":47.58,"end":48.95,"text":"现在人都喜欢混血啊","meaning":"Bây giờ ai cũng thích con lai đó."},{"start":50,"end":51.62,"text":"混血不是这样混的吧","meaning":"Con lai đâu phải lai kiểu này!"},{"start":51.58,"end":53.5,"text":"他们人类那种才叫混血","meaning":"Kiểu của loài người mới gọi là con lai,"},{"start":53.46,"end":54.62,"text":"像我们这种啊","meaning":"còn như tụi mình đây"},{"start":54.71,"end":56.2,"text":"顶多只能算是杂交啊","meaning":"cùng lắm chỉ tính là lai tạp thôi."},{"start":56.96,"end":58.33,"text":"顶多算杂交？","meaning":"Cùng lắm là lai tạp á?"},{"start":58.46,"end":60.08,"text":"哎呀 意思都一样啊","meaning":"Trời, nghĩa giống nhau hết mà,"},{"start":60.04,"end":62,"text":"只是称呼不同而已嘛","meaning":"chỉ là cách gọi khác nhau thôi."},{"start":61.96,"end":63.58,"text":"人家混血都是向上","meaning":"Người ta con lai đều hướng lên trên,"},{"start":63.54,"end":65.12,"text":"往高贵的血统混","meaning":"lai với dòng máu cao quý,"},{"start":65.21,"end":66.71,"text":"你们怎么选择向下","meaning":"sao hai người lại chọn đi xuống,"},{"start":66.67,"end":68,"text":"往贱的方向混呢","meaning":"lai theo hướng tiện vậy?"},{"start":67.96,"end":68.46,"text":"啊","meaning":"Hả?"},{"start":68.83,"end":69.96,"text":"你说谁贱？","meaning":"Ông nói ai tiện?"},{"start":70.04,"end":70.41,"text":"嗯","meaning":"Ừm."},{"start":70.62,"end":71.71,"text":"我什么都没说","meaning":"Tui có nói gì đâu."}]}