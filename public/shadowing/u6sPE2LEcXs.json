{"videoId":"u6sPE2LEcXs","title":"狂飙鸡：又给我惊喜？！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":129,"source":"ocr","order":24,"segments":[{"start":0.08,"end":1.83,"text":"不好了","meaning":"Không xong rồi!"},{"start":1.79,"end":3.04,"text":"瞧你那个没出息的样","meaning":"Nhìn cái bộ dạng hết thuốc chữa của cậu kìa."},{"start":3.17,"end":3.71,"text":"遇到点事","meaning":"Gặp chút chuyện"},{"start":3.79,"end":5.16,"text":"就喜欢大吼大叫的","meaning":"là thích gào ầm lên."},{"start":5.12,"end":5.71,"text":"牢房","meaning":"Nhà giam"},{"start":5.71,"end":7.16,"text":"牢房着火啦！","meaning":"Nhà giam cháy rồi!"},{"start":7.12,"end":8.16,"text":"着火了呀","meaning":"Cháy rồi đó!"},{"start":8.17,"end":8.87,"text":"嗯嗯","meaning":"Ừ ừ."},{"start":8.83,"end":9.45,"text":"啊","meaning":"Hả?"},{"start":9.54,"end":10.58,"text":"牢房着火了","meaning":"Nhà giam bốc cháy rồi,"},{"start":12.17,"end":13.58,"text":"不好啦…","meaning":"Không ổn rồi..."},{"start":13.62,"end":16.04,"text":"到底谁一惊一作？","meaning":"Rốt cuộc ai mới là đứa hở tí là la làng đây?"},{"start":16,"end":16.91,"text":"年轻人呐","meaning":"Tuổi trẻ đúng là"},{"start":16.88,"end":18.2,"text":"就是浮躁啊","meaning":"nông nổi thật."},{"start":18.21,"end":19.25,"text":"就不能像我一样","meaning":"Sao không được như ta,"},{"start":19.25,"end":20.29,"text":"成熟稳重吗","meaning":"chín chắn điềm đạm hả?"},{"start":20.25,"end":22.45,"text":"泰山崩于前而面不改色","meaning":"Thái Sơn sập trước mặt mà mặt không biến sắc."},{"start":22.46,"end":22.87,"text":"对了","meaning":"À đúng rồi,"},{"start":22.96,"end":24.7,"text":"你的蟑螂还在里面呢","meaning":"con gián của ngươi vẫn còn trong đó kìa."},{"start":24.83,"end":25.66,"text":"小强？！","meaning":"Tiểu Cường?!"},{"start":26.17,"end":26.54,"text":"啊","meaning":"Á!"},{"start":27.17,"end":27.87,"text":"救命啊","meaning":"Cứu mạng!"},{"start":27.83,"end":31.37,"text":"我的宠物小强啊","meaning":"Thú cưng Tiểu Cường của tui!"},{"start":36.25,"end":38.04,"text":"这就是你说的着火？","meaning":"Đây là cái ngươi gọi là cháy hả?"},{"start":40.92,"end":41.87,"text":"就这点火","meaning":"Có tí lửa này"},{"start":41.92,"end":43.62,"text":"值得你这么大惊小怪的","meaning":"mà đáng để ngươi làm ầm lên vậy sao?"},{"start":43.58,"end":45.25,"text":"一脚踩灭不就得了","meaning":"Một cái đạp là tắt chứ gì."},{"start":45.21,"end":45.62,"text":"哼！","meaning":"Hứ!"},{"start":50.54,"end":51.75,"text":"老大学会飞了耶","meaning":"Đại ca biết bay rồi nha!"},{"start":51.83,"end":53.62,"text":"我还会回来的","meaning":"Ta còn quay lại nữa đó!"},{"start":54.04,"end":56.5,"text":"看！有飞鸡！","meaning":"Nhìn kìa! Có gà bay!"},{"start":56.46,"end":57.54,"text":"这么久了还不回来","meaning":"Lâu vậy rồi mà chưa quay về,"},{"start":57.75,"end":58.75,"text":"不会升天了吧","meaning":"không phải bay lên trời luôn rồi chứ?"},{"start":58.88,"end":59.5,"text":"啊？","meaning":"Hả?"},{"start":59.71,"end":61.04,"text":"啊！","meaning":"Á!"},{"start":61.75,"end":62.75,"text":"谁扔的炮仗","meaning":"Đứa nào ném pháo vậy?"},{"start":62.96,"end":63.66,"text":"快给我出来","meaning":"Mau chui ra đây cho tao!"},{"start":63.62,"end":64.54,"text":"让我知道是谁","meaning":"Để tao biết là ai,"},{"start":64.5,"end":65.75,"text":"我非拔光他的毛","meaning":"tao nhổ trụi lông nó!"},{"start":65.71,"end":66.71,"text":"打断他的腿","meaning":"Đánh gãy chân nó!"},{"start":66.67,"end":67.33,"text":"是他","meaning":"Là nó nè!"},{"start":69.46,"end":70.16,"text":"是你？","meaning":"Là mày hả?"},{"start":70.33,"end":71.04,"text":"是我","meaning":"Là con."},{"start":71,"end":71.5,"text":"爸比","meaning":"Ba ơi!"},{"start":71.71,"end":72.58,"text":"爸比？！","meaning":"Ba ơi?!"},{"start":72.92,"end":74.08,"text":"你都有孩子啦？","meaning":"Ông có con rồi á?"},{"start":74.12,"end":75.62,"text":"啊","meaning":"Hả?"},{"start":75.83,"end":76.71,"text":"快放他下来","meaning":"Mau thả thằng bé xuống đi!"},{"start":76.67,"end":77.54,"text":"这么小的孩子","meaning":"Đứa nhỏ xíu thế này"},{"start":77.54,"end":78.41,"text":"不可能是他","meaning":"không thể là nó được."},{"start":79.54,"end":80.12,"text":"是我","meaning":"Là con mà."},{"start":80.08,"end":80.66,"text":"爸比","meaning":"Ba ơi,"},{"start":80.71,"end":82.58,"text":"我这还有一个超大的炮仗","meaning":"con còn một quả pháo siêu bự nè,"},{"start":82.54,"end":83.75,"text":"要放给你看呢","meaning":"để con đốt cho ba xem nha!"},{"start":83.75,"end":84.5,"text":"哦？","meaning":"Ồ?"},{"start":84.58,"end":85.04,"text":"啊","meaning":"Hả?"},{"start":85.5,"end":86.12,"text":"什么炮仗","meaning":"Pháo gì mà pháo!"},{"start":86.21,"end":86.87,"text":"赶紧回家","meaning":"Mau về nhà đi!"},{"start":86.92,"end":87.5,"text":"回家玩去","meaning":"Về nhà mà chơi!"},{"start":87.92,"end":88.33,"text":"哦","meaning":"Dạ."},{"start":88.42,"end":88.83,"text":"快走","meaning":"Đi mau."},{"start":90.08,"end":91.37,"text":"不是要拔光他的毛吗","meaning":"Không phải định nhổ trụi lông nó sao?"},{"start":91.46,"end":91.96,"text":"对啊","meaning":"Đúng đó."},{"start":92.17,"end":93.37,"text":"腿也还没打断呢","meaning":"Chân cũng chưa đánh gãy mà."},{"start":94.33,"end":94.83,"text":"再说","meaning":"Với lại,"},{"start":94.83,"end":96.16,"text":"信不信我把你腿给打断","meaning":"tin không tao đánh gãy chân mày luôn?"},{"start":96.33,"end":97.91,"text":"你自己说的打断腿呢？","meaning":"Chính ông nói đánh gãy chân mà? Đâu rồi?"},{"start":98,"end":98.37,"text":"哎","meaning":"Ây."},{"start":98.62,"end":99.75,"text":"你干嘛护着他呀","meaning":"Sao ông che chở nó vậy?"},{"start":99.71,"end":100.16,"text":"教他点消防知识？","meaning":"Nhân tiện dạy nó chút kiến thức phòng cháy đi?"},{"start":101.38,"end":102.41,"text":"谁护着他了","meaning":"Ai che chở nó hồi nào!"},{"start":102.42,"end":102.91,"text":"这么小","meaning":"Nhỏ xíu vậy"},{"start":102.88,"end":104,"text":"学什么消防知识","meaning":"học phòng cháy gì chứ."},{"start":103.96,"end":105.21,"text":"你现在不教他","meaning":"Giờ ông không dạy nó"},{"start":105.21,"end":106.04,"text":"说不定以后","meaning":"biết đâu sau này"},{"start":106,"end":106.91,"text":"给你个惊喜呢","meaning":"nó cho ông một bất ngờ thì sao."},{"start":107.04,"end":107.46,"text":"哈哈","meaning":"Ha ha."},{"start":107.58,"end":108.75,"text":"他就这么点大","meaning":"Nó bé tí tẹo thế kia"},{"start":108.71,"end":109.83,"text":"能搞出什么惊喜","meaning":"thì làm ra được bất ngờ gì?"},{"start":109.79,"end":110.29,"text":"你说","meaning":"Ông nói xem,"},{"start":110.25,"end":111.83,"text":"他能给我什么惊喜？","meaning":"nó cho tui được bất ngờ gì nào?"},{"start":111.88,"end":112.29,"text":"啊","meaning":"Hả?"},{"start":112.54,"end":113.5,"text":"嗯","meaning":"Ừm."},{"start":114.67,"end":115.96,"text":"爸比让我回家玩","meaning":"Ba bảo con về nhà chơi,"},{"start":116.38,"end":117.62,"text":"那我就在家里玩","meaning":"thì con chơi ở nhà thôi."},{"start":122.42,"end":123.21,"text":"这就是惊喜","meaning":"Đây chính là bất ngờ đó."},{"start":124.12,"end":124.87,"text":"啊","meaning":"Á!"},{"start":124.83,"end":126,"text":"我的房子啊","meaning":"Nhà của tui!"},{"start":126.29,"end":128.37,"text":"怎么办啊","meaning":"Làm sao bây giờ?"}]}