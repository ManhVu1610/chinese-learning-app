{"videoId":"3NdOzFw9jWo","title":"结拜兄弟，这样玩是吧？","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":148,"source":"ocr","order":32,"segments":[{"start":0.42,"end":1.58,"text":"你我兄弟三人","meaning":"Ba anh em mình"},{"start":1.62,"end":2.54,"text":"就此结拜","meaning":"từ nay kết nghĩa nha."},{"start":2.75,"end":4.12,"text":"我们同生共死","meaning":"Cùng sống cùng chết,"},{"start":4.08,"end":5.25,"text":"同甘共苦","meaning":"đồng cam cộng khổ,"},{"start":5.21,"end":6.25,"text":"同父异母","meaning":"cùng cha khác mẹ!"},{"start":6.21,"end":6.79,"text":"啊？","meaning":"Hả?"},{"start":6.79,"end":7.21,"text":"同……","meaning":"Cùng..."},{"start":7.21,"end":7.75,"text":"同床共枕","meaning":"cùng giường chung gối."},{"start":8.21,"end":8.83,"text":"啊？","meaning":"Hả?"},{"start":9.17,"end":9.66,"text":"同……","meaning":"Cùng..."},{"start":9.67,"end":10.62,"text":"同舟共济","meaning":"cùng thuyền chung sức,"},{"start":11.54,"end":12.87,"text":"永不背叛","meaning":"vĩnh viễn không phản bội!"},{"start":12.83,"end":13.58,"text":"啊！","meaning":"Á!"},{"start":15.17,"end":15.62,"text":"不好！","meaning":"Không xong!"},{"start":15.83,"end":16.54,"text":"有埋伏","meaning":"Có mai phục!"},{"start":16.62,"end":17,"text":"啊","meaning":"Á!"},{"start":19.04,"end":19.95,"text":"你干嘛？","meaning":"Mày làm gì vậy?"},{"start":19.92,"end":20.87,"text":"条件反射","meaning":"Phản xạ có điều kiện thôi."},{"start":20.83,"end":21.54,"text":"我胆小","meaning":"Tui nhát mà."},{"start":21.5,"end":22.16,"text":"嘿嘿哎","meaning":"Hê hê."},{"start":25.62,"end":26.54,"text":"你们不用怕","meaning":"Hai đứa đừng sợ,"},{"start":26.58,"end":27.87,"text":"有大哥我罩着你们","meaning":"có đại ca đây che chở cho."},{"start":27.83,"end":28.54,"text":"从今往后","meaning":"Từ nay về sau"},{"start":28.5,"end":29.62,"text":"我们有福同享","meaning":"mình có phúc cùng hưởng,"},{"start":29.58,"end":30.33,"text":"有难同当~","meaning":"có nạn cùng chịu~"},{"start":31.96,"end":32.62,"text":"他咋了？","meaning":"Ổng bị gì vậy?"},{"start":32.58,"end":33.91,"text":"怎么突然就打鸣了","meaning":"Sao tự nhiên gáy lên vậy?"},{"start":34.79,"end":35.91,"text":"应该是来感觉了","meaning":"Chắc là lên cảm hứng rồi,"},{"start":35.88,"end":36.75,"text":"想唱歌了","meaning":"muốn hát đó mà."},{"start":37.5,"end":38.45,"text":"唱什么歌啊","meaning":"Hát cái gì chứ!"},{"start":38.42,"end":39.58,"text":"我中箭了","meaning":"Tui trúng tên rồi!"},{"start":42.5,"end":43.12,"text":"啊","meaning":"Á!"},{"start":43.79,"end":44.37,"text":"啊大哥","meaning":"Ôi đại ca!"},{"start":44.33,"end":45.25,"text":"你感觉怎么样了","meaning":"Anh thấy sao rồi?"},{"start":45.21,"end":46.45,"text":"还能不能唱歌啊","meaning":"Còn hát được không?"},{"start":46.46,"end":47.5,"text":"你可别挂哦","meaning":"Đừng có ngỏm nha!"},{"start":48.42,"end":49.33,"text":"你干嘛？","meaning":"Mày làm gì đó?"},{"start":49.29,"end":50.2,"text":"我救他呀","meaning":"Tui cứu ảnh chứ sao."},{"start":50.21,"end":51.33,"text":"你懂救援啊","meaning":"Ông biết cứu hộ hả?"},{"start":51.29,"end":51.91,"text":"不懂","meaning":"Không biết."},{"start":52.29,"end":53.33,"text":"不懂就别乱动","meaning":"Không biết thì đừng có táy máy!"},{"start":53.38,"end":53.87,"text":"哦","meaning":"Ồ."},{"start":54.08,"end":54.95,"text":"啊","meaning":"Á!"},{"start":55.83,"end":57.25,"text":"你插回去干嘛","meaning":"Ông cắm ngược lại làm gì?"},{"start":57.21,"end":58.66,"text":"我给它还原啊","meaning":"Tui khôi phục nguyên trạng cho nó mà."},{"start":59.96,"end":61.66,"text":"谁让你给它还原啊","meaning":"Ai biểu ông khôi phục nguyên trạng!"},{"start":61.62,"end":62.04,"text":"哦","meaning":"Ồ."},{"start":62,"end":62.87,"text":"啊","meaning":"Á!"},{"start":63.62,"end":65.5,"text":"你能不能轻点","meaning":"Ông nhẹ tay chút được không!"},{"start":65.71,"end":66.46,"text":"对不起","meaning":"Xin lỗi."},{"start":66.42,"end":68.04,"text":"那我插回去重新拔？","meaning":"Vậy tui cắm lại rồi rút lại nhé?"},{"start":71.29,"end":72.33,"text":"你愣着干嘛","meaning":"Đứng ngây ra đó làm gì?"},{"start":72.54,"end":73.96,"text":"快给我止血啊","meaning":"Mau cầm máu cho tui đi!"},{"start":73.92,"end":74.29,"text":"哦","meaning":"Dạ."},{"start":75.67,"end":76.96,"text":"可是我没有纱布啊","meaning":"Nhưng tui đâu có gạc."},{"start":78.08,"end":79.79,"text":"那就坐下来看会喷泉吧","meaning":"Vậy ngồi xuống xem đài phun nước đi."},{"start":82.33,"end":83,"text":"用这个吧","meaning":"Dùng cái này đi!"},{"start":83.33,"end":84.25,"text":"卫生巾！！","meaning":"Băng vệ sinh!!"},{"start":84.29,"end":85.33,"text":"它既能抑菌","meaning":"Vừa kháng khuẩn,"},{"start":85.29,"end":86.5,"text":"还超能吸收","meaning":"lại còn siêu thấm hút."},{"start":86.46,"end":87.29,"text":"这么好","meaning":"Tốt vậy luôn."},{"start":87.79,"end":88.71,"text":"但是……","meaning":"Nhưng mà..."},{"start":88.83,"end":89.83,"text":"你怎么会有这个？","meaning":"Sao ông lại có cái này?"},{"start":90.04,"end":90.54,"text":"啊","meaning":"Hả?"},{"start":91.04,"end":91.54,"text":"哎呀","meaning":"Ây da,"},{"start":91.5,"end":92.54,"text":"救人要紧啊","meaning":"cứu người quan trọng hơn!"},{"start":92.5,"end":92.96,"text":"哦","meaning":"Ờ."},{"start":93.54,"end":95.87,"text":"哇","meaning":"Wow!"},{"start":99.79,"end":101.41,"text":"果然超强吸收","meaning":"Quả nhiên siêu thấm hút!"},{"start":103.25,"end":105.5,"text":"啊","meaning":"Á!"},{"start":107.21,"end":108.12,"text":"来老大","meaning":"Nào đại ca,"},{"start":108.71,"end":109.79,"text":"外面这么危险","meaning":"bên ngoài nguy hiểm vậy,"},{"start":109.75,"end":111.37,"text":"你们还留下来为我包扎","meaning":"hai đứa còn ở lại băng bó cho anh,"},{"start":111.33,"end":112.25,"text":"够义气","meaning":"đủ nghĩa khí lắm."},{"start":112.21,"end":113.29,"text":"我很感激","meaning":"Anh rất cảm kích."},{"start":113.5,"end":114.58,"text":"我们是兄弟啊","meaning":"Mình là anh em mà."},{"start":114.54,"end":115.21,"text":"应该的","meaning":"Phải làm thôi."},{"start":115.17,"end":116,"text":"对啊大哥","meaning":"Đúng đó đại ca."},{"start":115.96,"end":117.16,"text":"你还有什么愿望","meaning":"Anh còn nguyện vọng gì không?"},{"start":117.12,"end":118.66,"text":"我现在最大的愿望","meaning":"Nguyện vọng lớn nhất của anh bây giờ"},{"start":118.62,"end":120.21,"text":"就是当好你们的大哥","meaning":"là làm tốt vai đại ca của hai đứa,"},{"start":120.17,"end":121.75,"text":"为你们两肋插刀","meaning":"vì hai đứa mà xả thân vào đao,"},{"start":121.75,"end":122.66,"text":"赴汤蹈火","meaning":"lên núi đao xuống biển lửa."},{"start":122.62,"end":123.08,"text":"啊","meaning":"Á!"},{"start":123.83,"end":124.66,"text":"你干什么","meaning":"Mày làm gì vậy?"},{"start":124.71,"end":125.96,"text":"满足你的愿望啊","meaning":"Thỏa mãn nguyện vọng của anh chứ sao."},{"start":125.92,"end":127.91,"text":"你不是想两肋插刀吗","meaning":"Chẳng phải anh muốn hai sườn cắm dao hả?"},{"start":129,"end":130.29,"text":"我……","meaning":"Anh..."},{"start":131.71,"end":132.16,"text":"啊","meaning":"Á!"},{"start":132.21,"end":132.83,"text":"啊？挂了？","meaning":"Hả? Ngỏm rồi á?"},{"start":133.58,"end":134.75,"text":"这还差一刀呢","meaning":"Còn thiếu một nhát nữa mà."},{"start":134.92,"end":136.41,"text":"真不经捅！","meaning":"Đúng là không chịu nổi một nhát!"},{"start":138.12,"end":139.16,"text":"我们换个大哥吧","meaning":"Mình đổi đại ca đi."},{"start":139.62,"end":140.2,"text":"好啊","meaning":"Được đó."},{"start":140.62,"end":141,"text":"鸡哥","meaning":"Anh Gà,"},{"start":141.42,"end":142.41,"text":"你我如此有缘","meaning":"mình có duyên vậy nè,"},{"start":142.38,"end":143.5,"text":"我们结拜为兄妹如何","meaning":"mình kết nghĩa anh em nhé?"},{"start":143.58,"end":144.5,"text":"额……","meaning":"Ờ..."},{"start":144.46,"end":145.54,"text":"我们当小弟","meaning":"Tụi tui làm đàn em,"},{"start":145.5,"end":146.54,"text":"你当大哥","meaning":"anh làm đại ca."},{"start":146.67,"end":147.25,"text":"好啊","meaning":"Được chứ!"}]}