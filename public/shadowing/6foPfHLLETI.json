{"videoId":"6foPfHLLETI","title":"帮我砍一刀？！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":80,"source":"ocr","order":44,"segments":[{"start":0.54,"end":2.21,"text":"有句话不知道当讲不当讲","meaning":"Có câu này không biết nên nói hay không nên nói."},{"start":2.17,"end":3.08,"text":"那就别讲","meaning":"Vậy thì đừng nói."},{"start":3.04,"end":3.54,"text":"啊？","meaning":"Hả?"},{"start":4.33,"end":5.79,"text":"你介不介意帮我砍一刀","meaning":"Ông có phiền giúp tui \"chặt\" một nhát không?"},{"start":5.96,"end":6.83,"text":"好啊","meaning":"Được chứ!"},{"start":6.83,"end":7.33,"text":"嘿","meaning":"Hề!"},{"start":8.67,"end":9.79,"text":"你打我干什么","meaning":"Ông đánh tui làm gì?"},{"start":9.75,"end":10.54,"text":"我是让你","meaning":"Ý tui là nhờ ông"},{"start":10.5,"end":11.54,"text":"在手机上砍一刀","meaning":"chặt giá một nhát trên điện thoại cơ!"},{"start":11.54,"end":12.04,"text":"啊？","meaning":"Hả?"},{"start":12.21,"end":13.12,"text":"早说","meaning":"Nói sớm đi chứ."},{"start":13.42,"end":13.83,"text":"嘿","meaning":"Hề."},{"start":16.21,"end":16.79,"text":"我是让你","meaning":"Ý tui là nhờ ông"},{"start":16.75,"end":18.29,"text":"在拼叨叨上砍一刀啊","meaning":"chặt giá trên Pinduoduo đó!"},{"start":18.25,"end":19.08,"text":"啊？","meaning":"Hả?"},{"start":19.62,"end":20.75,"text":"你在拼什么啊？","meaning":"Ông đang săn cái gì vậy?"},{"start":20.71,"end":22.37,"text":"刚刚是想拼个肥皂来着","meaning":"Nãy tui định săn cục xà phòng."},{"start":22.62,"end":24.04,"text":"现在只能拼手机了","meaning":"Giờ chỉ còn săn được cái điện thoại thôi."},{"start":24,"end":24.66,"text":"哎~","meaning":"Haizz~"},{"start":25.42,"end":26.54,"text":"你买肥皂干嘛","meaning":"Ông mua xà phòng làm gì?"},{"start":26.5,"end":28.25,"text":"我都三个月没洗澡了","meaning":"Tui ba tháng rồi chưa tắm đó."},{"start":28.21,"end":29.29,"text":"都快馊了","meaning":"Sắp thiu tới nơi rồi."},{"start":29.62,"end":30.2,"text":"哎呀","meaning":"Ái chà!"},{"start":30.25,"end":31.33,"text":"~抱啃大腿~","meaning":"~Ôm chặt gặm đùi~"},{"start":31.58,"end":32.25,"text":"你干嘛","meaning":"Ông làm gì vậy?"},{"start":32.29,"end":34.04,"text":"我尝尝你馊了没有啊","meaning":"Tui nếm thử xem ông thiu chưa."},{"start":34.96,"end":35.79,"text":"嗯","meaning":"Ừm."},{"start":35.96,"end":37,"text":"别的妖怪抓了我","meaning":"Yêu quái khác mà bắt được tui"},{"start":36.96,"end":38,"text":"都抢着给我洗澡","meaning":"đều giành nhau tắm cho tui."},{"start":37.96,"end":39.37,"text":"都把我当VIP一样","meaning":"Coi tui như khách VIP vậy đó."},{"start":39.33,"end":41.04,"text":"就你们现在偷懒不给我洗澡","meaning":"Chỉ có mấy người giờ lười biếng không tắm cho tui."},{"start":41.17,"end":41.91,"text":"不好意思","meaning":"Ngại quá."},{"start":41.88,"end":42.95,"text":"这里没有VIP","meaning":"Ở đây làm gì có VIP."},{"start":42.96,"end":43.5,"text":"要的话","meaning":"Nếu muốn,"},{"start":43.46,"end":44.75,"text":"也只有\"挨劈\"","meaning":"thì chỉ có \"ăn chém\" thôi."},{"start":45.79,"end":46.33,"text":"我不管","meaning":"Tui không biết đâu."},{"start":46.29,"end":47.75,"text":"你要是没照顾好我","meaning":"Nếu ông không chăm sóc tui cho tốt,"},{"start":47.79,"end":49,"text":"到时候你丢了工作","meaning":"đến lúc đó mất việc rồi"},{"start":48.96,"end":50.16,"text":"你只能出去卖肉哦","meaning":"ông chỉ còn nước đi bán thịt thôi nha."},{"start":50.12,"end":51,"text":"卖肉？","meaning":"Bán thịt?"},{"start":51.04,"end":52.16,"text":"嘿嘿嘿","meaning":"Hề hề hề."},{"start":52.17,"end":53,"text":"哼","meaning":"Hừ."},{"start":53.42,"end":54.25,"text":"想什么呢","meaning":"Nghĩ gì vậy?"},{"start":54.25,"end":55.41,"text":"要卖也是卖牛肉","meaning":"Có bán thì cũng bán thịt bò."},{"start":56.12,"end":57.04,"text":"我的肉？","meaning":"Thịt của tui á?"},{"start":57.04,"end":59.45,"text":"哈哈哈 哈哈哈","meaning":"Ha ha ha ha ha ha."},{"start":59.62,"end":61.75,"text":"你冷静一点啊","meaning":"Ông bình tĩnh chút đi!"},{"start":61.83,"end":62.58,"text":"你干什么","meaning":"Ông làm gì vậy?"},{"start":62.58,"end":63.87,"text":"你不是要冷静点吗","meaning":"Chẳng phải ông bảo cần bình tĩnh sao?"},{"start":63.83,"end":64.91,"text":"我是要他冷静","meaning":"Tui muốn ổng bình tĩnh."},{"start":65.88,"end":66.96,"text":"不是我冷静","meaning":"Chứ đâu phải tui."},{"start":67.54,"end":69.12,"text":"那你不说你想洗澡吗","meaning":"Vậy ông không phải nói muốn tắm hả?"},{"start":69.08,"end":70.54,"text":"那也不能用凉水啊","meaning":"Dù vậy cũng không được dùng nước lạnh chứ!"},{"start":71.42,"end":72.25,"text":"切~~","meaning":"Xì~~"},{"start":72.54,"end":73.37,"text":"嗯","meaning":"Ừm."},{"start":73.88,"end":75.25,"text":"那我们就用开水呗","meaning":"Vậy mình dùng nước sôi đi."},{"start":75.25,"end":78.21,"text":"啊","meaning":"A!"},{"start":78.17,"end":79.12,"text":"嗯嗯","meaning":"Ưm ưm."}]}