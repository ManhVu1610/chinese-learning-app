{"videoId":"o1we7gXEzKY","title":"我们…非要吃这个？","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":29,"source":"ocr","order":58,"segments":[{"start":12.12,"end":12.83,"text":"妈妈","meaning":"Mẹ ơi"},{"start":12.88,"end":13.79,"text":"为什么我们苍蝇","meaning":"Sao đồng bọn ruồi tụi mình"},{"start":13.83,"end":15.12,"text":"要吃屎呢？","meaning":"Lại phải ăn cứt vậy?"},{"start":15.33,"end":15.91,"text":"啊？","meaning":"Hả?"},{"start":16.96,"end":17.41,"text":"啊","meaning":"Hả"},{"start":17.83,"end":19.12,"text":"跟你说了多少遍了","meaning":"Mẹ nói con bao nhiêu lần rồi"},{"start":19.21,"end":20.04,"text":"吃饭的时候","meaning":"Lúc đang ăn cơm"},{"start":20.04,"end":22.7,"text":"不要讨论","meaning":"Đừng có bàn mấy vụ đó"},{"start":22.71,"end":23.41,"text":"搞得我一下","meaning":"Làm mẹ bỗng"},{"start":23.38,"end":24.25,"text":"胃口都没有了","meaning":"Hết sạch cả khẩu vị"},{"start":24.58,"end":25.04,"text":"不吃了","meaning":"Không ăn nữa"},{"start":26.38,"end":26.87,"text":"烦人","meaning":"Phiền ghê"},{"start":27.38,"end":28.2,"text":"记得关注","meaning":"Nhớ theo dõi nha"}]}