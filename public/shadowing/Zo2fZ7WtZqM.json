{"videoId":"Zo2fZ7WtZqM","title":"又被逼疯了！！之《我不太会说话》","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":103,"source":"ocr","order":38,"segments":[{"start":1,"end":1.46,"text":"哟 师傅","meaning":"Ê, bác tài."},{"start":1.42,"end":2.71,"text":"你怎么还戴个口罩啊","meaning":"Sao còn đeo khẩu trang vậy?"},{"start":2.67,"end":3.5,"text":"感冒了吗","meaning":"Cảm hả?"},{"start":3.46,"end":4.12,"text":"啊 没有","meaning":"À, không có."},{"start":4.08,"end":4.83,"text":"就是我这个人","meaning":"Chỉ là tui đây"},{"start":4.79,"end":6.12,"text":"说话不太好听啊","meaning":"nói chuyện không được lọt tai cho lắm."},{"start":6.08,"end":7.58,"text":"嗨 那有啥的","meaning":"Hầy, có gì đâu."},{"start":7.54,"end":8.33,"text":"你摘了吧","meaning":"Ông tháo ra đi."},{"start":8.33,"end":9.16,"text":"没事啊","meaning":"Không sao đâu."},{"start":10.33,"end":12.08,"text":"哎 您这是要去哪啊","meaning":"Mà ông đi đâu đây?"},{"start":12.04,"end":14.2,"text":"我去趟医院","meaning":"Tui đi bệnh viện một chuyến."},{"start":14.21,"end":15.2,"text":"您是有病吧？","meaning":"Ông bị bệnh hả?"},{"start":15.17,"end":15.62,"text":"啊？","meaning":"Hả?"},{"start":15.62,"end":16.66,"text":"不严重吧？","meaning":"Không nặng chứ?"},{"start":16.62,"end":17.62,"text":"还有的救吗？","meaning":"Còn cứu được không?"},{"start":18.33,"end":18.91,"text":"我没事","meaning":"Tui không sao."},{"start":19.17,"end":20.2,"text":"没什么可担心的","meaning":"Không có gì phải lo hết."},{"start":20.17,"end":20.66,"text":"哦","meaning":"Ồ."},{"start":20.71,"end":21.2,"text":"想不到","meaning":"Không ngờ"},{"start":21.17,"end":22.37,"text":"你长得那么猥琐","meaning":"ông trông mặt mày bỉ ổi vậy"},{"start":22.58,"end":23.7,"text":"心却这么豁达","meaning":"mà lòng dạ lại thoáng thế."},{"start":23.71,"end":24.41,"text":"真好","meaning":"Hay thật."},{"start":24.83,"end":26.16,"text":"不会说话就别说话","meaning":"Không biết nói thì đừng nói."},{"start":26.12,"end":27.25,"text":"你好好开车吧你","meaning":"Ông lo lái xe đàng hoàng đi."},{"start":27.21,"end":28.08,"text":"哦","meaning":"Ờ."},{"start":28.46,"end":29.37,"text":"我跟你讲啊","meaning":"Tui nói cho ông nghe nha,"},{"start":29.33,"end":30.54,"text":"豁达是好事","meaning":"thoáng lòng là chuyện tốt,"},{"start":30.5,"end":31.62,"text":"但为了保险起见","meaning":"nhưng để cho chắc ăn,"},{"start":31.58,"end":32.54,"text":"我觉得你还是","meaning":"tui thấy ông nên"},{"start":32.5,"end":33.91,"text":"应该准备一下后事的","meaning":"chuẩn bị hậu sự đi là vừa."},{"start":34.12,"end":34.79,"text":"不是","meaning":"Khoan."},{"start":34.75,"end":35.91,"text":"怎么我去个医院","meaning":"Sao tui đi bệnh viện"},{"start":35.88,"end":37.08,"text":"我就要准备后事了？","meaning":"mà đã phải lo hậu sự rồi?"},{"start":37.04,"end":37.95,"text":"你别激动","meaning":"Ông đừng kích động."},{"start":37.92,"end":39.62,"text":"我刚刚还夸你豁达呢","meaning":"Tui vừa khen ông thoáng lòng mà."},{"start":39.58,"end":40.04,"text":"这样吧","meaning":"Vầy đi,"},{"start":40,"end":41.41,"text":"我给你介绍一个朋友","meaning":"tui giới thiệu cho ông một người bạn."},{"start":41.5,"end":42.25,"text":"什么朋友？","meaning":"Bạn gì?"},{"start":42.21,"end":43.62,"text":"他是做棺材生意的","meaning":"Ổng bán quan tài."},{"start":44.21,"end":45.37,"text":"我不需要","meaning":"Tui không cần."},{"start":45.33,"end":46.08,"text":"怎么会呢","meaning":"Sao lại không cần chứ,"},{"start":46.04,"end":47.16,"text":"他做工精良","meaning":"ổng làm tinh xảo,"},{"start":47.12,"end":48.08,"text":"价格优美","meaning":"giá cả đẹp,"},{"start":48.04,"end":48.66,"text":"是难得一见……","meaning":"hiếm có khó tìm..."},{"start":48.62,"end":49.41,"text":"他做的那么好","meaning":"Ổng làm tốt vậy,"},{"start":49.38,"end":50.16,"text":"你怎么不用","meaning":"sao ông không dùng?"},{"start":50.12,"end":51.12,"text":"我会用的","meaning":"Tui sẽ dùng chứ,"},{"start":51.12,"end":52.7,"text":"但是我感觉你比我更急","meaning":"nhưng tui thấy ông còn gấp hơn tui."},{"start":52.67,"end":53.95,"text":"你看你长得这么弱鸡","meaning":"Nhìn ông ốm yếu thế này,"},{"start":53.92,"end":55.04,"text":"你才弱鸡呢","meaning":"Ông mới ốm yếu đó!"},{"start":55,"end":56,"text":"你一定很需要","meaning":"Ông chắc chắn rất cần."},{"start":55.96,"end":56.87,"text":"我不需要","meaning":"Tui không cần."},{"start":56.83,"end":57.41,"text":"你需要","meaning":"Ông cần."},{"start":57.54,"end":59.16,"text":"虽然你不一定能马上用上","meaning":"Tuy chưa chắc dùng ngay được,"},{"start":59.12,"end":60.37,"text":"但是有备无患嘛","meaning":"nhưng có chuẩn bị thì không lo mà."},{"start":61.21,"end":62.5,"text":"你把口罩戴上吧你","meaning":"Ông đeo khẩu trang vô đi."},{"start":62.46,"end":63.25,"text":"我也是担心","meaning":"Tui cũng lo thôi,"},{"start":63.21,"end":64.25,"text":"你有个万一嘛","meaning":"lỡ ông có mệnh hệ gì."},{"start":64.21,"end":65.08,"text":"没有万一","meaning":"Không có lỡ gì hết."},{"start":65.25,"end":66,"text":"闭嘴吧你","meaning":"Ông im miệng đi."},{"start":65.96,"end":67.16,"text":"你确定不看看吗","meaning":"Chắc không xem thử hả?"},{"start":67.12,"end":68.25,"text":"它可以试用的","meaning":"Nó dùng thử được đó."},{"start":68.21,"end":69,"text":"我用不着","meaning":"Tui không cần dùng."},{"start":68.96,"end":70,"text":"我谢谢你","meaning":"Cảm ơn ông nha."},{"start":69.96,"end":70.54,"text":"不用谢","meaning":"Đừng khách sáo."},{"start":70.71,"end":72.62,"text":"我这个人主打就是热心肠","meaning":"Tui đây chuyên nhiệt tình mà."},{"start":73.38,"end":74.41,"text":"你好好开车吧你","meaning":"Ông lo lái xe đi."},{"start":74.38,"end":75.54,"text":"怎么这么烦人","meaning":"Sao phiền thế không biết."},{"start":75.5,"end":76.12,"text":"跟你说嘛","meaning":"Nói với ông nè,"},{"start":76.08,"end":76.87,"text":"他们家的棺材","meaning":"quan tài nhà ổng"},{"start":76.83,"end":78.83,"text":"还支持7天无理由退货呢","meaning":"còn hỗ trợ đổi trả trong 7 ngày không cần lý do nữa."},{"start":78.83,"end":80,"text":"真的很划算","meaning":"Thật sự rất lời."},{"start":80.04,"end":81.12,"text":"人生病了就需要朋友的……","meaning":"Người ta bệnh là cần bạn bè lắm..."},{"start":81.17,"end":82.29,"text":"你能不能闭嘴","meaning":"Ông im được không?"},{"start":82.29,"end":82.96,"text":"我一上车","meaning":"Tui vừa lên xe"},{"start":82.96,"end":84.58,"text":"你就嘚嘚嘚个没完","meaning":"là ông lải nhải không dứt."},{"start":84.54,"end":86.5,"text":"我说了我不需要","meaning":"Tui nói rồi tui không cần."},{"start":86.46,"end":87.41,"text":"我没生病","meaning":"Tui không bệnh."},{"start":87.38,"end":88.04,"text":"我去医院","meaning":"Tui đi bệnh viện"},{"start":88,"end":89.04,"text":"不是为了看病","meaning":"không phải để khám bệnh,"},{"start":89,"end":89.79,"text":"是去办事","meaning":"mà là đi làm việc."},{"start":89.75,"end":90.75,"text":"办事！办事！！","meaning":"Làm việc! Làm việc!!"},{"start":90.71,"end":91.54,"text":"明白吗？","meaning":"Hiểu chưa?"},{"start":91.54,"end":92.25,"text":"明白吗？？","meaning":"Hiểu chưa??"},{"start":93.04,"end":93.75,"text":"啊？","meaning":"Hả?"},{"start":93.88,"end":95.08,"text":"去办事啊…？？","meaning":"Đi làm việc á...??"},{"start":96.17,"end":97.46,"text":"喜事 还是丧事啊？","meaning":"Việc vui hay việc tang vậy?"},{"start":97.67,"end":99.37,"text":"你们家去医院办喜事？","meaning":"Nhà ông đi bệnh viện làm việc vui á?"},{"start":99.33,"end":100.21,"text":"那就是丧事","meaning":"Vậy là việc tang rồi."},{"start":100.17,"end":100.83,"text":"我那个朋友","meaning":"Bạn tui đó,"},{"start":100.79,"end":101.46,"text":"他那个棺…","meaning":"cái quan tài của ổng..."},{"start":101.42,"end":101.96,"text":"啊","meaning":"Á!"}]}