{"videoId":"DAA22rM6gQ8","title":"牛猫王：脑子转弯是吧？！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":137,"source":"ocr","order":7,"segments":[{"start":3,"end":4.04,"text":"你这是干嘛","meaning":"Ông đang làm cái trò gì vậy?"},{"start":4.04,"end":6.21,"text":"我在醒脑","meaning":"Tui đang tỉnh não đây"},{"start":6.46,"end":7.21,"text":"醒什么脑？","meaning":"Tỉnh não cái gì?"},{"start":7.38,"end":9.45,"text":"我做算术，算不出来了","meaning":"Tui đang tính toán mà tính hoài không ra"},{"start":10.04,"end":10.58,"text":"啊？","meaning":"Hả?"},{"start":10.54,"end":11.7,"text":"好了，好了，别撞了","meaning":"Thôi thôi, đừng đập nữa"},{"start":11.67,"end":13,"text":"别把桌子给撞坏了","meaning":"Đập hư bàn bây giờ"},{"start":12.96,"end":14.58,"text":"一看你就是脑子不够用啊","meaning":"Nhìn là biết ông thiếu não rồi"},{"start":14.67,"end":15.45,"text":"脑子？","meaning":"Não á?"},{"start":15.42,"end":17.5,"text":"我做算术从不用脑子的","meaning":"Tui tính toán có bao giờ xài não đâu"},{"start":17.46,"end":17.95,"text":"啊？","meaning":"Hả?"},{"start":18.12,"end":19.08,"text":"那你用什么","meaning":"Vậy ông xài cái gì?"},{"start":19.12,"end":19.95,"text":"用手指啊","meaning":"Xài ngón tay chứ sao"},{"start":20.12,"end":21.75,"text":"可是我手指有点不够用","meaning":"Mà ngón tay tui hơi bị thiếu"},{"start":21.79,"end":23.08,"text":"我正在苦恼","meaning":"Tui đang đau đầu đây"},{"start":23.33,"end":24.25,"text":"手指不够","meaning":"Không đủ ngón tay"},{"start":24.21,"end":25.41,"text":"你可以用脚趾嘛","meaning":"Ông xài ngón chân đi"},{"start":25.38,"end":26.7,"text":"没有必要撞脑袋呀","meaning":"Khỏi cần đập đầu làm gì"},{"start":26.67,"end":27.7,"text":"哎,对哦","meaning":"Ê, ờ ha"},{"start":29.42,"end":30.37,"text":"我没有脚趾","meaning":"Tui làm gì có ngón chân"},{"start":31.04,"end":31.58,"text":"嘿！","meaning":"Ê!"},{"start":31.54,"end":32,"text":"啊？","meaning":"Hả?"},{"start":32,"end":33.25,"text":"借你手指用用","meaning":"Mượn ngón tay ông xài tí"},{"start":35.04,"end":35.87,"text":"呃","meaning":"Ơ..."},{"start":37.42,"end":38.7,"text":"他有手指","meaning":"Ổng có ngón tay nè"},{"start":38.79,"end":39.7,"text":"哎，别去","meaning":"Ấy, đừng đi"},{"start":39.67,"end":41.41,"text":"他脾气不……好","meaning":"Tính ổng hơi... không tốt đâu"},{"start":41.83,"end":43.87,"text":"我的手是你随便牵的吗？","meaning":"Tay tui mà ông muốn dắt là dắt hả?"},{"start":43.83,"end":44.5,"text":"滚！","meaning":"Cút!"},{"start":46.92,"end":48.41,"text":"你到底在算什么呀","meaning":"Rốt cuộc ông đang tính cái gì vậy?"},{"start":48.38,"end":49.54,"text":"我在算饭钱","meaning":"Tui đang tính tiền cơm"},{"start":50.17,"end":52.04,"text":"你让老板帮你算不就完了吗","meaning":"Nhờ ông chủ tính giùm không phải xong rồi à?"},{"start":52,"end":53.7,"text":"不行 我要自己算","meaning":"Không được, tui phải tự tính"},{"start":53.71,"end":55.29,"text":"我将来要当数神","meaning":"Sau này tui sẽ làm thần toán học"},{"start":55.25,"end":56.66,"text":"数学之神","meaning":"Thần của môn toán!"},{"start":56.62,"end":58.62,"text":"哼我看你只能当胎神","meaning":"Hứ, tui thấy ông chỉ làm được thần ngố thôi"},{"start":58.62,"end":60.83,"text":"这么简单数学题都算不出来","meaning":"Bài toán đơn giản vậy mà cũng tính không ra"},{"start":60.79,"end":61.58,"text":"还数神","meaning":"Còn bày đặt thần toán"},{"start":62.96,"end":65.41,"text":"牛猫王，咱读书不能读死书","meaning":"Ngưu Miêu Vương, đi học không được học vẹt đâu"},{"start":65.38,"end":67.46,"text":"要学会脑子转弯，知道吗","meaning":"Phải biết xoay chuyển cái đầu, hiểu chưa?"},{"start":67.54,"end":68.58,"text":"嗯嗯","meaning":"Ừ ừ"},{"start":69.79,"end":70.83,"text":"你这是干嘛？","meaning":"Ông làm cái gì vậy?"},{"start":70.79,"end":74.37,"text":"脑子转弯呀","meaning":"Xoay chuyển cái đầu nè"},{"start":74.5,"end":75.5,"text":"4+3=9","meaning":"4+3=9"},{"start":75.46,"end":76.5,"text":"7+3=8","meaning":"7+3=8"},{"start":76.46,"end":77.5,"text":"好了好了，别算了","meaning":"Thôi thôi, đừng tính nữa"},{"start":77.46,"end":79.25,"text":"一会该算到自己死期了","meaning":"Lát nữa tính ra ngày chết của mình mất"},{"start":79.29,"end":80,"text":"啊？","meaning":"Hả?"},{"start":80.83,"end":82.16,"text":"走，让老板给你算","meaning":"Đi, để ông chủ tính cho"},{"start":83.42,"end":85.04,"text":"一共20块零五毛","meaning":"Tổng cộng 20 đồng 5 hào"},{"start":85,"end":85.5,"text":"哇！","meaning":"Wow!"},{"start":85.46,"end":87.37,"text":"啊？","meaning":"Hả?"},{"start":87.46,"end":88.37,"text":"快啥呀","meaning":"Nhanh cái gì mà nhanh"},{"start":88.33,"end":89.5,"text":"这还算慢的呢","meaning":"Vậy là còn chậm đó"},{"start":89.5,"end":90.25,"text":"呃……","meaning":"Ờ..."},{"start":90.33,"end":92.41,"text":"可不可以帮我抹个零啊","meaning":"Bớt cho tui một số 0 được không?"},{"start":92.38,"end":93.21,"text":"可以呀","meaning":"Được chứ"},{"start":93.33,"end":94.37,"text":"给！二块五","meaning":"Đây! Hai đồng rưỡi!"},{"start":94.46,"end":94.91,"text":"啊？","meaning":"Hả?"},{"start":95.62,"end":97.37,"text":"你抹中间那个0啊","meaning":"Ông xóa cái số 0 ở giữa hả?"},{"start":98.04,"end":99.66,"text":"哪有你这样抹0的呀","meaning":"Có ai bớt số 0 kiểu đó không?"},{"start":99.62,"end":100.75,"text":"他同意我抹0","meaning":"Bả đồng ý cho tui bớt số 0 mà"},{"start":100.92,"end":102.29,"text":"又没说抹哪个0","meaning":"Có nói là bớt số 0 nào đâu"},{"start":102.33,"end":104.5,"text":"而且 我只有这么多钱","meaning":"Với lại tui chỉ có chừng đó tiền thôi"},{"start":104.67,"end":105.5,"text":"啊？","meaning":"Hả?"},{"start":105.88,"end":106.79,"text":"算我倒霉","meaning":"Coi như tui xui"},{"start":106.75,"end":107.41,"text":"快滚吧","meaning":"Cút nhanh đi"},{"start":107.58,"end":109.21,"text":"谢谢蛙芙蓉","meaning":"Cảm ơn Ếch Phù Dung nha"},{"start":109.17,"end":109.87,"text":"嘿嘿","meaning":"Hê hê"},{"start":109.92,"end":111.25,"text":"啊？","meaning":"Hả?"},{"start":111.75,"end":112.54,"text":"我也结账","meaning":"Tui cũng tính tiền"},{"start":112.92,"end":113.37,"text":"给","meaning":"Đây"},{"start":113.62,"end":114.96,"text":"一块钱？","meaning":"Một đồng á?"},{"start":115.12,"end":116.25,"text":"我也抹零","meaning":"Tui cũng bớt số 0"},{"start":116.21,"end":116.62,"text":"啊？","meaning":"Hả?"},{"start":117.38,"end":118.96,"text":"你抹3个零啊","meaning":"Ông bớt tới 3 số 0 hả?"},{"start":118.92,"end":119.5,"text":"啊","meaning":"Hả"},{"start":119.54,"end":120.37,"text":"你这样抹零","meaning":"Bớt số 0 kiểu này"},{"start":120.33,"end":122.12,"text":"直接抹到我的大动脉了呀","meaning":"Là cắt thẳng vô động mạch chủ của tui luôn đó"},{"start":122.08,"end":123.04,"text":"我也没办法","meaning":"Tui cũng hết cách"},{"start":123,"end":124.33,"text":"我只有这么多钱","meaning":"Tui chỉ có chừng đó tiền"},{"start":124.29,"end":125.16,"text":"我先滚了哈","meaning":"Tui cút trước nha"},{"start":125.12,"end":126.12,"text":"拜拜","meaning":"Bái bai"},{"start":126.08,"end":126.62,"text":"啊？","meaning":"Hả?"},{"start":127.62,"end":129.08,"text":"你学这个数学真不错","meaning":"Ông học môn toán này đỉnh thật"},{"start":129.04,"end":130.08,"text":"好省钱哦","meaning":"Tiết kiệm tiền ghê"},{"start":130.04,"end":131.16,"text":"以后我也跟着你学","meaning":"Sau này tui cũng theo ông học"},{"start":131.25,"end":132,"text":"好啊","meaning":"Được thôi"},{"start":132.04,"end":132.87,"text":"哈哈哈","meaning":"Ha ha ha"},{"start":133,"end":135.25,"text":"你们俩当我是傻是吧","meaning":"Hai người coi tui là đồ ngốc hả?"},{"start":135.79,"end":136.41,"text":"啊？","meaning":"Hả?"}]}