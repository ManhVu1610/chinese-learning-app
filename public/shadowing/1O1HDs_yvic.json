{"videoId":"1O1HDs_yvic","title":"牛猫王：你说谁没有智商！？","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":96,"source":"ocr","order":45,"segments":[{"start":0.25,"end":0.79,"text":"不可能","meaning":"Không thể nào!"},{"start":0.75,"end":2.04,"text":"我智商没那么低","meaning":"IQ của tao đâu có thấp vậy."},{"start":2,"end":3.16,"text":"我要再测一测","meaning":"Tao muốn thi lại một lần."},{"start":3.75,"end":4.91,"text":"请听题","meaning":"Nghe câu hỏi nè."},{"start":5.25,"end":6.79,"text":"一只会喷火的麒麟","meaning":"Một con kỳ lân biết phun lửa"},{"start":6.75,"end":7.79,"text":"飞到了北极","meaning":"bay tới Bắc Cực,"},{"start":7.75,"end":8.79,"text":"会发生什么","meaning":"sẽ xảy ra chuyện gì?"},{"start":8.79,"end":9.95,"text":"会融化冰川","meaning":"Làm tan chảy sông băng!"},{"start":10,"end":11.12,"text":"错 你答","meaning":"Sai! Tới lượt mày đáp."},{"start":11.08,"end":12.2,"text":"会变成 冰麒麟（冰淇淋）","meaning":"Sẽ biến thành kỳ lân băng (kem)!"},{"start":12.17,"end":13.37,"text":"回答正确","meaning":"Trả lời chính xác."},{"start":13.33,"end":13.7,"text":"啊？","meaning":"Hả?"},{"start":14.12,"end":15.16,"text":"这么简单都不会","meaning":"Dễ vậy mà cũng không biết,"},{"start":15.12,"end":15.58,"text":"笨","meaning":"ngốc!"},{"start":15.75,"end":16.75,"text":"照你这么说","meaning":"Theo như mày nói,"},{"start":16.71,"end":18.29,"text":"如果他飞到了锅炉房","meaning":"nếu nó bay vào phòng nồi hơi,"},{"start":18.46,"end":19.45,"text":"岂不是要变成……","meaning":"chẳng phải sẽ biến thành..."},{"start":19.5,"end":20.33,"text":"锅麒麟","meaning":"kỳ lân nồi?"},{"start":21.33,"end":21.83,"text":"对啊","meaning":"Đúng đó!"},{"start":21.79,"end":22.54,"text":"不错嘛","meaning":"Khá lắm nha,"},{"start":22.5,"end":23.79,"text":"会举一反三了","meaning":"biết suy một ra ba rồi."},{"start":23.96,"end":25.33,"text":"可惜你刚才没有答对","meaning":"Tiếc là câu vừa rồi mày không đúng."},{"start":25.38,"end":26.75,"text":"呵 我找到诀窍了","meaning":"Hừ, tao tìm ra bí quyết rồi."},{"start":26.75,"end":27.5,"text":"再来","meaning":"Làm tiếp!"},{"start":27.62,"end":28.37,"text":"请听题","meaning":"Nghe câu hỏi nè."},{"start":28.92,"end":29.75,"text":"国有国法","meaning":"Nước có luật nước,"},{"start":29.71,"end":30.79,"text":"家有家规","meaning":"nhà có quy tắc nhà."},{"start":30.83,"end":32.37,"text":"那动物园有什么规？","meaning":"Vậy sở thú có quy gì?"},{"start":32.5,"end":33.66,"text":"…有园规","meaning":"...Có viên quy?"},{"start":33.75,"end":35,"text":"错 你来","meaning":"Sai! Mày thử đi."},{"start":35.12,"end":36.16,"text":"有乌龟","meaning":"Có rùa."},{"start":36.12,"end":37.62,"text":"你怎么这么笨呐","meaning":"Sao mày ngốc vậy trời!"},{"start":37.58,"end":38.79,"text":"乌龟啊？","meaning":"Rùa hả?"},{"start":38.75,"end":39.25,"text":"对啊","meaning":"Đúng rồi."},{"start":39.21,"end":40.91,"text":"动物园又不用给人画饼","meaning":"Sở thú đâu cần vẽ bánh cho ai,"},{"start":40.88,"end":41.87,"text":"要什么圆规啊","meaning":"cần gì cái com-pa chứ?"},{"start":42.62,"end":43.08,"text":"好了好了","meaning":"Thôi được rồi được rồi,"},{"start":43.04,"end":43.54,"text":"别测了","meaning":"đừng thi nữa."},{"start":43.5,"end":45.33,"text":"你这个智商只会越测越低","meaning":"IQ của mày càng đo càng tụt thôi."},{"start":45.38,"end":45.95,"text":"不行","meaning":"Không được!"},{"start":45.92,"end":46.66,"text":"我今天非要","meaning":"Hôm nay tao nhất định phải"},{"start":46.62,"end":48.08,"text":"为我这个智商讨个说法","meaning":"đòi lại công bằng cho cái IQ của tao."},{"start":48.42,"end":49.16,"text":"再来一题","meaning":"Thêm một câu nữa."},{"start":49.33,"end":49.87,"text":"哎","meaning":"Haizz."},{"start":50.17,"end":51.04,"text":"请听题","meaning":"Nghe câu hỏi nè."},{"start":51.12,"end":51.75,"text":"说","meaning":"Nói đi!"},{"start":51.71,"end":53.62,"text":"一块铁放在外面会生锈","meaning":"Một miếng sắt để ngoài trời sẽ bị gỉ,"},{"start":53.58,"end":54.75,"text":"那一块金子呢？","meaning":"vậy một miếng vàng thì sao?"},{"start":54.71,"end":55.87,"text":"会闪闪发光","meaning":"Sẽ lấp lánh sáng chói!"},{"start":55.83,"end":56.66,"text":"错","meaning":"Sai."},{"start":57.08,"end":57.91,"text":"会生霉","meaning":"Sẽ bị mốc."},{"start":57.88,"end":58.62,"text":"又错","meaning":"Lại sai."},{"start":58.58,"end":60.04,"text":"当然是会被人捡走啊","meaning":"Dĩ nhiên là bị người ta nhặt mất rồi."},{"start":60,"end":60.7,"text":"笨蛋","meaning":"Đồ ngốc."},{"start":60.67,"end":61.12,"text":"啊","meaning":"Hả?"},{"start":61.5,"end":62.79,"text":"金子生霉？","meaning":"Vàng mà bị mốc?"},{"start":62.75,"end":63.45,"text":"你怎么不说","meaning":"Sao mày không nói luôn"},{"start":63.42,"end":64.25,"text":"会生蛆啊？","meaning":"là bị sinh giòi đi?"},{"start":64.71,"end":66.37,"text":"咦 死机了吗","meaning":"Ơ, bị đơ rồi hả?"},{"start":66.33,"end":67.5,"text":"不会中暑了吧","meaning":"Không phải bị say nắng chứ?"},{"start":67.54,"end":68.75,"text":"快给他喝正气液呀","meaning":"Mau cho nó uống Chính Khí Thủy đi!"},{"start":70.08,"end":70.71,"text":"哇","meaning":"Oa!"},{"start":70.67,"end":71.71,"text":"状态变好好","meaning":"Trạng thái tốt lên hẳn!"},{"start":71.71,"end":73.46,"text":"我现在信心满满哎","meaning":"Giờ tao tự tin đầy mình luôn!"},{"start":73.42,"end":73.79,"text":"哼","meaning":"Hứ."},{"start":73.83,"end":74.62,"text":"状态好了","meaning":"Trạng thái tốt lên"},{"start":74.58,"end":75.79,"text":"又不代表你智商高","meaning":"đâu có nghĩa là IQ mày cao."},{"start":75.75,"end":76.33,"text":"啊","meaning":"Hả?"},{"start":76.75,"end":77.87,"text":"快出题快出题","meaning":"Ra đề mau, ra đề mau!"},{"start":77.92,"end":78.79,"text":"最后一题","meaning":"Câu cuối cùng."},{"start":78.88,"end":79.91,"text":"请问为什么","meaning":"Xin hỏi, tại sao"},{"start":79.88,"end":82,"text":"刚烧开的山泉水 不能喝","meaning":"nước suối vừa mới đun sôi lại không uống được?"},{"start":81.96,"end":82.87,"text":"这个我知道","meaning":"Cái này tao biết!"},{"start":82.83,"end":84.25,"text":"因为有些矿物质加热了","meaning":"Vì có vài khoáng chất khi đun nóng"},{"start":84.21,"end":85.04,"text":"对人有害","meaning":"sẽ có hại cho người."},{"start":85.04,"end":85.58,"text":"错！","meaning":"Sai!"},{"start":86.46,"end":88.12,"text":"因为会烫啊 笨蛋","meaning":"Vì nó nóng bỏng miệng đó, đồ ngốc!"},{"start":88.08,"end":89.25,"text":"你怎么这么笨呐","meaning":"Sao mày ngốc vậy trời!"},{"start":89.21,"end":90.46,"text":"真的是 哎","meaning":"Thật là... haizz."},{"start":90.42,"end":90.87,"text":"但是","meaning":"Nhưng mà"},{"start":90.83,"end":91.79,"text":"你不会被烫哦","meaning":"mày sẽ không bị bỏng đâu nha."},{"start":91.79,"end":93,"text":"为什么","meaning":"Tại sao?"},{"start":92.96,"end":93.5,"text":"因为……","meaning":"Bởi vì..."},{"start":93.46,"end":95,"text":"因为死猪不怕开水烫","meaning":"vì heo chết thì không sợ nước sôi!"},{"start":94.96,"end":95.83,"text":"啊？","meaning":"Hả?"}]}