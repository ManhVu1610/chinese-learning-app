{"videoId":"fHYkqFoCxq0","title":"当诈骗遇上笨蛋……！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":165,"source":"ocr","order":37,"segments":[{"start":0.21,"end":1.29,"text":"100万！？","meaning":"100 vạn!?"},{"start":1.29,"end":2.46,"text":"你发财了？","meaning":"Mày phát tài rồi hả?"},{"start":2.42,"end":3,"text":"没有啊","meaning":"Đâu có"},{"start":3.21,"end":4.5,"text":"那你哪来那么多钱？","meaning":"Vậy mày lấy đâu ra nhiều tiền vậy?"},{"start":4.75,"end":8.16,"text":"是我的一个老乡给我","meaning":"Là một ông đồng hương gửi cho tui"},{"start":8.17,"end":9.33,"text":"老乡转给老乡","meaning":"Đồng hương chuyển cho đồng hương"},{"start":9.38,"end":10.75,"text":"再转给另一个老乡","meaning":"Rồi lại chuyển cho đồng hương khác"},{"start":10.92,"end":11.95,"text":"他不觉得绕吗？","meaning":"Ổng không thấy vòng vo hả?"},{"start":11.92,"end":13.04,"text":"为什么不直接转？","meaning":"Sao không chuyển thẳng?"},{"start":13,"end":14.5,"text":"他说他想照顾一下我","meaning":"Ổng nói muốn chiếu cố tui một chút"},{"start":14.46,"end":15.37,"text":"帮他转一笔","meaning":"Giúp ổng chuyển một khoản"},{"start":15.42,"end":17.04,"text":"就会给我1000块手续费","meaning":"Là cho tui 1000 đồng phí dịch vụ"},{"start":17.08,"end":17.45,"text":"啊？","meaning":"Hả?"},{"start":17.71,"end":18.87,"text":"还有这种好事","meaning":"Còn có chuyện tốt vậy nữa"},{"start":19.33,"end":20.41,"text":"这下有钱了","meaning":"Giờ có tiền rồi nè"},{"start":20.38,"end":21.37,"text":"我一定要给自己","meaning":"Tui nhất định phải tự thưởng cho mình"},{"start":21.33,"end":22.66,"text":"买一条好看的花秋裤","meaning":"Mua một cái quần thu hoa hoa thiệt đẹp"},{"start":22.62,"end":23.5,"text":"来过冬","meaning":"Để qua mùa đông"},{"start":23.46,"end":24.37,"text":"嘿嘿嘿","meaning":"He he he"},{"start":24.33,"end":25.08,"text":"花秋裤？！","meaning":"Quần thu hoa?!"},{"start":25.29,"end":26.58,"text":"这什么爱好？","meaning":"Cái sở thích gì vậy trời?"},{"start":27.08,"end":28.16,"text":"瞧你那点出息","meaning":"Nhìn cái tiền đồ của mày kìa"},{"start":28.12,"end":29.12,"text":"我要是有钱了","meaning":"Tao mà có tiền"},{"start":29.08,"end":30.33,"text":"我就盖两栋别墅","meaning":"Tao xây hai căn biệt thự"},{"start":30.38,"end":30.87,"text":"哦？","meaning":"Ồ?"},{"start":30.83,"end":32.04,"text":"一栋拿来住人","meaning":"Một căn để ở"},{"start":32,"end":32.79,"text":"另一栋呢","meaning":"Còn căn kia thì sao"},{"start":32.75,"end":33.79,"text":"拿来养猪","meaning":"Để nuôi heo"},{"start":34.46,"end":34.87,"text":"嘿","meaning":"Hề"},{"start":35.04,"end":36.16,"text":"还是老大有想法","meaning":"Vẫn là đại ca có tầm nhìn"},{"start":36.12,"end":37.04,"text":"嘿嘿嘿","meaning":"He he he"},{"start":38.5,"end":39.45,"text":"怎么感觉","meaning":"Sao tui thấy"},{"start":39.42,"end":40.66,"text":"他是在洗钱呢","meaning":"Ổng đang rửa tiền hả"},{"start":40.62,"end":41.29,"text":"洗什么钱","meaning":"Rửa tiền gì"},{"start":41.29,"end":42.12,"text":"洗什么钱","meaning":"Rửa tiền gì"},{"start":42.42,"end":43.37,"text":"平时让他洗个裤衩","meaning":"Bình thường kêu nó giặt cái quần đùi"},{"start":43.33,"end":44.12,"text":"都洗不干净","meaning":"Còn giặt không sạch"},{"start":44.08,"end":45.25,"text":"他能洗个什么钱？","meaning":"Nó rửa được tiền gì chứ?"},{"start":45.38,"end":45.75,"text":"额","meaning":"Ờ"},{"start":45.71,"end":47.25,"text":"你这就是嫉妒","meaning":"Mày đây là ghen tị"},{"start":47.25,"end":48.54,"text":"见不得别人有钱","meaning":"Không chịu được người khác có tiền"},{"start":48.58,"end":49.29,"text":"回头记得","meaning":"Lát nhớ"},{"start":49.25,"end":50.54,"text":"把你老乡介绍给我啊","meaning":"Giới thiệu ông đồng hương của mày cho tao nha"},{"start":50.5,"end":51.66,"text":"好嘞","meaning":"Dạ được"},{"start":53.88,"end":54.33,"text":"喂","meaning":"Alo"},{"start":54.29,"end":54.7,"text":"老乡","meaning":"Đồng hương ơi"},{"start":55.04,"end":56,"text":"老乡好","meaning":"Chào đồng hương"},{"start":58.17,"end":60.12,"text":"钱收到了吗","meaning":"Nhận được tiền chưa"},{"start":60.08,"end":61.66,"text":"那用手机转过来吧","meaning":"Vậy dùng điện thoại chuyển qua đi"},{"start":63.25,"end":63.91,"text":"你干嘛","meaning":"Mày làm gì vậy"},{"start":64.04,"end":65.5,"text":"你不是让我手机转过来吗","meaning":"Chẳng phải ngài kêu tui chuyển điện thoại qua sao"},{"start":66.42,"end":67.96,"text":"我是让你把钱转过来","meaning":"Tao kêu mày chuyển tiền qua"},{"start":68.96,"end":69.83,"text":"怎么转啊?","meaning":"Chuyển sao đây?"},{"start":71.42,"end":72.83,"text":"在这个界面填好信息","meaning":"Điền xong thông tin ở màn hình này"},{"start":72.79,"end":73.75,"text":"就可以转账了","meaning":"Là chuyển khoản được rồi"},{"start":74,"end":75.08,"text":"你先把卡号填一下","meaning":"Mày điền số thẻ trước đi"},{"start":76.83,"end":77.91,"text":"我帮你拿着吧","meaning":"Để tao cầm giùm cho"},{"start":78.17,"end":78.62,"text":"哦","meaning":"Ò"},{"start":78.58,"end":79.87,"text":"老乡好","meaning":"Chào đồng hương"},{"start":80.21,"end":80.87,"text":"呃，你好","meaning":"Ờ, chào ông"},{"start":80.83,"end":81.21,"text":"呃，你好","meaning":"Ờ, chào ông"},{"start":81.21,"end":82.66,"text":"老乡你这个造型好别致啊","meaning":"Đồng hương ơi, tạo hình của ông độc đáo ghê"},{"start":83.42,"end":83.96,"text":"哦，谢谢","meaning":"À, cảm ơn"},{"start":84.04,"end":85.33,"text":"是你妈给你织的头套吗","meaning":"Mũ trùm đầu này mẹ ông đan cho hả"},{"start":85.62,"end":87,"text":"你妈真是心灵手巧","meaning":"Mẹ ông đúng là khéo tay"},{"start":87.04,"end":87.41,"text":"哎","meaning":"Ây"},{"start":87.5,"end":88.62,"text":"你妈贵姓啊","meaning":"Mẹ ông họ gì vậy"},{"start":88.58,"end":89.62,"text":"叫她出来聊会天呗","meaning":"Kêu bả ra nói chuyện chút đi"},{"start":89.58,"end":90.04,"text":"咦？","meaning":"Ơ?"},{"start":90,"end":91.04,"text":"怎么不行啊","meaning":"Sao lại không được"},{"start":91.67,"end":92.54,"text":"你输的什么啊？","meaning":"Mày nhập cái gì vậy?"},{"start":93.17,"end":93.54,"text":"卡号啊","meaning":"Số thẻ chứ gì"},{"start":95.75,"end":97.37,"text":"我真是要被你蠢哭了","meaning":"Tao bị mày làm cho ngu muốn khóc luôn"},{"start":98.62,"end":100.25,"text":"哎呀你没看见提示吗","meaning":"Ây da, mày không thấy nhắc hả"},{"start":100.29,"end":101.75,"text":"格式不正确","meaning":"Định dạng không đúng"},{"start":101.75,"end":103.71,"text":"让你输入正确的卡号","meaning":"Kêu mày nhập đúng số thẻ"},{"start":103.96,"end":104.75,"text":"真是笨死了","meaning":"Đúng là ngu chết đi được"},{"start":105,"end":106.21,"text":"还是我来吧","meaning":"Thôi để tao"},{"start":109.29,"end":110.12,"text":"啊","meaning":"Á"},{"start":111.17,"end":112.21,"text":"让你俩填个表","meaning":"Kêu hai đứa mày điền cái bảng"},{"start":112.17,"end":113.58,"text":"硬是废掉了我半条命","meaning":"Mà hao tốn của tao nửa cái mạng"},{"start":113.88,"end":115.16,"text":"总算到最后一步了","meaning":"Cuối cùng cũng tới bước cuối"},{"start":115.29,"end":116.37,"text":"你现在输入密码","meaning":"Giờ mày nhập mật khẩu"},{"start":116.33,"end":117.96,"text":"就可以转账了","meaning":"Là chuyển khoản được rồi"},{"start":118.04,"end":118.54,"text":"哎","meaning":"Ây"},{"start":120,"end":120.75,"text":"哎","meaning":"Ây"},{"start":122.33,"end":123.12,"text":"呃","meaning":"Ờ"},{"start":123.67,"end":125.62,"text":"你怎么又把账号给锁了呀","meaning":"Sao mày lại khóa tài khoản nữa rồi"},{"start":126.29,"end":126.96,"text":"你干了什么啊","meaning":"Mày làm cái gì vậy"},{"start":126.92,"end":128.37,"text":"我就输了密码呀","meaning":"Tui chỉ nhập mật khẩu thôi mà"},{"start":128.38,"end":129.33,"text":"你密码输的啥","meaning":"Mày nhập mật khẩu gì"},{"start":129.29,"end":130.33,"text":"一串星号******","meaning":"Một dãy dấu sao******"},{"start":131.33,"end":132.2,"text":"我让你输密码","meaning":"Tao kêu mày nhập mật khẩu"},{"start":132.21,"end":133.2,"text":"你输什么星号**啊","meaning":"Mày nhập dấu sao** làm gì"},{"start":133.17,"end":134.7,"text":"我看别人输入密码","meaning":"Tui thấy người ta nhập mật khẩu"},{"start":134.67,"end":135.66,"text":"都是星号啊(******)","meaning":"Toàn là dấu sao hà (******)"},{"start":135.62,"end":136.04,"text":"哎","meaning":"Ây"},{"start":136.04,"end":137.12,"text":"这个我可以作证","meaning":"Cái này tui làm chứng được"},{"start":137.08,"end":137.79,"text":"确实是星号","meaning":"Đúng là dấu sao"},{"start":137.79,"end":138.58,"text":"你作个屁的证啊","meaning":"Làm chứng cái đầu mày"},{"start":138.83,"end":139.58,"text":"一边凉快去吧你","meaning":"Biến qua một bên đi"},{"start":140.46,"end":140.95,"text":"啊","meaning":"Á"},{"start":140.92,"end":141.45,"text":"啊","meaning":"Á"},{"start":141.62,"end":143.04,"text":"“辛辛苦苦”诈骗来的钱","meaning":"Tiền \"vất vả\" lừa đảo mới có được"},{"start":143.04,"end":144.08,"text":"取不出来了","meaning":"Rút không ra rồi"},{"start":144.04,"end":144.45,"text":"啊","meaning":"Á"},{"start":144.75,"end":145.5,"text":"没有密码","meaning":"Không có mật khẩu"},{"start":145.46,"end":146.41,"text":"可以刷脸啊","meaning":"Có thể quét mặt mà"},{"start":146.83,"end":147.29,"text":"对哦","meaning":"Ờ ha"},{"start":147.25,"end":147.7,"text":"快快快","meaning":"Nhanh nhanh nhanh"},{"start":147.83,"end":148.87,"text":"赶紧刷脸认证","meaning":"Mau quét mặt xác thực"},{"start":148.88,"end":150.16,"text":"赶紧把钱给我转过来","meaning":"Mau chuyển tiền cho tao"},{"start":151.21,"end":152.16,"text":"你们在干嘛？","meaning":"Mấy người đang làm gì vậy?"},{"start":152.25,"end":153.08,"text":"我们在……","meaning":"Tụi tui đang......"},{"start":153.04,"end":153.87,"text":"刷脸啊","meaning":"Quét mặt nè"},{"start":155,"end":155.7,"text":"啊","meaning":"Á"},{"start":156.54,"end":157.7,"text":"上海公安提醒您：","meaning":"Công an Thượng Hải nhắc bạn:"},{"start":157.67,"end":159.04,"text":"“洗钱”、“跑分”是违法","meaning":"\"Rửa tiền\", \"chạy điểm\" là phạm pháp"},{"start":159,"end":160.33,"text":"警惕诈骗新手法","meaning":"Cảnh giác chiêu lừa đảo mới"},{"start":160.29,"end":161.54,"text":"不做电诈的“工具人”","meaning":"Đừng làm \"công cụ\" cho bọn lừa đảo qua mạng"}]}