{"videoId":"rUDYRG3ItzI","title":"这样能减肥？！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":115,"source":"ocr","order":39,"segments":[{"start":3.25,"end":3.79,"text":"你干嘛呢","meaning":"Ông làm gì đó"},{"start":4.33,"end":4.71,"text":"哦","meaning":"À"},{"start":4.75,"end":5.79,"text":"我在减肥","meaning":"Tui đang giảm cân"},{"start":6.04,"end":6.66,"text":"减肥？","meaning":"Giảm cân?"},{"start":6.62,"end":7.21,"text":"对啊","meaning":"Ừ đó"},{"start":7.21,"end":8.62,"text":"我只看见你在吃","meaning":"Tui chỉ thấy ông đang ăn"},{"start":8.58,"end":10.08,"text":"没看见你减肥呢","meaning":"Có thấy giảm cân đâu"},{"start":10.08,"end":10.91,"text":"专家说的","meaning":"Chuyên gia nói đó"},{"start":10.88,"end":12.12,"text":"运动可以减肥","meaning":"Vận động giúp giảm cân"},{"start":12.62,"end":13.45,"text":"？？","meaning":"??"},{"start":13.67,"end":15.08,"text":"你这算哪门子运动","meaning":"Đây mà là vận động kiểu gì"},{"start":15.25,"end":16.58,"text":"肠胃运动啊","meaning":"Vận động đường ruột chứ sao"},{"start":18.25,"end":19,"text":"不用称了","meaning":"Khỏi cân"},{"start":18.96,"end":20.25,"text":"你肯定又长肉了","meaning":"Chắc chắn lại mập thêm rồi"},{"start":20.21,"end":21.08,"text":"怎么可能","meaning":"Làm gì có chuyện đó"},{"start":23,"end":23.45,"text":"看！","meaning":"Nhìn nè!"},{"start":23.58,"end":25.08,"text":"还是200公斤","meaning":"Vẫn 200 ký"},{"start":25.04,"end":25.7,"text":"没长","meaning":"Không tăng"},{"start":26.88,"end":28.87,"text":"你这称只能称200公斤啊","meaning":"Cái cân này của ông chỉ cân được 200 ký thôi"},{"start":30.17,"end":31.62,"text":"怎么还没瘦呢","meaning":"Sao chưa ốm nữa ta"},{"start":31.62,"end":33.54,"text":"我“运动”的这么辛苦","meaning":"Tui \"vận động\" vất vả vậy"},{"start":33.5,"end":34.95,"text":"一定是秤坏了","meaning":"Chắc chắn là cân hư rồi"},{"start":34.92,"end":35.45,"text":"啊？","meaning":"Hả?"},{"start":35.46,"end":36.16,"text":"秤没坏","meaning":"Cân không hư"},{"start":36.12,"end":36.75,"text":"你的体重","meaning":"Cân nặng của ông"},{"start":36.71,"end":38.08,"text":"已经超过他的最大值了","meaning":"Đã vượt quá mức tối đa của nó rồi"},{"start":39.96,"end":40.62,"text":"看吧","meaning":"Thấy chưa"},{"start":40.58,"end":41.87,"text":"我就说坏了嘛","meaning":"Tui nói hư mà"},{"start":42.83,"end":43.7,"text":"是你跟他说的","meaning":"Là mày nói với nó đó hả"},{"start":43.67,"end":44.25,"text":"光吃饭","meaning":"Chỉ ăn cơm"},{"start":44.21,"end":45.7,"text":"靠肠胃运动能减肥？","meaning":"Dựa vào vận động đường ruột mà giảm cân được hả?"},{"start":45.79,"end":46.54,"text":"没有啊","meaning":"Đâu có"},{"start":46.5,"end":48.45,"text":"靠肠胃运动来减肥？","meaning":"Dựa vào vận động đường ruột để giảm cân?"},{"start":48.79,"end":50.29,"text":"哪个专家 想出来的呀？","meaning":"Chuyên gia nào nghĩ ra vậy?"},{"start":50.67,"end":51.54,"text":"这主意不错","meaning":"Ý này hay đó"},{"start":51.5,"end":52.58,"text":"回头我也试试","meaning":"Lát tui cũng thử"},{"start":53.54,"end":55.2,"text":"你俩还真是天生一对","meaning":"Hai người đúng là trời sinh một cặp"},{"start":57.04,"end":57.91,"text":"诶……","meaning":"Hây......"},{"start":58,"end":58.5,"text":"快点做","meaning":"Làm lẹ lên"},{"start":58.58,"end":59.91,"text":"瘦不下来 别想追老娘","meaning":"Không ốm được thì đừng hòng cưa bà đây"},{"start":59.88,"end":61.2,"text":"你这也太凶了吧","meaning":"Cô dữ quá vậy"},{"start":61.17,"end":62.79,"text":"女孩子应该温柔一点哦","meaning":"Con gái phải dịu dàng một chút chứ"},{"start":62.75,"end":63.54,"text":"啊？","meaning":"Hả?"},{"start":63.5,"end":64.25,"text":"哦～","meaning":"Ồ~"},{"start":64.75,"end":66.08,"text":"你在这憋了半天","meaning":"Mày ở đây nín cả buổi"},{"start":66.04,"end":67.83,"text":"连个屁也没憋出来","meaning":"Mà một cái rắm cũng không nín ra nổi"},{"start":67.83,"end":69.54,"text":"你到底行不行啊？","meaning":"Rốt cuộc mày có được không vậy?"},{"start":77.42,"end":77.91,"text":"哎呀我做不了","meaning":"Ây da tui làm hổng nổi"},{"start":77.88,"end":79.12,"text":"我就说引体向上","meaning":"Tui nói rồi, hít xà đơn"},{"start":79.08,"end":80,"text":"能减肥吧","meaning":"Giảm cân được mà"},{"start":80.04,"end":81.91,"text":"他的屁 最起码也有10斤","meaning":"Cái rắm của ổng ít nhất cũng 10 ký"},{"start":85.75,"end":86.33,"text":"哎呀我做不了","meaning":"Ây da tui làm hổng nổi"},{"start":87.92,"end":88.62,"text":"加油嘛","meaning":"Cố lên mà"},{"start":88.75,"end":89.79,"text":"你想象一下","meaning":"Mày tưởng tượng thử"},{"start":89.75,"end":90.66,"text":"做完这个","meaning":"Tập xong cái này"},{"start":90.62,"end":91.54,"text":"明天你就可以","meaning":"Ngày mai mày có thể"},{"start":91.5,"end":92.58,"text":"和蛙蛙结婚了","meaning":"Cưới Ếch Ếch rồi"},{"start":92.54,"end":93.75,"text":"后天你和他的孩子","meaning":"Ngày kia con của mày với ổng"},{"start":93.75,"end":95.08,"text":"‘牛蛙’就出生了","meaning":"\"Ếch bò\" sẽ chào đời"},{"start":95.04,"end":95.58,"text":"唉","meaning":"Hầy"},{"start":96.46,"end":96.87,"text":"嗯","meaning":"Ừm"},{"start":96.83,"end":97.71,"text":"好嘞","meaning":"Dạ được"},{"start":100.58,"end":103.16,"text":"加油！","meaning":"Cố lên!"},{"start":105.29,"end":106.46,"text":"啊～","meaning":"A~"},{"start":106.42,"end":108.08,"text":"我的初吻啊","meaning":"Nụ hôn đầu của tui"},{"start":108.04,"end":109.46,"text":"呜呜呜","meaning":"Hu hu hu"},{"start":109.42,"end":110,"text":"我的……","meaning":"Của tui......"},{"start":110.29,"end":110.71,"text":"好了 别哭了","meaning":"Rồi rồi, đừng khóc nữa"},{"start":110.79,"end":111.71,"text":"我会负责的","meaning":"Tui sẽ chịu trách nhiệm"},{"start":112.21,"end":112.66,"text":"今天的事","meaning":"Chuyện hôm nay"},{"start":112.67,"end":113.54,"text":"谁也不许说出去","meaning":"Không ai được nói ra ngoài"},{"start":113.83,"end":114.66,"text":"听见没有","meaning":"Nghe rõ chưa"}]}