{"videoId":"CKTcKZoFJs0","title":"刮大风不要出来玩哦","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":62,"source":"ocr","order":74,"segments":[{"start":0.17,"end":1.37,"text":"哎呀","meaning":"Trời ơi!"},{"start":1.71,"end":5.04,"text":"快放我出去","meaning":"Mau thả tao ra!"},{"start":5,"end":5.91,"text":"不得了了了不得了","meaning":"Chết rồi chết rồi, không xong rồi!"},{"start":5.88,"end":6.58,"text":"快点放我出去","meaning":"Mau thả tao ra đi!"},{"start":6.54,"end":8.95,"text":"老大他什么情况啊","meaning":"Đại ca, ổng bị sao vậy?"},{"start":8.92,"end":10.5,"text":"新说唱？","meaning":"Rap kiểu mới hả?"},{"start":10.46,"end":11.54,"text":"他不会染上你的…","meaning":"Chắc ổng không bị lây của đại ca…"},{"start":11.5,"end":12.33,"text":"疯牛病了吧","meaning":"bệnh bò điên đấy chứ?"},{"start":12.29,"end":13.79,"text":"我哪有什么疯牛病啊","meaning":"Tao làm gì có bệnh bò điên!"},{"start":13.75,"end":15.83,"text":"快点啊","meaning":"Lẹ lên!"},{"start":16.54,"end":18.41,"text":"快抓住他别让他跑了","meaning":"Mau bắt nó lại, đừng để nó chạy!"},{"start":18.5,"end":19.29,"text":"啊","meaning":"Á!"},{"start":20.42,"end":23,"text":"哎呀不好了","meaning":"Ôi không xong rồi!"},{"start":22.96,"end":24.37,"text":"刮大风了呀","meaning":"Nổi gió lớn rồi!"},{"start":24.33,"end":26.29,"text":"大家快收衣服啊","meaning":"Mọi người mau thu quần áo đi!"},{"start":26.29,"end":27.12,"text":"啊","meaning":"Á!"},{"start":27.5,"end":30.91,"text":"家里有晒粮食","meaning":"Nhà nào phơi lương thực"},{"start":32.88,"end":34.33,"text":"还有晒裤衩的","meaning":"nhà nào phơi quần đùi"},{"start":34.29,"end":35.29,"text":"赶快收啊","meaning":"mau thu vô đi!"},{"start":35.25,"end":36.75,"text":"别被风吹走啦","meaning":"Đừng để gió thổi bay mất!"},{"start":36.83,"end":37.66,"text":"哎","meaning":"Ê."},{"start":37.62,"end":38.62,"text":"嗯还有啊","meaning":"Ừm, còn nữa nè."},{"start":38.58,"end":39.33,"text":"我跟你们说","meaning":"Tao nói tụi bây nghe"},{"start":39.29,"end":40.33,"text":"刮大风的时候","meaning":"lúc gió lớn"},{"start":40.29,"end":41.75,"text":"千万不要出来玩呀","meaning":"tuyệt đối đừng ra ngoài chơi nha."},{"start":41.71,"end":43.54,"text":"外面是很危险的啦","meaning":"Ngoài kia nguy hiểm lắm."},{"start":43.5,"end":44.12,"text":"万一有…","meaning":"Lỡ mà có…"},{"start":44.46,"end":45.33,"text":"啊","meaning":"Á!"},{"start":46.25,"end":47.91,"text":"你们看我说的没错吧","meaning":"Thấy chưa, tao nói đâu có sai."},{"start":47.88,"end":49.95,"text":"像刚刚那种小东西都还好了","meaning":"Mấy thứ nhỏ nhỏ như nãy thì còn đỡ,"},{"start":49.92,"end":51.79,"text":"万一飞过来是大物体的话","meaning":"lỡ bay tới cái vật to,"},{"start":51.75,"end":52.95,"text":"我们整个人都会…","meaning":"cả người tụi mình sẽ…"},{"start":53.92,"end":56.95,"text":"就不能等人家把话说完吗","meaning":"Không thể đợi người ta nói hết câu hả?"},{"start":56.92,"end":58.75,"text":"关注我下期更好玩哦","meaning":"Theo dõi tui nha, kỳ sau còn vui hơn!"}]}