{"videoId":"J_SUgMO8X98","title":"世纪难题：先救女友还是先救妈？","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":115,"source":"ocr","order":56,"segments":[{"start":0.29,"end":1.29,"text":"你娘和你女朋友","meaning":"Má mày với bạn gái mày"},{"start":1.25,"end":2.04,"text":"同时掉水里","meaning":"Cùng rớt xuống nước"},{"start":2,"end":2.96,"text":"你先救谁","meaning":"Mày cứu ai trước"},{"start":3.12,"end":4.16,"text":"我没娘","meaning":"Tui đâu có má"},{"start":4.62,"end":6.29,"text":"你娘呢？","meaning":"Má mày đâu?"},{"start":6.33,"end":8.33,"text":"被人拿去炖汤了","meaning":"Bị người ta bắt đi nấu canh rồi"},{"start":8.42,"end":9.41,"text":"你这么大方啊？","meaning":"Mày hào phóng dữ vậy?"},{"start":9.46,"end":10.45,"text":"你真大方","meaning":"Mày hào phóng thiệt"},{"start":10.58,"end":11.54,"text":"那你女朋友呢","meaning":"Vậy bạn gái mày đâu"},{"start":11.5,"end":12.37,"text":"她走了","meaning":"Cổ đi rồi"},{"start":12.5,"end":14.41,"text":"去哪了","meaning":"Đi đâu rồi"},{"start":14.54,"end":15.16,"text":"三年了","meaning":"Ba năm rồi"},{"start":15.17,"end":16.5,"text":"都没想过回来一次","meaning":"Chưa từng nghĩ tới chuyện về một lần"},{"start":17.33,"end":18.75,"text":"他被抛弃了吗","meaning":"Nó bị bỏ rơi rồi hả"},{"start":18.71,"end":20.54,"text":"不知道","meaning":"Không biết"},{"start":20.5,"end":21.7,"text":"啃的基","meaning":"Khẹc-đờ-gà"},{"start":22.83,"end":23.66,"text":"啃的基！！","meaning":"Khẹc-đờ-gà!!"},{"start":24.92,"end":26.2,"text":"那你女朋友和你妈","meaning":"Vậy bạn gái mày với má mày"},{"start":26.17,"end":27.04,"text":"同时掉水里","meaning":"Cùng rớt xuống nước"},{"start":27,"end":28.41,"text":"你先救谁啊","meaning":"Mày cứu ai trước"},{"start":28.38,"end":29.41,"text":"我不交女朋友的啊","meaning":"Tui đâu có quen bạn gái"},{"start":30.42,"end":32.25,"text":"那你妈和你爸同时掉水里","meaning":"Vậy má mày với ba mày cùng rớt xuống nước"},{"start":32.21,"end":33,"text":"你先救谁","meaning":"Mày cứu ai trước"},{"start":32.96,"end":34.54,"text":"我一个都不救啊","meaning":"Tui không cứu ai hết"},{"start":34.54,"end":35.12,"text":"为啥","meaning":"Sao vậy"},{"start":35.08,"end":36.33,"text":"因为他们会游泳啊","meaning":"Vì hai người họ biết bơi mà"},{"start":37.33,"end":38.2,"text":"我说假如~","meaning":"Tui nói là giả sử~"},{"start":38.17,"end":38.83,"text":"~他们不会游泳","meaning":"~họ không biết bơi"},{"start":38.79,"end":40,"text":"没有假如","meaning":"Làm gì có giả sử"},{"start":39.96,"end":41.33,"text":"我爸妈都是鸭子啊","meaning":"Ba mẹ tui đều là vịt mà"},{"start":41.29,"end":42.75,"text":"鸭子有不会游泳的吗","meaning":"Vịt mà có con không biết bơi hả"},{"start":42.71,"end":43.87,"text":"小傻鸡","meaning":"Gà con ngốc"},{"start":43.92,"end":44.95,"text":"小傻鸡！","meaning":"Gà con ngốc!"},{"start":45,"end":46.54,"text":"你呢","meaning":"Còn mày"},{"start":46.5,"end":47.7,"text":"我爸不是鸭子啊","meaning":"Ba tui đâu phải vịt"},{"start":49.29,"end":50.66,"text":"没问你爸是不是鸭子","meaning":"Ai hỏi ba mày có phải vịt không"},{"start":50.62,"end":51.45,"text":"我是问你","meaning":"Tao đang hỏi mày"},{"start":51.42,"end":56.04,"text":"先救女友还是先救妈","meaning":"Cứu bạn gái trước hay cứu má trước"},{"start":57.79,"end":58.58,"text":"那你女朋友","meaning":"Vậy bạn gái mày"},{"start":58.54,"end":59.33,"text":"可能会说","meaning":"Có thể sẽ nói"},{"start":59.62,"end":60.16,"text":"耶","meaning":"Yeah"},{"start":60.17,"end":61.54,"text":"你居然不先救我","meaning":"Mày lại không cứu tao trước"},{"start":61.5,"end":62.95,"text":"我就知道你不够爱我","meaning":"Biết ngay mày không đủ yêu tao"},{"start":63.12,"end":64.83,"text":"哎","meaning":"Haizz"},{"start":64.88,"end":66.04,"text":"你跟你妈过去吧","meaning":"Mày qua chỗ má mày đi"},{"start":66,"end":66.66,"text":"分手","meaning":"Chia tay"},{"start":66.79,"end":67.96,"text":"男人","meaning":"Đàn ông"},{"start":67.92,"end":69.79,"text":"哼！","meaning":"Hứ!"},{"start":69.75,"end":72.91,"text":"那那我先救女朋友吧","meaning":"Vậy vậy tui cứu bạn gái trước nhé"},{"start":72.88,"end":74.5,"text":"那你妈可能会说……","meaning":"Vậy má mày có thể sẽ nói……"},{"start":76.17,"end":76.83,"text":"哎","meaning":"Haizz"},{"start":76.83,"end":78.37,"text":"妈咪一把屎一把尿","meaning":"Mẹ lo từng cái cứt cái đái"},{"start":78.33,"end":80.25,"text":"把你养大","meaning":"Nuôi mày khôn lớn"},{"start":80.21,"end":81.46,"text":"我居然还不如你","meaning":"Vậy mà mẹ còn thua mày"},{"start":81.42,"end":82.71,"text":"外面的一个女人","meaning":"Một con nhỏ bên ngoài"},{"start":82.67,"end":84.21,"text":"真是养了个白眼狼","meaning":"Đúng là nuôi phải thằng vong ân bội nghĩa"},{"start":84.21,"end":85.08,"text":"早知道这样","meaning":"Biết vầy"},{"start":85.04,"end":86.62,"text":"当初还不如养条狗呢","meaning":"Hồi đó thà nuôi con chó còn hơn"},{"start":86.71,"end":88.41,"text":"浪费我这么多饲料","meaning":"Phí bao nhiêu là thức ăn của mẹ"},{"start":88.71,"end":89.62,"text":"气死我","meaning":"Tức chết mẹ rồi"},{"start":89.62,"end":90.71,"text":"啊","meaning":"Hả"},{"start":90.96,"end":92.41,"text":"是不是觉得怎么选都不对","meaning":"Có phải thấy chọn kiểu nào cũng sai không"},{"start":92.38,"end":93.62,"text":"嗯好难哦","meaning":"Ừm, khó quá trời"},{"start":93.75,"end":94.96,"text":"那你有什么感悟吗","meaning":"Vậy mày có cảm ngộ gì không"},{"start":94.92,"end":95.62,"text":"有","meaning":"Có"},{"start":95.58,"end":97,"text":"我发现女生会游泳","meaning":"Tui phát hiện con gái biết bơi"},{"start":96.96,"end":98.41,"text":"真的太重要了","meaning":"Thật sự quá quan trọng"},{"start":99.29,"end":100.54,"text":"那你妈咪和女朋友","meaning":"Vậy má mày với bạn gái mày"},{"start":100.5,"end":102.33,"text":"都会游泳吗？","meaning":"Đều biết bơi hết hả?"},{"start":102.29,"end":104.16,"text":"所以我才汗流浃背呢","meaning":"Nên tui mới đổ mồ hôi ròng ròng nè"},{"start":104.17,"end":104.83,"text":"那……","meaning":"Vậy……"},{"start":104.79,"end":105.71,"text":"游泳健身","meaning":"Bơi lội tập thể hình"},{"start":105.67,"end":108.62,"text":"要不要了解一下","meaning":"Có muốn tìm hiểu không"},{"start":108.88,"end":109.54,"text":"搞了半天","meaning":"Lòng vòng nãy giờ"},{"start":109.5,"end":110.87,"text":"你是在这里打广告","meaning":"Mày đang quảng cáo ở đây hả"},{"start":110.92,"end":111.87,"text":"我他们……","meaning":"Tui với bọn họ……"}]}