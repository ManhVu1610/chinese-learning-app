{"videoId":"AiS1B6S4Jjs","title":"你干嘛色瞇瞇的看着我？","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":84,"source":"ocr","order":15,"segments":[{"start":0.71,"end":1.54,"text":"啊","meaning":"Hả?"},{"start":1.5,"end":2.08,"text":"你干什么","meaning":"Ông làm cái gì vậy"},{"start":2.04,"end":3.21,"text":"瞪着眼睛看着我","meaning":"Trừng mắt nhìn tui chằm chằm"},{"start":3.29,"end":3.83,"text":"我......","meaning":"Tui..."},{"start":3.79,"end":4.87,"text":"你不要喜欢我","meaning":"Ông đừng có thích tui"},{"start":4.83,"end":6.37,"text":"虽然我平易近人","meaning":"Tuy tui dễ gần"},{"start":6.33,"end":7.54,"text":"貌美如花","meaning":"Lại đẹp như hoa"},{"start":7.54,"end":9.2,"text":"但是山猪哪能配凤凰呢","meaning":"Nhưng heo rừng sao xứng với phượng hoàng được"},{"start":9.42,"end":11.08,"text":"区区一个牛猫王","meaning":"Một con Ngưu Miêu Vương quèn"},{"start":12.54,"end":13.83,"text":"我怎么会看在眼里","meaning":"Tui đâu có để vô mắt"},{"start":13.83,"end":14.45,"text":"我想......","meaning":"Tui nghĩ..."},{"start":14.42,"end":15.16,"text":"想也不可以","meaning":"Nghĩ cũng không được"},{"start":15.12,"end":16.12,"text":"想也有罪","meaning":"Nghĩ cũng là có tội"},{"start":16.46,"end":18.54,"text":"你不要以为我不知道你在想什么","meaning":"Đừng tưởng tui không biết ông đang nghĩ gì"},{"start":18.5,"end":20.33,"text":"说！你到底在想什么","meaning":"Nói! Rốt cuộc ông đang nghĩ cái gì"},{"start":20.33,"end":21.54,"text":"他是想提醒你","meaning":"Ổng muốn nhắc cô đó"},{"start":21.5,"end":23.54,"text":"身上有虫子","meaning":"Trên người có sâu bọ"},{"start":23.5,"end":24.87,"text":"哪里有虫子啊","meaning":"Đâu có sâu bọ ở đâu hả?"},{"start":25.62,"end":27.37,"text":"啊","meaning":"Hả?"},{"start":27.88,"end":29.45,"text":"为什么不早告诉我有虫子啊","meaning":"Sao không nói sớm với tui là có sâu hả"},{"start":29.42,"end":31.12,"text":"我一直都在提醒你啊","meaning":"Tui nhắc cô nãy giờ mà"},{"start":31.08,"end":32.37,"text":"啊？是吗","meaning":"Hả? Vậy hả?"},{"start":32.54,"end":33.08,"text":"嗯","meaning":"Hửm?"},{"start":33.25,"end":34,"text":"你怎么知道","meaning":"Sao ông biết"},{"start":33.96,"end":35.29,"text":"美女都怕虫子啊","meaning":"Mỹ nữ nào cũng sợ sâu bọ mà"},{"start":35.46,"end":36.83,"text":"哦我知道了","meaning":"Ồ tui hiểu rồi"},{"start":36.88,"end":38.12,"text":"你想英雄救美","meaning":"Ông muốn anh hùng cứu mỹ nhân"},{"start":38.08,"end":39.54,"text":"让我对你产生好感","meaning":"Để tui có cảm tình với ông"},{"start":39.5,"end":41,"text":"然后你就有机会啦","meaning":"Rồi ông có cơ hội chứ gì"},{"start":41.17,"end":43.08,"text":"没有","meaning":"Không có đâu"},{"start":45.62,"end":46.41,"text":"啊","meaning":"Hả?"},{"start":48.08,"end":48.45,"text":"嗯？","meaning":"Hửm?"},{"start":49,"end":50.45,"text":"你干嘛色眯眯的看着他呀","meaning":"Cô nhìn ổng bằng ánh mắt dê xồm làm gì vậy"},{"start":50.58,"end":51.66,"text":"你不准喜欢他","meaning":"Cấm cô thích ổng"},{"start":51.62,"end":52.66,"text":"他已经名花有主","meaning":"Ổng đã có chủ rồi"},{"start":52.62,"end":53.58,"text":"跟我定过亲啦","meaning":"Đã đính hôn với tui rồi"},{"start":53.88,"end":55,"text":"就算你不在乎的话","meaning":"Dù cô không quan tâm đi nữa"},{"start":54.96,"end":56,"text":"他也是不会喜欢你的","meaning":"Ổng cũng không thích cô đâu"},{"start":55.96,"end":57.66,"text":"我没有色眯眯的看着他","meaning":"Tui đâu có nhìn ổng dê xồm"},{"start":57.83,"end":59.08,"text":"是他先看的我","meaning":"Là ổng nhìn tui trước"},{"start":59.33,"end":62.95,"text":"我不管是你色眯眯的看着他","meaning":"Tui mặc kệ, cô nhìn ổng dê xồm cũng không được"},{"start":62.92,"end":64.21,"text":"总之他是我的人","meaning":"Tóm lại ổng là người của tui"},{"start":64.17,"end":67.29,"text":"他只能色眯眯的看着我","meaning":"Ổng chỉ được nhìn tui bằng ánh mắt dê xồm thôi"},{"start":68,"end":68.54,"text":"叹气","meaning":"Thở dài"},{"start":69.83,"end":71.5,"text":"喂，你干嘛不看我了？","meaning":"Ê, sao ông không nhìn tui nữa?"},{"start":71.46,"end":73.62,"text":"我是怕蛙芙蓉你骂我","meaning":"Tui sợ Ếch Phù Dung cô mắng tui"},{"start":73.58,"end":74.46,"text":"你好端端的","meaning":"Đang yên đang lành"},{"start":74.42,"end":75.5,"text":"我干嘛骂你","meaning":"Tui mắng ông làm gì"},{"start":75.46,"end":76.16,"text":"你不看我","meaning":"Ông không nhìn tui"},{"start":76.12,"end":77.46,"text":"分明就是存心不良","meaning":"Rõ ràng là có ý đồ xấu"},{"start":77.42,"end":78.46,"text":"做贼心虚","meaning":"Có tật giật mình"},{"start":78.42,"end":79.87,"text":"你赶快转过来看着我","meaning":"Mau quay lại nhìn tui đi"},{"start":80.08,"end":80.54,"text":"快点","meaning":"Lẹ lên"},{"start":80.92,"end":82.33,"text":"【委屈】","meaning":"【Tủi thân】"},{"start":82.71,"end":83.25,"text":"哎","meaning":"Haiz"}]}