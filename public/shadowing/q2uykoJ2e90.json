{"videoId":"q2uykoJ2e90","title":"唐唠鸭：居然拿我…炖汤？！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":116,"source":"ocr","order":48,"segments":[{"start":1.5,"end":2.21,"text":"好香啊","meaning":"Thơm quá trời!"},{"start":2.25,"end":3.25,"text":"你在做什么汤","meaning":"Ông đang nấu canh gì vậy?"},{"start":3.21,"end":3.79,"text":"唐僧汤","meaning":"Canh Đường Tăng."},{"start":4.08,"end":4.66,"text":"啊","meaning":"Hả?"},{"start":5.29,"end":6.04,"text":"别那么急嘛","meaning":"Đừng gấp thế chứ."},{"start":6.25,"end":7.75,"text":"把我养胖了再吃呗","meaning":"Nuôi tui béo lên rồi hẵng ăn đi."},{"start":7.79,"end":9.2,"text":"粉丝说你嘴巴太欠","meaning":"Fan bảo cái miệng ông hư quá,"},{"start":9.17,"end":10.04,"text":"该打一顿","meaning":"đáng bị đánh một trận."},{"start":10.17,"end":11.37,"text":"打肿了就胖了","meaning":"Đánh sưng lên là béo liền chứ gì."},{"start":14.88,"end":15.41,"text":"唉","meaning":"Haizz."},{"start":22.5,"end":22.87,"text":"哎","meaning":"Ài."},{"start":22.83,"end":23.79,"text":"哼哼哼","meaning":"Hừ hừ hừ."},{"start":26.38,"end":27.16,"text":"咦","meaning":"Ủa?"},{"start":27.12,"end":28.33,"text":"怎么加这么多盐","meaning":"Sao bỏ nhiều muối thế này"},{"start":28.38,"end":29.7,"text":"还是这么淡呢","meaning":"mà vẫn nhạt thếch vậy ta?"},{"start":30.5,"end":31.33,"text":"你个笨牛","meaning":"Đồ bò ngốc!"},{"start":31.29,"end":32.33,"text":"你左手加盐","meaning":"Tay trái bỏ muối,"},{"start":32.29,"end":33.12,"text":"右手喝汤","meaning":"tay phải húp canh,"},{"start":33.08,"end":34.5,"text":"一万年也不会有味道","meaning":"một vạn năm cũng chẳng đậm đà nổi."},{"start":36,"end":37.2,"text":"那该怎么办啊","meaning":"Vậy phải làm sao?"},{"start":37.25,"end":38.29,"text":"你要右手加盐","meaning":"Ông phải tay phải bỏ muối,"},{"start":38.25,"end":39.16,"text":"左手喝汤","meaning":"tay trái húp canh."},{"start":39.17,"end":39.66,"text":"噗","meaning":"Phụt!"},{"start":39.96,"end":41.37,"text":"幸好是煮我","meaning":"May mà nấu tui,"},{"start":41.42,"end":42.54,"text":"如果是煮你俩","meaning":"chứ nấu hai người,"},{"start":42.67,"end":43.16,"text":"吃了","meaning":"ăn vào"},{"start":43.12,"end":44.08,"text":"肯定影响智商","meaning":"chắc chắn ảnh hưởng IQ."},{"start":45.96,"end":47,"text":"好香啊","meaning":"Thơm quá trời!"},{"start":47.08,"end":48.25,"text":"啊","meaning":"A!"},{"start":52.04,"end":53.58,"text":"救命啊","meaning":"Cứu mạng với!"},{"start":53.71,"end":54.12,"text":"等一下","meaning":"Khoan đã!"},{"start":54.08,"end":54.54,"text":"啊","meaning":"Hả?"},{"start":55,"end":56.2,"text":"温度刚刚好哎","meaning":"Nhiệt độ vừa vặn nè!"},{"start":56.58,"end":57.54,"text":"有沐浴露吗","meaning":"Có sữa tắm không?"},{"start":58.21,"end":58.79,"text":"哎","meaning":"Ài."},{"start":61,"end":61.58,"text":"哼","meaning":"Hừ."},{"start":62.5,"end":62.95,"text":"快点拖","meaning":"Lau lẹ lên!"},{"start":63.17,"end":64.12,"text":"万一我也掉到锅里","meaning":"Lỡ tui cũng rớt vô nồi"},{"start":64.38,"end":65.58,"text":"会变成落汤鸡的","meaning":"thì thành gà rớt nồi mất."},{"start":65.62,"end":66.16,"text":"刚好啊","meaning":"Vừa khéo luôn!"},{"start":66.38,"end":67,"text":"你掉锅里","meaning":"Ông rớt vô nồi"},{"start":67.25,"end":68.12,"text":"就不用放鸡精啦","meaning":"thì khỏi bỏ bột gà nữa."},{"start":68.5,"end":69.16,"text":"啊","meaning":"Hả?"},{"start":70.46,"end":72.33,"text":"我把拖布都快磨成光棍了","meaning":"Tui chà cây lau nhà gần trụi thành cây gậy trơ trọi rồi,"},{"start":72.29,"end":73.66,"text":"可还是越拖越脏","meaning":"vậy mà càng lau càng dơ."},{"start":74.04,"end":75.5,"text":"真的很困惑哎","meaning":"Thiệt là khó hiểu."},{"start":75.5,"end":76.29,"text":"越拖越脏","meaning":"Càng lau càng dơ"},{"start":76.42,"end":77.87,"text":"是因为你没洗拖布啦","meaning":"là do ông không giặt giẻ lau đó."},{"start":77.88,"end":79.41,"text":"一看就是没有做过家务的","meaning":"Nhìn là biết chưa từng làm việc nhà."},{"start":80.12,"end":81,"text":"在牛粪山","meaning":"Ở núi phân bò,"},{"start":80.96,"end":82.46,"text":"拖把必须边擦边洗","meaning":"cây lau phải vừa lau vừa giặt,"},{"start":82.54,"end":83.33,"text":"否则拖完地","meaning":"không thì lau xong"},{"start":83.29,"end":84.58,"text":"到处都是牛粪味","meaning":"khắp nơi toàn mùi phân bò."},{"start":84.54,"end":85.79,"text":"那怎么解决啊","meaning":"Vậy giải quyết sao?"},{"start":85.75,"end":86.37,"text":"炖汤","meaning":"Nấu canh"},{"start":86.38,"end":87.58,"text":"只有文火慢炖","meaning":"chỉ có hầm lửa nhỏ liu riu"},{"start":87.54,"end":88.75,"text":"才能越炖越香","meaning":"mới càng hầm càng thơm."},{"start":88.83,"end":89.41,"text":"擦地","meaning":"Lau nhà"},{"start":89.38,"end":90.79,"text":"只有拖布干净","meaning":"chỉ có giẻ lau sạch"},{"start":90.75,"end":91.96,"text":"才能越擦越亮","meaning":"mới càng lau càng sáng."},{"start":92.12,"end":92.79,"text":"哦","meaning":"Ồ."},{"start":92.75,"end":93.58,"text":"我终于明白","meaning":"Cuối cùng tui cũng hiểu"},{"start":93.54,"end":94.79,"text":"炖汤要加盐","meaning":"nấu canh phải bỏ muối,"},{"start":94.79,"end":96.87,"text":"拖地要洗拖布的奥秘了","meaning":"lau nhà phải giặt giẻ, cái bí mật đó rồi!"},{"start":96.83,"end":97.87,"text":"你们再聊一会","meaning":"Hai người mà tám thêm chút nữa,"},{"start":97.83,"end":99.08,"text":"我恐怕就要熟了","meaning":"chắc tui chín tới nơi."},{"start":99.04,"end":99.71,"text":"啊","meaning":"Hả?"},{"start":100.04,"end":100.54,"text":"哦","meaning":"Ồ."},{"start":100.54,"end":101.5,"text":"你熟了 我们就可以喝","meaning":"Ông chín rồi thì tụi này có thể húp"},{"start":101.5,"end":102.54,"text":"田七青蛙汤了","meaning":"canh ếch tam thất rồi."},{"start":102.67,"end":103.12,"text":"啊","meaning":"Hả?"},{"start":103.12,"end":103.75,"text":"哦不","meaning":"Ồ không,"},{"start":103.79,"end":104.62,"text":"我熟了","meaning":"tui chín rồi,"},{"start":104.67,"end":106.46,"text":"是羊汤","meaning":"là canh cừu."},{"start":106.5,"end":107,"text":"对啊","meaning":"Đúng đó!"},{"start":107.25,"end":108.16,"text":"只因我太美","meaning":"Chỉ vì tui quá đẹp,"},{"start":108.12,"end":109.62,"text":"小名叫杨贵妃","meaning":"biệt danh là Dương Quý Phi,"},{"start":109.92,"end":111.08,"text":"所以我是羊汤","meaning":"nên tui là canh cừu (Dương)!"},{"start":111.08,"end":113.79,"text":"杨贵妃？？","meaning":"Dương Quý Phi??"},{"start":114.21,"end":115.16,"text":"唉","meaning":"Haizz."}]}