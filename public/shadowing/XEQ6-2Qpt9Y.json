{"videoId":"XEQ6-2Qpt9Y","title":"这就是你说的~惊喜！！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":158,"source":"ocr","order":64,"segments":[{"start":0.33,"end":1.25,"text":"啊!","meaning":"Á!"},{"start":1.21,"end":2,"text":"刚刚是谁","meaning":"Vừa nãy là đứa nào"},{"start":1.96,"end":3.16,"text":"把我踹水里的","meaning":"Đạp tao xuống nước vậy"},{"start":3.33,"end":4.54,"text":"是他","meaning":"Là nó"},{"start":4.71,"end":5.37,"text":"是你","meaning":"Là mày"},{"start":6,"end":6.87,"text":"呃","meaning":"Ơ"},{"start":6.83,"end":8.08,"text":"等一下","meaning":"Khoan đã"},{"start":8.08,"end":8.91,"text":"这次比赛","meaning":"Cuộc thi lần này"},{"start":9.08,"end":9.83,"text":"你得第几","meaning":"Mày đứng hạng mấy"},{"start":10.58,"end":11.25,"text":"第一呀","meaning":"Nhất chứ sao"},{"start":11.29,"end":12.2,"text":"那不就得了","meaning":"Vậy thì còn gì nữa"},{"start":12.17,"end":12.58,"text":"我一脚","meaning":"Tao một cú đá"},{"start":12.54,"end":13.62,"text":"把你踢成了游泳冠军","meaning":"Đá mày thành quán quân bơi lội"},{"start":13.75,"end":14.75,"text":"你不感谢我","meaning":"Mày không cảm ơn tao hả"},{"start":14.96,"end":16.25,"text":"我感谢个屁啊","meaning":"Cảm ơn cái con khỉ"},{"start":16.21,"end":17.12,"text":"你把我踹进的","meaning":"Mày đạp tao xuống"},{"start":17.08,"end":19.29,"text":"又不是比赛的赛道","meaning":"Có phải đường đua đâu"},{"start":19.67,"end":21.16,"text":"还搞得我一身都是泥","meaning":"Còn làm tao lấm lem bùn đất"},{"start":21.21,"end":22.04,"text":"这就是传说中的","meaning":"Đây chính là cái gọi là"},{"start":22.21,"end":22.66,"text":"比鸡泥呀","meaning":"Bì kê nê (bikini) đó hả"},{"start":23.17,"end":24.08,"text":"还是泳装哎","meaning":"Mà còn là đồ bơi nữa chứ"},{"start":26.08,"end":27.04,"text":"我现在把你打成......","meaning":"Giờ tao đánh mày thành......"},{"start":28.17,"end":31.62,"text":"啊啊~","meaning":"A a~"},{"start":31.83,"end":32.5,"text":"啊","meaning":"Á"},{"start":32.54,"end":33.37,"text":"送给你!","meaning":"Tặng mày nè!"},{"start":33.71,"end":34.08,"text":"??","meaning":"??"},{"start":35.25,"end":35.91,"text":"死鬼!","meaning":"Đồ quỷ!"},{"start":35.88,"end":36.58,"text":"净搞这些","meaning":"Toàn bày mấy trò"},{"start":36.54,"end":37.5,"text":"花里胡哨的","meaning":"Màu mè hoa lá"},{"start":37.67,"end":39,"text":"啊","meaning":"Hả"},{"start":38.96,"end":40,"text":"老大 我好好奇","meaning":"Đại ca, tui tò mò quá"},{"start":39.96,"end":41.45,"text":"你是怎么游到终点的呀","meaning":"Ông bơi tới đích kiểu gì vậy"},{"start":41.67,"end":42.83,"text":"我哪会游啊","meaning":"Tao biết bơi đâu"},{"start":42.79,"end":43.95,"text":"我是直接飞过去的","meaning":"Tao bay thẳng qua luôn"},{"start":44.08,"end":44.91,"text":"飞过去的","meaning":"Bay qua luôn á"},{"start":45.29,"end":46.54,"text":"怎么? 鸡不能飞吗","meaning":"Sao? Gà không được bay hả"},{"start":46.58,"end":48.16,"text":"不是","meaning":"Đâu phải"},{"start":48.12,"end":50.29,"text":"参加一场游泳比赛","meaning":"Tham gia cuộc thi bơi"},{"start":50.46,"end":52.16,"text":"靠飞~ 到的终点","meaning":"Mà dựa vào bay~ tới đích"},{"start":52.21,"end":54.66,"text":"居然 还拿了冠军","meaning":"Vậy mà còn đoạt quán quân"},{"start":54.92,"end":55.95,"text":"比赛有问题吗","meaning":"Cuộc thi có vấn đề gì hả"},{"start":55.92,"end":56.79,"text":"有什么问题","meaning":"Có vấn đề gì đâu"},{"start":56.96,"end":58.5,"text":"比的就是自由泳啊","meaning":"Thi bơi tự do mà"},{"start":58.46,"end":59.54,"text":"又不限制动作","meaning":"Có giới hạn động tác đâu"},{"start":59.75,"end":60.37,"text":"啊 ?","meaning":"Hả?"},{"start":60.5,"end":61.45,"text":"我们先看看你的","meaning":"Mình xem trước phần thưởng"},{"start":61.42,"end":62.79,"text":"奖品是什么吧","meaning":"Của ông là gì đã"},{"start":63.29,"end":63.95,"text":"啊","meaning":"Á"},{"start":63.92,"end":64.37,"text":"狂飙鸡","meaning":"Gà Cuồng Phong"},{"start":64.33,"end":65.83,"text":"你给我出来","meaning":"Mày ra đây cho tao"},{"start":66.29,"end":66.96,"text":"我今天居然","meaning":"Hôm nay tao lại"},{"start":66.92,"end":67.75,"text":"在自己的强项","meaning":"Ở sở trường của mình"},{"start":67.71,"end":68.46,"text":"游泳上","meaning":"Là bơi lội"},{"start":68.46,"end":71.04,"text":"输给了你一只鸡","meaning":"Thua một con gà như mày"},{"start":71,"end":72.12,"text":"啊不","meaning":"Ôi không"},{"start":72.08,"end":72.62,"text":"怎么混啊","meaning":"Sống sao nổi đây"},{"start":72.92,"end":76.08,"text":"妈艺届??","meaning":"Giới nghệ sĩ này??"},{"start":76.33,"end":77.16,"text":"啊","meaning":"Hả"},{"start":77.33,"end":77.91,"text":"一大早","meaning":"Sáng sớm tinh mơ"},{"start":77.88,"end":79.29,"text":"我化了美美的妆","meaning":"Tao trang điểm xinh đẹp"},{"start":79.25,"end":80.87,"text":"信心满满的来比赛","meaning":"Tự tin đầy mình đi thi"},{"start":80.83,"end":81.5,"text":"没想到","meaning":"Ai ngờ"},{"start":81.62,"end":83.87,"text":"冠军被抢走了","meaning":"Quán quân bị cướp mất"},{"start":83.83,"end":85.58,"text":"连一起来看比赛的男朋友","meaning":"Đến cả bạn trai đi xem thi cùng"},{"start":85.54,"end":86.71,"text":"也被那个","meaning":"Cũng bị cái con"},{"start":86.67,"end":88.37,"text":"天鹅大妈给勾走了","meaning":"Bà Thiên Nga đó câu mất rồi"},{"start":88.33,"end":89,"text":"是你","meaning":"Là mày"},{"start":89.04,"end":89.41,"text":"啊!","meaning":"Á!"},{"start":89.42,"end":90.75,"text":"让我从万众瞩目","meaning":"Khiến tao từ muôn người chú ý"},{"start":90.71,"end":92.25,"text":"一下变得一无所有","meaning":"Bỗng chốc trắng tay"},{"start":92.21,"end":95.5,"text":"你还我冠军!","meaning":"Trả quán quân cho tao!"},{"start":98.5,"end":98.91,"text":"好了","meaning":"Được rồi"},{"start":98.88,"end":99.96,"text":"冠军还你啦","meaning":"Trả quán quân cho nè"},{"start":100.08,"end":101.33,"text":"别哭了妆都花了","meaning":"Đừng khóc nữa, lem hết phấn rồi"},{"start":101.46,"end":103,"text":"赶紧补补妆吧","meaning":"Mau dặm lại phấn đi"},{"start":102.96,"end":105.08,"text":"补什么妆啊","meaning":"Dặm cái gì chứ"},{"start":105.04,"end":106.96,"text":"肯定卡粉","meaning":"Chắc chắn bị vón phấn"},{"start":106.92,"end":107.83,"text":"那你该试试","meaning":"Vậy mày nên thử"},{"start":108.08,"end":111.12,"text":"粉饼啊","meaning":"Phấn nén đi"},{"start":111.21,"end":112.21,"text":"人家现在这么伤心","meaning":"Người ta đang đau lòng thế này"},{"start":112.29,"end":113.29,"text":"你还想着打广告","meaning":"Mà mày còn lo quảng cáo"},{"start":113.25,"end":116.12,"text":"你是不是人啊","meaning":"Mày có phải con người không vậy"},{"start":116.12,"end":117.04,"text":"啊","meaning":"Hả"},{"start":117,"end":118.79,"text":"我们大家都一样的","meaning":"Tụi mình ai cũng như nhau"},{"start":118.83,"end":119.91,"text":"全是畜生!","meaning":"Toàn là súc sinh!"},{"start":119.92,"end":120.54,"text":"说的好","meaning":"Nói hay lắm"},{"start":125.25,"end":126.87,"text":"一点都没卡粉哎","meaning":"Không vón phấn tí nào luôn"},{"start":126.88,"end":129.54,"text":"你又变好看了耶","meaning":"Mày lại đẹp ra nữa rồi"},{"start":129.5,"end":130.66,"text":"我那个负心男友","meaning":"Cái thằng bạn trai bạc tình của tao"},{"start":130.62,"end":132.12,"text":"被天鹅大妈给拐走了","meaning":"Bị bà Thiên Nga dụ đi rồi"},{"start":132.08,"end":133.91,"text":"他回来肯定要跟我分开","meaning":"Nó về chắc chắn đòi chia tay tao"},{"start":133.88,"end":134.95,"text":"分开就分开","meaning":"Chia thì chia"},{"start":134.92,"end":136.08,"text":"下一个更乖","meaning":"Thằng tiếp theo ngoan hơn"},{"start":136.08,"end":136.87,"text":"怕啥子","meaning":"Sợ gì chứ"},{"start":138.75,"end":139.2,"text":"来","meaning":"Nào"},{"start":139.25,"end":140.66,"text":"我给你变个魔术吧","meaning":"Tao biến cho mày một màn ảo thuật nhé"},{"start":140.62,"end":141.41,"text":"你吹一下","meaning":"Mày thổi một cái"},{"start":141.38,"end":144.12,"text":"就会有惊喜哦","meaning":"Sẽ có bất ngờ đó nha"},{"start":144.58,"end":145.41,"text":"嗯嗯","meaning":"Ừ ừ"},{"start":151.58,"end":152.37,"text":"啊","meaning":"Á"}]}