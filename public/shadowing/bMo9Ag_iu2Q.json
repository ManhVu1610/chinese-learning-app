{"videoId":"bMo9Ag_iu2Q","title":"搞笑救援：我今天必须死是吗？","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":177,"source":"ocr","order":8,"segments":[{"start":0.08,"end":3.58,"text":"大王叫我来巡山哎","meaning":"Đại vương bảo tui đi tuần núi nè~"},{"start":3.54,"end":5,"text":"老大去哪了啊","meaning":"Đại ca đi đâu rồi ta?"},{"start":4.96,"end":7.25,"text":"是哪个傻啵在这里挖的坑","meaning":"Thằng ngố nào đào cái hố ở đây vậy?"},{"start":8.33,"end":9.95,"text":"那个傻啵就是你","meaning":"Thằng ngố đó chính là ông đó."},{"start":9.92,"end":12.37,"text":"这里是你为了抓唐僧挖的陷阱","meaning":"Đây là cái bẫy ông tự đào để bắt Đường Tăng mà."},{"start":12.62,"end":13.08,"text":"啊？","meaning":"Hả?"},{"start":13.25,"end":15.29,"text":"那我岂不是要被困在这里","meaning":"Vậy chẳng phải tui bị kẹt ở đây luôn sao?"},{"start":15.71,"end":16.54,"text":"你放心","meaning":"Đại ca yên tâm."},{"start":16.5,"end":19.37,"text":"我会想办法救你的","meaning":"Tui sẽ nghĩ cách cứu ông."},{"start":19.33,"end":20.54,"text":"在这傻笑什么呢","meaning":"Cười ngu cái gì ở đó vậy?"},{"start":20.5,"end":21.62,"text":"我想到办法了","meaning":"Tui nghĩ ra cách rồi."},{"start":21.71,"end":23.16,"text":"用这个","meaning":"Dùng cái này nè."},{"start":26.21,"end":26.91,"text":"耶？","meaning":"Ê?"},{"start":26.88,"end":28.25,"text":"什么情况","meaning":"Chuyện gì vậy trời?"},{"start":28.21,"end":29.41,"text":"你们在干什么啊","meaning":"Hai người đang làm gì vậy?"},{"start":29.5,"end":30.5,"text":"老大","meaning":"Đại ca."},{"start":30.46,"end":32.33,"text":"我在利用水的浮力来救你","meaning":"Tui đang dùng lực đẩy của nước để cứu ông."},{"start":32.29,"end":33.66,"text":"一会等水灌满了","meaning":"Lát nữa nước đầy rồi,"},{"start":33.62,"end":34.83,"text":"你就浮起来了","meaning":"ông sẽ nổi lên thôi."},{"start":34.79,"end":35.75,"text":"这是“科学”","meaning":"Đây là \"khoa học\" đó."},{"start":35.79,"end":36.54,"text":"啊？","meaning":"Hả?"},{"start":36.71,"end":37.75,"text":"一会水灌满了","meaning":"Lát nước đầy rồi,"},{"start":37.71,"end":38.91,"text":"他就淹死了吧","meaning":"ổng chết đuối luôn quá."},{"start":40.67,"end":42.79,"text":"哎呀 不好了啊","meaning":"Ối trời, không xong rồi!"},{"start":42.75,"end":43.45,"text":"老大","meaning":"Đại ca!"},{"start":43.42,"end":44.95,"text":"这水是用来救你的","meaning":"Nước này để cứu ông đó."},{"start":44.92,"end":46.66,"text":"你别喝这个水啊","meaning":"Ông đừng có uống nước này!"},{"start":47.62,"end":49,"text":"你怎么还在喝啊","meaning":"Sao ông còn uống nữa vậy?"},{"start":48.96,"end":50.29,"text":"你是不是渴了啊","meaning":"Ông khát hả?"},{"start":57.79,"end":59.62,"text":"老大 你没事吧","meaning":"Đại ca, ông không sao chứ?"},{"start":59.58,"end":61.16,"text":"我还没逝","meaning":"Tui chưa tèo đâu."},{"start":61.17,"end":62.12,"text":"没事就好","meaning":"Không sao là tốt rồi."},{"start":62.08,"end":64.12,"text":"我再想点别的办法来救你","meaning":"Để tui nghĩ cách khác cứu ông."},{"start":64.08,"end":65.91,"text":"我谢谢你","meaning":"Tui cảm ơn ông nha."},{"start":67.04,"end":67.66,"text":"牛猫王","meaning":"Ngưu Miêu Vương"},{"start":67.62,"end":69,"text":"我找到一根绳子","meaning":"Tui tìm được sợi dây thừng nè."},{"start":68.96,"end":70.46,"text":"咦太好了","meaning":"Ồ, tuyệt quá!"},{"start":70.67,"end":72.12,"text":"我把绳子套他身上","meaning":"Tui quấn dây vô người ổng."},{"start":72.08,"end":73.62,"text":"你把他拉上来","meaning":"Ông kéo ổng lên nhé."},{"start":76.96,"end":78.33,"text":"套好了，拉","meaning":"Quấn xong rồi, kéo đi!"},{"start":78.29,"end":78.91,"text":"OK","meaning":"OK!"},{"start":80.67,"end":81.25,"text":"怎么回事儿","meaning":"Sao vậy trời?"},{"start":81.42,"end":82.21,"text":"再加把劲儿","meaning":"Cố thêm chút nữa!"},{"start":82.29,"end":83.25,"text":"哦","meaning":"Ò."},{"start":85.25,"end":86.08,"text":"他上来了吗","meaning":"Ổng lên chưa?"},{"start":86.08,"end":86.62,"text":"没有","meaning":"Chưa."},{"start":86.75,"end":88.33,"text":"他好像有点死了","meaning":"Hình như ổng hơi bị tèo rồi."},{"start":88.46,"end":88.87,"text":"啊？","meaning":"Hả?"},{"start":89.04,"end":91.33,"text":"你把绳子系树上，过来看看呗","meaning":"Ông buộc dây vô cây rồi qua đây coi thử đi."},{"start":91.67,"end":92.62,"text":"啊我看看","meaning":"Ờ, để tui coi."},{"start":93.71,"end":94.12,"text":"啊！","meaning":"Á!"},{"start":97.17,"end":100.16,"text":"我好辛苦啊","meaning":"Tui khổ quá mà!"},{"start":104.21,"end":104.62,"text":"啊！救命啊","meaning":"Á! Cứu mạng!"},{"start":108.75,"end":110.75,"text":"老大你死了吗","meaning":"Đại ca, ông chết chưa?"},{"start":110.71,"end":111.66,"text":"还没～","meaning":"Chưa~"},{"start":111.75,"end":112.75,"text":"没死就好","meaning":"Chưa chết là tốt rồi."},{"start":112.71,"end":114.71,"text":"我在想点别的办法救你","meaning":"Tui đang nghĩ cách khác để cứu ông."},{"start":114.67,"end":115.54,"text":"别救了！！","meaning":"Đừng cứu nữa!!"},{"start":115.54,"end":116.58,"text":"你不救我","meaning":"Ông mà không cứu tui,"},{"start":116.54,"end":119.12,"text":"我可能活的概率还大些","meaning":"có khi tui còn sống sót cao hơn."},{"start":119.08,"end":120.71,"text":"你快休息一会吧","meaning":"Ông nghỉ một lát đi."},{"start":120.88,"end":121.5,"text":"啊","meaning":"Hả."},{"start":121.75,"end":122.91,"text":"你快想个办法","meaning":"Mau nghĩ cách đi!"},{"start":123.46,"end":123.83,"text":"这样","meaning":"Vậy nè."},{"start":123.79,"end":125.87,"text":"我们在旁边斜着挖一个地道","meaning":"Mình đào một đường hầm xiên xiên bên cạnh,"},{"start":125.83,"end":126.96,"text":"直通井底","meaning":"thông thẳng xuống đáy giếng."},{"start":126.92,"end":130.54,"text":"这样 他就可以轻轻松松自己走出来了","meaning":"Vậy là ổng nhẹ nhàng tự đi ra được luôn."},{"start":130.58,"end":131.79,"text":"这个办法好哎","meaning":"Cách này hay đó!"},{"start":131.75,"end":132.79,"text":"不仅能救人","meaning":"Không những cứu được người,"},{"start":132.75,"end":133.95,"text":"说不定还能挖到","meaning":"biết đâu còn đào trúng"},{"start":133.92,"end":135.16,"text":"牛粪山的宝藏呢","meaning":"kho báu của núi Phân Trâu nữa á?"},{"start":135.12,"end":135.79,"text":"是吗？","meaning":"Thiệt hả?"},{"start":135.75,"end":136.66,"text":"那你快挖","meaning":"Vậy ông mau đào đi."},{"start":136.62,"end":138.29,"text":"我再去找个铁锹来帮忙","meaning":"Tui đi kiếm cái xẻng phụ một tay."},{"start":139.04,"end":141.29,"text":"在小小的树林 挖呀挖呀挖","meaning":"Trong khu rừng nhỏ xíu, đào nha đào nha đào~"},{"start":141.25,"end":144.83,"text":"挖我大大的宝藏 送给我妈","meaning":"Đào kho báu bự của tui, tặng cho mẹ tui~"},{"start":145.96,"end":147,"text":"哇","meaning":"Oa!"},{"start":147,"end":148.08,"text":"你挖的好快啊","meaning":"Ông đào nhanh dữ vậy!"},{"start":148.04,"end":149.58,"text":"嗯超好挖的","meaning":"Ừ, đào dễ ợt."},{"start":149.83,"end":151.2,"text":"但你挖这么大干嘛","meaning":"Mà ông đào to vậy làm gì?"},{"start":151.17,"end":154.37,"text":"大一点","meaning":"Đào to chút"},{"start":154.54,"end":156.79,"text":"拜托 现在是救人啊","meaning":"Làm ơn đi, giờ là đang cứu người đó!"},{"start":156.75,"end":157.87,"text":"先把人救出来","meaning":"Cứu người ra trước đã,"},{"start":157.83,"end":159.5,"text":"再想你的宝藏行不行","meaning":"rồi hẵng tính chuyện kho báu của ông được không?"},{"start":159.46,"end":160.41,"text":"我搞错重点了","meaning":"Tui nhầm trọng tâm rồi."},{"start":160.38,"end":161.16,"text":"不好意思","meaning":"Xin lỗi nha."},{"start":161.12,"end":162.04,"text":"嘿嘿","meaning":"Hê hê."},{"start":164.42,"end":165.25,"text":"老大呢？","meaning":"Đại ca đâu rồi?"},{"start":165.21,"end":166.25,"text":"还在井里呢","meaning":"Còn ở dưới giếng đó."},{"start":166.38,"end":168.16,"text":"那 那井去哪了","meaning":"Ơ, mà cái giếng đâu rồi?"},{"start":168.17,"end":170.12,"text":"哎 不就在这","meaning":"Ê, chẳng phải nó ở ngay đây sao?"},{"start":171.42,"end":172.25,"text":"啊？","meaning":"Hả?"},{"start":172.92,"end":173.54,"text":"啊！","meaning":"Á!"},{"start":174.08,"end":176.7,"text":"老大你走的好早啊","meaning":"Đại ca, ông đi sớm quá trời!"}]}