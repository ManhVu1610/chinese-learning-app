{"videoId":"xrtSZ8GeEMA","title":"鸡和蛙的孩子该叫啥？！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":62,"source":"ocr","order":19,"segments":[{"start":0.12,"end":1.25,"text":"鸡和蛙的孩子","meaning":"Con của gà với ếch"},{"start":1.21,"end":2.87,"text":"应该叫什么名字啊？","meaning":"Nên đặt tên là gì ta?"},{"start":2.88,"end":4.54,"text":"谁说我要和你生孩子啊","meaning":"Ai nói tui muốn đẻ con với ông hả"},{"start":4.5,"end":5,"text":"这个嘛","meaning":"Cái này hả"},{"start":4.96,"end":6.66,"text":"那要看孩子长得像谁了","meaning":"Phải xem con giống ai đã"},{"start":6.62,"end":7.91,"text":"如果长得像他呢","meaning":"Nếu giống ổng"},{"start":8.29,"end":9.5,"text":"那就叫黄焖鸡","meaning":"Thì gọi là Gà hầm Hoàng Muộn"},{"start":9.46,"end":9.91,"text":"啊？","meaning":"Hả?"},{"start":10.21,"end":11.04,"text":"诶","meaning":"Ê"},{"start":11.42,"end":12.37,"text":"黄萌鸡？","meaning":"Gà Hoàng Manh á?"},{"start":12.75,"end":13.7,"text":"哇","meaning":"Wow"},{"start":13.67,"end":14.79,"text":"一听就好可爱哦","meaning":"Nghe là thấy dễ thương liền"},{"start":14.79,"end":16.04,"text":"你好有才华哦","meaning":"Anh giỏi quá đi"},{"start":17.67,"end":19.66,"text":"那如果长得像我呢？","meaning":"Còn nếu giống tui thì sao?"},{"start":19.92,"end":21.58,"text":"那就叫蒜香美蛙","meaning":"Thì gọi là Ếch Mỹ Tỏi Thơm"},{"start":21.79,"end":23.62,"text":"书案香·美蛙","meaning":"Thư Án Hương, Mỹ Ếch"},{"start":23.88,"end":24.5,"text":"哇","meaning":"Wow"},{"start":24.46,"end":25.91,"text":"好有文化的名字啊","meaning":"Cái tên có văn hóa ghê"},{"start":25.88,"end":28.62,"text":"一听就很美","meaning":"Nghe là thấy đẹp rồi"},{"start":31.54,"end":33.25,"text":"那万一又像鸡又像蛙","meaning":"Lỡ vừa giống gà vừa giống ếch"},{"start":33.21,"end":34,"text":"怎么办啊","meaning":"Thì làm sao"},{"start":33.96,"end":35.25,"text":"那就叫蛙绝鸡呗","meaning":"Thì gọi là Oa Tuyệt Kê chứ sao"},{"start":35.21,"end":36.16,"text":"蛙撅鸡？","meaning":"Oa Quệt Kê?"},{"start":36.12,"end":37.33,"text":"爵士的爵吗","meaning":"Chữ tước trong tước sĩ hả"},{"start":37.29,"end":38.08,"text":"咀嚼的嚼","meaning":"Chữ nhai trong nhai nuốt"},{"start":39.25,"end":41,"text":"哎呀 不要瞎说","meaning":"Ôi trời, đừng nói bậy"},{"start":41,"end":42.12,"text":"我们两个在一起","meaning":"Hai đứa mình ở bên nhau"},{"start":42.08,"end":44,"text":"爱情一定很甜美","meaning":"Tình yêu chắc chắn ngọt ngào lắm"},{"start":43.96,"end":45.54,"text":"哼 爱情我不知道","meaning":"Hứ, tình yêu thì tui không biết"},{"start":45.5,"end":46.62,"text":"但我们两个在一起","meaning":"Nhưng hai đứa mình ở bên nhau"},{"start":46.58,"end":47.95,"text":"味道一定很鲜美","meaning":"Mùi vị chắc chắn rất tươi ngon"},{"start":49.54,"end":51.29,"text":"哎呀 不要瞎说","meaning":"Ôi trời, đừng nói bậy"},{"start":51.29,"end":52.54,"text":"我们两个在一起","meaning":"Hai đứa mình ở bên nhau"},{"start":52.5,"end":53.45,"text":"一定会是一场","meaning":"Chắc chắn sẽ là một"},{"start":53.46,"end":54.62,"text":"甜蜜恋爱","meaning":"Cuộc tình ngọt ngào"},{"start":54.58,"end":56.2,"text":"哼 我们两个在一起","meaning":"Hứ, hai đứa mình ở bên nhau"},{"start":56.17,"end":57,"text":"只会诞生...","meaning":"Chỉ sinh ra..."},{"start":56.96,"end":58.16,"text":"一道新菜","meaning":"Một món ăn mới"},{"start":58.58,"end":59.58,"text":"嗯 对对对","meaning":"Ừ, đúng đúng đúng"},{"start":60.5,"end":61.16,"text":"什么菜？","meaning":"Món gì vậy?"}]}