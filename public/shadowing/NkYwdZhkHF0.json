{"videoId":"NkYwdZhkHF0","title":"又要涨工资？！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":142,"source":"ocr","order":3,"segments":[{"start":0.25,"end":1.87,"text":"为什么还不给我涨工资","meaning":"Sao mãi chưa tăng lương cho tui vậy?"},{"start":3,"end":4.96,"text":"你连智商考核都通不过","meaning":"Tới bài kiểm tra IQ mà ông còn rớt nữa."},{"start":4.92,"end":5.79,"text":"涨什么工资","meaning":"Tăng lương gì? Nằm mơ đi."},{"start":6,"end":7.83,"text":"我……","meaning":"Tui..."},{"start":8.17,"end":9.41,"text":"明明是你的题太难了","meaning":"Rõ ràng là đề của ông khó quá mà."},{"start":9.38,"end":10.08,"text":"好不好？","meaning":"Được không hả?"},{"start":10.21,"end":11.45,"text":"我的题太难？","meaning":"Đề của tui mà khó á?"},{"start":12.38,"end":12.91,"text":"好","meaning":"Được."},{"start":13.42,"end":14.87,"text":"那我再给你个机会","meaning":"Vậy tao cho mày thêm cơ hội nữa."},{"start":15,"end":16,"text":"这次我给你出个","meaning":"Lần này tao ra cho mày"},{"start":15.96,"end":17.16,"text":"猪都能回答的问题","meaning":"một câu hỏi heo cũng trả lời được."},{"start":17.12,"end":18.04,"text":"你能答上","meaning":"Mày mà trả lời đúng,"},{"start":18,"end":19.75,"text":"我就给你涨……","meaning":"tao tăng lương cho mày..."},{"start":19.71,"end":20.45,"text":"两倍","meaning":"gấp đôi luôn!"},{"start":21.88,"end":22.7,"text":"好","meaning":"Chốt!"},{"start":23.96,"end":25.25,"text":"我在这张纸的背面","meaning":"Mặt sau tờ giấy này"},{"start":25.21,"end":26.08,"text":"写了三个字","meaning":"tao viết ba chữ."},{"start":26.04,"end":26.83,"text":"你说","meaning":"Mày đoán thử xem"},{"start":26.79,"end":27.91,"text":"是哪三个字","meaning":"là ba chữ nào."},{"start":28.58,"end":29.37,"text":"蛋炒饭","meaning":"Cơm chiên trứng?"},{"start":29.38,"end":29.95,"text":"不对","meaning":"Sai."},{"start":30.5,"end":31.25,"text":"鸡公煲","meaning":"Gà nồi?"},{"start":31.29,"end":31.83,"text":"不对","meaning":"Lại sai."},{"start":32.42,"end":33.29,"text":"老鸭汤？","meaning":"Canh vịt già?"},{"start":33.29,"end":34.66,"text":"你就只知道吃吗","meaning":"Mày chỉ biết ăn thôi hả?"},{"start":34.62,"end":36.54,"text":"都跟你说了是三个字的嘛","meaning":"Đã nói là ba chữ rồi mà!"},{"start":36.83,"end":37.45,"text":"呃","meaning":"Ờ..."},{"start":37.42,"end":38.79,"text":"我猜不出来","meaning":"Tui đoán hổng ra."},{"start":39.33,"end":39.79,"text":"哎","meaning":"Haizz."},{"start":43.04,"end":43.87,"text":"啊","meaning":"Hả?"},{"start":44.83,"end":46.54,"text":"这么简单你都猜不出来啊","meaning":"Dễ vậy mà mày cũng đoán không ra hả?"},{"start":46.62,"end":47.2,"text":"笨","meaning":"Ngu ghê."},{"start":47.33,"end":48.2,"text":"啊","meaning":"Hả?"},{"start":48.33,"end":49.87,"text":"难道我真的……","meaning":"Chẳng lẽ tui thiệt là..."},{"start":49.83,"end":50.75,"text":"比猪还笨？","meaning":"ngu hơn cả heo?"},{"start":51.17,"end":51.83,"text":"可不是吗","meaning":"Chứ còn gì nữa."},{"start":51.83,"end":53.33,"text":"你还去洗洗脑吧","meaning":"Đi rửa não lại đi nha."},{"start":53.38,"end":54.25,"text":"哦","meaning":"Ồ."},{"start":56.75,"end":58.08,"text":"我是最棒的","meaning":"Tui là nhất!"},{"start":58.04,"end":59.33,"text":"我有高智商","meaning":"Tui có IQ cao!"},{"start":59.33,"end":60.62,"text":"我是最棒的","meaning":"Tui là nhất!"},{"start":61.04,"end":62.33,"text":"我有高智商","meaning":"Tui có IQ cao!"},{"start":63.04,"end":63.87,"text":"再来","meaning":"Làm lại lần nữa!"},{"start":64.42,"end":66.54,"text":"你这就准备好了","meaning":"Mày sẵn sàng rồi hả?"},{"start":66.54,"end":67.21,"text":"准备好了","meaning":"Sẵn sàng!"},{"start":67.17,"end":68,"text":"再来","meaning":"Tới đi!"},{"start":72.25,"end":74.5,"text":"我在这张纸的背面写了三个字","meaning":"Mặt sau tờ giấy này tao viết ba chữ."},{"start":74.46,"end":76.25,"text":"是哪三个字","meaning":"Là ba chữ nào?"},{"start":76.33,"end":76.91,"text":"不对","meaning":"Sai."},{"start":76.88,"end":77.71,"text":"啊","meaning":"Hả?"},{"start":77.83,"end":79.5,"text":"你不是说三个字的吗","meaning":"Ông nói ba chữ mà?"},{"start":79.46,"end":80.08,"text":"对啊","meaning":"Ờ đúng rồi."},{"start":80.04,"end":81.83,"text":"哪三个字嘛？","meaning":"Vậy ba chữ nào?"},{"start":81.83,"end":82.58,"text":"不对","meaning":"Sai."},{"start":82.54,"end":83.12,"text":"啊","meaning":"Hả?"},{"start":83.08,"end":83.91,"text":"等一下","meaning":"Khoan đã."},{"start":83.92,"end":85.54,"text":"你是不是把题给改了呀","meaning":"Có phải ông đổi đề rồi không?"},{"start":86.04,"end":87.33,"text":"我给他增加点难度","meaning":"Tao tăng độ khó cho nó xíu."},{"start":87.29,"end":88.66,"text":"这次写了四个字","meaning":"Lần này tao viết bốn chữ."},{"start":88.75,"end":90.62,"text":"啊","meaning":"Hả?"},{"start":90.88,"end":91.75,"text":"说好三个字","meaning":"Đã nói ba chữ mà!"},{"start":91.71,"end":93.04,"text":"怎么写四个字啊","meaning":"Sao lại viết bốn chữ?"},{"start":93.08,"end":94.5,"text":"你这不是蒙人吗","meaning":"Vậy là gạt người ta rồi còn gì!"},{"start":94.5,"end":95.5,"text":"我没有蒙他呀","meaning":"Tao đâu có gạt nó."},{"start":95.46,"end":96.83,"text":"我写的就是三个字啊","meaning":"Tao viết đúng ba chữ mà."},{"start":96.79,"end":99.04,"text":"可你刚刚明明说了是四个字啊","meaning":"Nhưng ông vừa nói rõ ràng là bốn chữ mà!"},{"start":99,"end":99.83,"text":"对啊","meaning":"Đúng rồi."},{"start":101.25,"end":102.46,"text":"你傻了吗","meaning":"Mày khùng hả?"},{"start":102.5,"end":104.16,"text":"你是不是又得狂犬病了","meaning":"Mày lại lên cơn dại nữa hả?"},{"start":104.5,"end":105.04,"text":"没有啊","meaning":"Đâu có!"},{"start":105.12,"end":106.37,"text":"那你干嘛一会三个字","meaning":"Vậy sao lúc thì ba chữ"},{"start":106.33,"end":107.29,"text":"一会四个字啊","meaning":"lúc thì bốn chữ vậy?"},{"start":107.25,"end":108.21,"text":"我说的四个字","meaning":"Bốn chữ tao nói"},{"start":108.17,"end":109.46,"text":"本来就是三个字嘛","meaning":"vốn dĩ là ba chữ mà."},{"start":109.46,"end":111.46,"text":"四个字怎么可能是三个字呢","meaning":"Bốn chữ sao có thể là ba chữ được?"},{"start":111.75,"end":112.33,"text":"老大","meaning":"Đại ca!"},{"start":112.29,"end":113.87,"text":"你还是快去打个针吧","meaning":"Ông mau đi chích thuốc đi."},{"start":113.83,"end":116.46,"text":"打什么针","meaning":"Chích cái gì?"},{"start":116.62,"end":120.25,"text":"我那四个字就是三个字","meaning":"Bốn chữ của tao chính là ba chữ!"},{"start":120.21,"end":121.75,"text":"我把我的工资给他","meaning":"Tao đưa hết lương cho nó luôn."},{"start":121.92,"end":123.08,"text":"我懒得跟你扯","meaning":"Lười cãi với mày quá."},{"start":123.04,"end":123.96,"text":"你自己看","meaning":"Tự coi đi!"},{"start":124.58,"end":126.37,"text":"这四个字是不是三个字","meaning":"Bốn chữ này có phải ba chữ không?"},{"start":128.33,"end":129.04,"text":"啊","meaning":"Hả?"},{"start":130.38,"end":131.62,"text":"看着我干嘛","meaning":"Nhìn tao làm gì!"},{"start":133.08,"end":133.62,"text":"嗯","meaning":"Ừm."},{"start":133.58,"end":135.04,"text":"我还10个字呢","meaning":"Của tao còn có thể là mười chữ nữa!"},{"start":135.67,"end":136.79,"text":"神经病嘛","meaning":"Đồ thần kinh!"}]}