{"videoId":"EqnVo_H0Ivk","title":"今天我要赢回来！ 蛙芙蓉爆笑斗闺蜜","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":127,"source":"ocr","order":13,"segments":[{"start":0.08,"end":2.37,"text":"当初是你要分开","meaning":"Hồi đó là cậu đòi chia tay mà"},{"start":3.25,"end":4.08,"text":"你搞什么啊","meaning":"Mày làm cái trò gì vậy hả"},{"start":4.04,"end":5.62,"text":"红灯 亲爱的","meaning":"Đèn đỏ kìa, cưng ơi"},{"start":5.62,"end":6.21,"text":"啊？","meaning":"Hả?"},{"start":6.62,"end":7.29,"text":"那你刹车","meaning":"Thì mày phanh lại đi"},{"start":7.25,"end":8.45,"text":"就不能温柔一点吗","meaning":"Không thể nhẹ nhàng một chút được hả?"},{"start":9.12,"end":9.54,"text":"hello","meaning":"Hello"},{"start":9.5,"end":10.41,"text":"蛙芙蓉妹妹","meaning":"Em gái Ếch Phù Dung"},{"start":10.38,"end":11.54,"text":"你也去同学会啊","meaning":"Cậu cũng đi họp lớp hả"},{"start":11.54,"end":12.08,"text":"嗯？","meaning":"Hửm?"},{"start":12.04,"end":12.54,"text":"是啊","meaning":"Ừ đó"},{"start":12.54,"end":14.08,"text":"嘿嘿嘿嘿嗯","meaning":"Hê hê hê hê ừm"},{"start":14.08,"end":15.33,"text":"你给她嘿嘿什么？","meaning":"Mày hê hê với nó cái gì?"},{"start":15.29,"end":16.25,"text":"你是不是喜欢她？","meaning":"Mày thích nó đúng không?"},{"start":16.5,"end":17.16,"text":"没有","meaning":"Đâu có"},{"start":17.17,"end":18.95,"text":"你同学和你打招呼呢","meaning":"Bạn học của mày đang chào mày kìa"},{"start":18.92,"end":20.29,"text":"谁要跟她打招呼啊","meaning":"Ai thèm chào nó chứ"},{"start":20.25,"end":21.58,"text":"当年她什么都比我强","meaning":"Hồi đó cái gì nó cũng hơn tao"},{"start":21.54,"end":22.79,"text":"还当上了校花","meaning":"Còn làm hoa khôi trường nữa"},{"start":22.75,"end":24.25,"text":"你不许跟她说话","meaning":"Cấm mày nói chuyện với nó"},{"start":24.21,"end":25.45,"text":"今天我要打败她！","meaning":"Hôm nay tao phải đánh bại nó!"},{"start":25.71,"end":26.2,"text":"哦","meaning":"Ờ"},{"start":31.08,"end":31.95,"text":"喝杯咖啡吧","meaning":"Uống ly cà phê nhé"},{"start":32.04,"end":33,"text":"别理那个蛙婆娘","meaning":"Kệ con mụ ếch đó đi"},{"start":33.21,"end":33.66,"text":"嗯","meaning":"Ừm"},{"start":37,"end":37.87,"text":"啊","meaning":"Hả"},{"start":37.83,"end":38.25,"text":"哼","meaning":"Hứ"},{"start":38.21,"end":39.29,"text":"装什么优雅","meaning":"Làm màu thanh lịch cái gì"},{"start":39.38,"end":40.7,"text":"我也要喝咖啡！","meaning":"Tao cũng muốn uống cà phê!"},{"start":40.83,"end":42.33,"text":"你喝个毛线的咖啡？","meaning":"Uống cái quái gì mà cà phê?"},{"start":42.33,"end":43.62,"text":"你自己泡！","meaning":"Tự pha đi!"},{"start":45.33,"end":46.79,"text":"我爱喝咖啡啊","meaning":"Tao mê cà phê mà"},{"start":46.75,"end":48.33,"text":"我最美呀","meaning":"Tao đẹp nhất nha"},{"start":48.33,"end":49.87,"text":"我是天上的杨贵妃...","meaning":"Tao là Dương Quý Phi trên trời..."},{"start":60.17,"end":61.04,"text":"啊！","meaning":"Á!"},{"start":64.71,"end":65.91,"text":"你这什么破车啊","meaning":"Cái xe cà tàng gì đây trời"},{"start":65.88,"end":66.75,"text":"这么颠？","meaning":"Xóc dữ vậy?"},{"start":66.71,"end":68,"text":"居然比我还癫","meaning":"Lại còn điên hơn cả tao"},{"start":68.21,"end":69.58,"text":"你赶紧给我追上她","meaning":"Mau chạy đuổi theo nó cho tao"},{"start":69.79,"end":71.21,"text":"不然今天晚上你睡沙发","meaning":"Không thì tối nay mày ngủ sofa"},{"start":71.33,"end":72.16,"text":"哦好嘞","meaning":"Ờ, được rồi"},{"start":73.17,"end":74.62,"text":"老娘哪点不如她了","meaning":"Bà đây thua con đó chỗ nào chứ"},{"start":74.62,"end":75.91,"text":"以我的美貌","meaning":"Với nhan sắc của tao"},{"start":75.88,"end":77.46,"text":"只要多看我一秒","meaning":"Chỉ cần nhìn tao thêm một giây"},{"start":77.42,"end":79.08,"text":"你就会被我迷倒","meaning":"Là mày sẽ đổ gục trước tao"},{"start":79.04,"end":79.91,"text":"嘿","meaning":"Hê"},{"start":80.04,"end":80.83,"text":"哼","meaning":"Hứ"},{"start":91.21,"end":92.04,"text":"啊","meaning":"Á!"},{"start":95.17,"end":96.62,"text":"呼 好险","meaning":"Phù, hú hồn"},{"start":101.79,"end":102.37,"text":"快快快","meaning":"Nhanh nhanh nhanh"},{"start":102.33,"end":104.04,"text":"停那个最宽的车位","meaning":"Đậu vô chỗ rộng nhất đó"},{"start":106.58,"end":107.66,"text":"啊啊","meaning":"Á á"},{"start":108.33,"end":109.41,"text":"你怎么停的车啊","meaning":"Mày đậu xe kiểu gì vậy"},{"start":109.54,"end":110.46,"text":"门怎么打不开啊","meaning":"Sao cửa không mở được vậy"},{"start":110.54,"end":111.41,"text":"车位太窄了","meaning":"Chỗ đậu hẹp quá"},{"start":111.71,"end":113.16,"text":"啊？","meaning":"Hả?"},{"start":120.46,"end":122.04,"text":"啊啊","meaning":"Á á"},{"start":122,"end":123.54,"text":"老娘今年又输给她了","meaning":"Năm nay bà đây lại thua con đó rồi"},{"start":123.75,"end":125,"text":"我要换车！","meaning":"Tao phải đổi xe!"}]}