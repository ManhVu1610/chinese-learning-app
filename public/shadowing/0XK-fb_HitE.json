{"videoId":"0XK-fb_HitE","title":"牛猫王：真~妈妈的味道！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":144,"source":"ocr","order":67,"segments":[{"start":2.21,"end":3.58,"text":"给我来份番茄炒蛋","meaning":"Cho tui một phần cà chua xào trứng"},{"start":3.83,"end":4.29,"text":"没有","meaning":"Hết"},{"start":4.29,"end":5.04,"text":"没有吗?","meaning":"Hết hả?"},{"start":5,"end":6.75,"text":"那来份西红柿炒蛋吧","meaning":"Vậy cho một phần trứng xào cà chua đi"},{"start":6.75,"end":7.25,"text":"没有","meaning":"Hết"},{"start":7.21,"end":10.25,"text":"不是西红柿炒蛋","meaning":"Đây chẳng phải là trứng xào cà chua"},{"start":10.21,"end":12.25,"text":"一样吗?","meaning":"Có giống nhau không?"},{"start":12.21,"end":13.37,"text":"西红柿炒番茄吧","meaning":"Vậy cà chua xào cà chua đi"},{"start":13.33,"end":14.45,"text":"哦","meaning":"Ồ"},{"start":14.5,"end":16.95,"text":"啊?","meaning":"Hả?"},{"start":16.92,"end":17.75,"text":"搞清楚这里是牢房","meaning":"Làm ơn biết đây là nhà giam"},{"start":18.04,"end":18.83,"text":"不是饭店","meaning":"Không phải quán ăn"},{"start":18.79,"end":21.33,"text":"我不是你服务员","meaning":"Tui không phải phục vụ của ông"},{"start":21.46,"end":23.7,"text":"啊 玉足!","meaning":"Á, ngọc túc!"},{"start":25.17,"end":25.7,"text":"年轻人","meaning":"Chàng trai trẻ"},{"start":25.67,"end":26.91,"text":"一天到晚想这些","meaning":"Cả ngày nghĩ mấy cái này"},{"start":26.88,"end":28.62,"text":"只会害了你哦","meaning":"Chỉ hại chính mình thôi nha"},{"start":28.58,"end":30.12,"text":"上班时间打瞌睡","meaning":"Giờ làm việc mà ngủ gật"},{"start":30.08,"end":32.25,"text":"你看吧","meaning":"Thấy chưa"},{"start":32.54,"end":34.37,"text":"那谁是你们这里服务员","meaning":"Vậy ai là phục vụ ở đây"},{"start":34.33,"end":34.83,"text":"跟你说","meaning":"Nói cho ông biết"},{"start":34.79,"end":36.08,"text":"这里没有服务员啊","meaning":"Ở đây không có phục vụ đâu"},{"start":36.42,"end":37.41,"text":"他是出去了吗","meaning":"Ổng đi ra ngoài rồi hả"},{"start":37.38,"end":39.7,"text":"哎呀 没人出去啊","meaning":"Ôi dào, có ai đi ra đâu"},{"start":39.67,"end":40.62,"text":"那让他帮我来份","meaning":"Vậy bảo ổng làm giúp tui một phần"},{"start":40.58,"end":43.25,"text":"洋柿子炒蛋吧","meaning":"Trứng xào cà chua tây đi"},{"start":43.21,"end":44.29,"text":"啊","meaning":"Hả"},{"start":44.29,"end":45.37,"text":"别再跟我提什么","meaning":"Đừng có nhắc với tui cái gì"},{"start":45.62,"end":46.12,"text":"西红柿","meaning":"Cà chua"},{"start":46.08,"end":46.62,"text":"洋海椒","meaning":"Ớt tây"},{"start":46.58,"end":47.62,"text":"火柿子炒蛋了","meaning":"Trứng xào hồng hỏa nữa"},{"start":47.58,"end":48.12,"text":"行不行?","meaning":"Được không hả?"},{"start":48.38,"end":50.54,"text":"这里是牢房","meaning":"Đây là nhà giam"},{"start":50.58,"end":52.37,"text":"你听不懂吗?","meaning":"Ông nghe không hiểu hả?"},{"start":52.33,"end":52.79,"text":"还有","meaning":"Còn nữa"},{"start":53,"end":60,"text":"这里没有服务员","meaning":"Ở đây không có phục vụ"},{"start":59.96,"end":65.91,"text":"那我们招聘一个吧","meaning":"Vậy tụi mình tuyển một người đi"},{"start":66.17,"end":68.16,"text":"为什么他这么激动啊","meaning":"Sao ổng kích động vậy trời"},{"start":70.12,"end":71,"text":"你们这里怎么","meaning":"Chỗ tụi bây sao"},{"start":70.96,"end":75,"text":"连番茄炒蛋都没有啊","meaning":"Ngay cả cà chua xào trứng cũng không có"},{"start":74.96,"end":75.91,"text":"对啊 老大","meaning":"Đúng đó đại ca"},{"start":75.88,"end":77.83,"text":"现场给他下一个呗","meaning":"Làm một cái tại chỗ cho ổng đi"},{"start":81.88,"end":82.75,"text":"喜欢吃什么啊","meaning":"Thích ăn gì vậy"},{"start":83.04,"end":85.33,"text":"唐僧肉!","meaning":"Thịt Đường Tăng!"},{"start":85.29,"end":87.04,"text":"你平时喜欢吃什么?","meaning":"Bình thường ông thích ăn gì?"},{"start":87.04,"end":88.66,"text":"哦 我吃草","meaning":"À, tui ăn cỏ"},{"start":88.62,"end":89.58,"text":"为什么吃草啊?","meaning":"Sao lại ăn cỏ vậy?"},{"start":89.75,"end":92,"text":"它是牛不吃草","meaning":"Nó là bò mà không ăn cỏ"},{"start":92,"end":93.25,"text":"啊","meaning":"Hả"},{"start":93.21,"end":94.87,"text":"是的 虽然草不好吃","meaning":"Ừ, tuy cỏ không ngon"},{"start":94.83,"end":96.25,"text":"但它绿色 健康","meaning":"Nhưng nó xanh, lành mạnh"},{"start":96.21,"end":97.21,"text":"而且到处都有","meaning":"Mà đâu cũng có"},{"start":97.17,"end":99.46,"text":"吃起来超方便的","meaning":"Ăn siêu tiện luôn"},{"start":99.42,"end":101.25,"text":"有方便面方便吗?","meaning":"Có tiện bằng mì ăn liền không?"},{"start":103,"end":104.46,"text":"我真的好想打他一顿","meaning":"Tui thật sự muốn đánh ổng một trận"},{"start":106.04,"end":107.54,"text":"但它比草草好吃哦","meaning":"Nhưng nó ngon hơn cỏ nhiều nha"},{"start":107.5,"end":108.08,"text":"啊","meaning":"Hả"},{"start":108.04,"end":110.37,"text":"我要吃 我要吃","meaning":"Tui muốn ăn! Tui muốn ăn!"},{"start":116.08,"end":117.75,"text":"我吃出了家的感觉","meaning":"Tui ăn ra cảm giác như ở nhà"},{"start":117.71,"end":119.08,"text":"是妈妈的味道","meaning":"Là hương vị của mẹ"},{"start":119.04,"end":120.25,"text":"好吃你就多吃点","meaning":"Ngon thì ăn nhiều chút đi"},{"start":120.29,"end":121.08,"text":"嗯嗯","meaning":"Ừ ừ"},{"start":121.04,"end":122.66,"text":"你刚刚说这什么面来着","meaning":"Nãy ông nói đây là mì gì ấy nhỉ"},{"start":122.62,"end":125.29,"text":"红烧牛肉面啊","meaning":"Mì bò kho đó"},{"start":130.33,"end":131.29,"text":"呜~呜~~","meaning":"Hu~ hu~~"},{"start":131.79,"end":133.7,"text":"我的妈妈呀","meaning":"Mẹ ơi là mẹ"},{"start":134.21,"end":138.25,"text":"啊~","meaning":"Á~"},{"start":138.79,"end":139.5,"text":"啊?","meaning":"Hả?"}]}