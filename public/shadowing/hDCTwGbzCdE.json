{"videoId":"hDCTwGbzCdE","title":"牛猫王：我就喜欢唱歌，怎么啦？","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":84,"source":"ocr","order":51,"segments":[{"start":0.42,"end":2.58,"text":"你好我有一个帽衫","meaning":"Xin chào, tôi có một cái áo hoodie"},{"start":2.54,"end":3.12,"text":"你好……","meaning":"Chào……"},{"start":3.08,"end":4.46,"text":"大清早的你在这嚎什么","meaning":"Sáng sớm tinh mơ mày gào cái gì ở đây"},{"start":4.54,"end":5.37,"text":"烦死了","meaning":"Phiền chết đi được"},{"start":6.08,"end":6.87,"text":"你别介意","meaning":"Mày đừng để bụng"},{"start":6.83,"end":7.75,"text":"他不懂音乐","meaning":"Ổng không hiểu âm nhạc"},{"start":7.71,"end":8.83,"text":"所以看你不顺眼","meaning":"Nên nhìn mày thấy ngứa mắt"},{"start":9.12,"end":9.91,"text":"哦","meaning":"Ồ"},{"start":9.88,"end":11.16,"text":"那我唱的怎么样啊","meaning":"Vậy tui hát thế nào"},{"start":11.83,"end":12.5,"text":"你唱的","meaning":"Ông hát"},{"start":12.46,"end":13.41,"text":"不算难听","meaning":"Cũng không tới nỗi khó nghe"},{"start":13.71,"end":14.58,"text":"那好听吗？","meaning":"Vậy có hay không?"},{"start":14.54,"end":15.41,"text":"也不好听","meaning":"Cũng không hay"},{"start":16.46,"end":17.7,"text":"那那我有机会","meaning":"Vậy vậy tui có cơ hội"},{"start":17.67,"end":18.75,"text":"参加比赛吗","meaning":"Tham gia cuộc thi không"},{"start":18.71,"end":19.95,"text":"你想参加什么比赛","meaning":"Ông muốn thi cuộc thi nào"},{"start":20,"end":21.29,"text":"歌手2024啊","meaning":"Ca Sĩ 2024 chứ sao"},{"start":21.29,"end":22.12,"text":"噗","meaning":"Phụt"},{"start":22.71,"end":23.79,"text":"歌手2024","meaning":"Ca Sĩ 2024"},{"start":23.92,"end":24.37,"text":"对啊","meaning":"Ừ đó"},{"start":24.33,"end":25.66,"text":"现在的状况是","meaning":"Tình hình hiện giờ là"},{"start":25.62,"end":27.2,"text":"五旬老太守国门","meaning":"Bà lão năm chục tuổi trấn giữ cửa ngõ quốc gia"},{"start":27.25,"end":27.83,"text":"所以我要","meaning":"Nên tui phải"},{"start":27.79,"end":29.29,"text":"奋起高歌战洋人","meaning":"Cất cao giọng hát quyết chiến với Tây"},{"start":29.25,"end":30.75,"text":"我要去当冠军！！","meaning":"Tui phải đi giành quán quân!!"},{"start":30.71,"end":32.2,"text":"歌手2024","meaning":"Ca Sĩ 2024"},{"start":32.42,"end":33.16,"text":"我看你还去参加","meaning":"Tao thấy mày đi thi"},{"start":33.17,"end":34.54,"text":"鬼叫2024吧","meaning":"Quỷ Gào 2024 thì có"},{"start":34.5,"end":35.75,"text":"就你这个水平","meaning":"Với trình của mày"},{"start":35.71,"end":36.95,"text":"比赛鬼叫……","meaning":"Thi gào quỷ……"},{"start":37.04,"end":38.66,"text":"说不定能拿冠军","meaning":"Biết đâu lấy được quán quân"},{"start":39.42,"end":40.95,"text":"鬼叫2024？","meaning":"Quỷ Gào 2024?"},{"start":40.92,"end":41.83,"text":"有奖金吗？","meaning":"Có tiền thưởng không?"},{"start":43.21,"end":44.16,"text":"没有","meaning":"Không có"},{"start":44.62,"end":45.66,"text":"那那我不去","meaning":"Vậy vậy tui không đi"},{"start":46.62,"end":47.83,"text":"你可别小瞧哦","meaning":"Đừng có coi thường nha"},{"start":47.79,"end":49.91,"text":"其实鬼叫也是一门艺术","meaning":"Thật ra gào quỷ cũng là một môn nghệ thuật"},{"start":49.88,"end":50.41,"text":"哦？？","meaning":"Ồ??"},{"start":50.71,"end":51.29,"text":"什么艺术啊","meaning":"Nghệ thuật gì vậy"},{"start":51.75,"end":52.58,"text":"行为艺术","meaning":"Nghệ thuật trình diễn"},{"start":54.08,"end":54.83,"text":"你还别说","meaning":"Nói thiệt chứ"},{"start":54.79,"end":56.29,"text":"我看过很多唱歌比赛","meaning":"Tui coi nhiều cuộc thi hát rồi"},{"start":56.25,"end":57.62,"text":"但从来还没有看过一场","meaning":"Nhưng chưa từng coi một cuộc nào"},{"start":57.58,"end":59.08,"text":"正经的鬼叫比赛哎","meaning":"Thi gào quỷ đàng hoàng hết"},{"start":59.04,"end":60.5,"text":"啊要不要你们谁办一个","meaning":"À, hay là ai trong mấy người tổ chức một cuộc đi"},{"start":60.46,"end":61.45,"text":"鬼叫大赛","meaning":"Đại hội Quỷ Gào"},{"start":61.5,"end":62.79,"text":"是什么给了你勇气","meaning":"Cái gì cho ông can đảm vậy"},{"start":62.75,"end":64.21,"text":"要去参加歌手比赛啊","meaning":"Mà đòi đi thi ca sĩ"},{"start":64.17,"end":64.91,"text":"穷啊","meaning":"Nghèo đó"},{"start":65.42,"end":66.87,"text":"我听说得了冠军","meaning":"Tui nghe nói đoạt quán quân"},{"start":66.83,"end":68.33,"text":"会有很多奖金哎","meaning":"Sẽ có nhiều tiền thưởng lắm"},{"start":68.42,"end":69.91,"text":"哼 还想得奖","meaning":"Hứ, còn mơ đoạt giải"},{"start":69.96,"end":71,"text":"你去唱歌","meaning":"Ông đi hát"},{"start":70.96,"end":72.5,"text":"只会赔钱、破产","meaning":"Chỉ có lỗ vốn, phá sản"},{"start":72.96,"end":73.83,"text":"什么意思啊","meaning":"Nghĩa là sao vậy"},{"start":73.92,"end":74.46,"text":"哦","meaning":"Ồ"},{"start":74.5,"end":75.33,"text":"他的意思是","meaning":"Ý ổng là"},{"start":75.33,"end":76.16,"text":"你唱完歌","meaning":"Ông hát xong"},{"start":76.21,"end":76.87,"text":"观众可能会","meaning":"Khán giả có thể"},{"start":76.83,"end":77.83,"text":"让你退钱","meaning":"Bắt ông trả tiền lại"},{"start":78.33,"end":79.33,"text":"我的意思是","meaning":"Ý tao là"},{"start":79.38,"end":80,"text":"他唱完歌","meaning":"Ổng hát xong"},{"start":79.96,"end":80.79,"text":"观众可能会","meaning":"Khán giả có thể"},{"start":80.75,"end":81.75,"text":"把他打残","meaning":"Đánh ổng tàn phế"},{"start":81.71,"end":82.21,"text":"啊","meaning":"Hả"}]}