{"videoId":"uqUg73-rSss","title":"测智商？就凭你！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":67,"source":"ocr","order":35,"segments":[{"start":1.88,"end":2.87,"text":"这里有100块","meaning":"Ở đây có 100 đồng"},{"start":2.92,"end":4.5,"text":"你手不能碰到这个碗","meaning":"Tay mày không được đụng vô cái tô này"},{"start":4.5,"end":5.62,"text":"能拿到这个钱","meaning":"Lấy được số tiền này"},{"start":5.58,"end":6.21,"text":"就归你","meaning":"Thì thuộc về mày"},{"start":6.17,"end":6.71,"text":"哦？","meaning":"Ồ?"},{"start":6.67,"end":7.5,"text":"真的吗？","meaning":"Thiệt hông?"},{"start":7.58,"end":8.87,"text":"这可不止100块哦","meaning":"Đâu có chỉ 100 đồng đâu nha"},{"start":8.83,"end":9.54,"text":"真的！","meaning":"Thiệt chứ!"},{"start":10,"end":11.7,"text":"你们不说我智商低吗","meaning":"Mấy người không phải chê tui IQ thấp sao"},{"start":11.67,"end":12.79,"text":"我倒要看看……","meaning":"Để tao xem thử......"},{"start":12.79,"end":13.87,"text":"你智商有多高","meaning":"Mày IQ cao cỡ nào"},{"start":23.46,"end":24.66,"text":"刚刚是我大意了","meaning":"Hồi nãy là tui sơ ý"},{"start":24.62,"end":26.08,"text":"低估了你还有些智商","meaning":"Đánh giá thấp mày, hóa ra cũng có chút IQ"},{"start":27.17,"end":28.95,"text":"这次 手不能碰盖子","meaning":"Lần này tay không được đụng cái nắp"},{"start":29,"end":30.29,"text":"能拿到里面的钱","meaning":"Lấy được tiền bên trong"},{"start":30.25,"end":30.87,"text":"就归你","meaning":"Thì thuộc về mày"},{"start":33.46,"end":34.83,"text":"我手没碰到盖子哦","meaning":"Tay tui đâu có đụng vô nắp nha"},{"start":37.25,"end":38.08,"text":"最后一次","meaning":"Lần cuối"},{"start":38.04,"end":40.16,"text":"你不能用手","meaning":"Mày không được dùng tay"},{"start":40.21,"end":41.7,"text":"你不能借助任何道具","meaning":"Mày không được dùng bất kỳ dụng cụ nào"},{"start":41.71,"end":43.04,"text":"能拿到里面的钱","meaning":"Lấy được tiền bên trong"},{"start":43,"end":43.62,"text":"就归你","meaning":"Thì thuộc về mày"},{"start":43.62,"end":44.7,"text":"这么多限制啊？","meaning":"Nhiều điều kiện vậy hả?"},{"start":44.67,"end":45.33,"text":"要不这样吧","meaning":"Hay là vầy đi"},{"start":45.29,"end":46.62,"text":"我们来玩把大的","meaning":"Tụi mình chơi ván lớn"},{"start":46.58,"end":47.83,"text":"你看我这也有钱","meaning":"Nè, tui cũng có tiền"},{"start":47.79,"end":49.54,"text":"我把这些钱都放进去","meaning":"Tui bỏ hết số tiền này vô"},{"start":49.5,"end":50.54,"text":"如果我拿不出来","meaning":"Nếu tui không lấy ra được"},{"start":50.5,"end":52.12,"text":"那这些 都归你怎么样","meaning":"Thì hết chỗ này thuộc về mày, sao hả"},{"start":52.21,"end":52.79,"text":"咦！","meaning":"Ồ!"},{"start":53,"end":53.91,"text":"好啊好啊","meaning":"Được đó được đó"},{"start":54.79,"end":55.62,"text":"诶","meaning":"Hây"},{"start":57.54,"end":58.12,"text":"唉……","meaning":"Hầy......"},{"start":58.21,"end":59.41,"text":"自己都没有智商","meaning":"Bản thân còn không có IQ"},{"start":59.38,"end":60.7,"text":"还想测别人智商","meaning":"Mà đòi đo IQ người khác"},{"start":60.71,"end":62.45,"text":"你还真是搞笑","meaning":"Mày đúng là hài thật"}]}