{"videoId":"CZc2eZW9NIA","title":"居然是首富的儿子？！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":93,"source":"ocr","order":14,"segments":[{"start":0.54,"end":1.08,"text":"牛猫王","meaning":"Ngưu Miêu Vương!"},{"start":1.04,"end":2.79,"text":"好消息","meaning":"Tin vui nè!"},{"start":2.75,"end":3.83,"text":"什么好消息啊","meaning":"Tin vui gì vậy?"},{"start":3.79,"end":5.37,"text":"原来你爸不是奶牛","meaning":"Hóa ra ba cậu không phải bò sữa,"},{"start":5.33,"end":6.87,"text":"你爸是谢浩凡！","meaning":"ba cậu là Tạ Hạo Phàm đó!"},{"start":6.83,"end":7.33,"text":"啊？","meaning":"Hả?"},{"start":7.5,"end":9.29,"text":"他可是世界首富啊","meaning":"Ổng là người giàu nhất thế giới luôn đó!"},{"start":9.25,"end":10.54,"text":"这些年他为了找你","meaning":"Mấy năm nay vì đi tìm cậu,"},{"start":10.5,"end":11.91,"text":"头发都秃成卤蛋了","meaning":"tóc ổng rụng sạch bóng như trứng ốp-la luôn."},{"start":11.88,"end":13.2,"text":"终于找到你了","meaning":"Cuối cùng cũng tìm ra cậu rồi!"},{"start":13.17,"end":14.2,"text":"我的天呐","meaning":"Trời đất ơi!"},{"start":14.25,"end":17.25,"text":"你居然是首富的儿子啊","meaning":"Cậu lại là con trai của người giàu nhất á!"},{"start":17.75,"end":18.91,"text":"那我还用上班吗","meaning":"Vậy tui còn phải đi làm nữa hả?"},{"start":18.88,"end":20.37,"text":"你开什么玩笑啊","meaning":"Giỡn mặt hả trời!"},{"start":20.33,"end":21.33,"text":"几百亿的资产","meaning":"Tài sản mấy chục tỷ"},{"start":21.29,"end":22.62,"text":"等着你回去继承呢","meaning":"đang chờ cậu về thừa kế kìa."},{"start":22.58,"end":24,"text":"还上什么班呢","meaning":"Đi làm cái nỗi gì nữa!"},{"start":24.08,"end":25.75,"text":"你赶紧收拾收拾出去见他吧","meaning":"Mau thu dọn rồi ra gặp ổng đi."},{"start":25.71,"end":27.25,"text":"我饭还没吃完呢","meaning":"Tui chưa ăn xong cơm mà."},{"start":27.21,"end":29.91,"text":"哎 不要再吃这些山猪吃的东西了","meaning":"Ê, đừng ăn mấy thứ heo rừng ăn nữa."},{"start":29.88,"end":31.29,"text":"你现在是牛少爷","meaning":"Giờ cậu là Ngưu thiếu gia rồi,"},{"start":31.25,"end":32.87,"text":"以后只能吃山珍海味","meaning":"sau này chỉ được ăn sơn hào hải vị,"},{"start":32.83,"end":33.91,"text":"鲍鱼龙虾","meaning":"bào ngư tôm hùm."},{"start":33.88,"end":35.08,"text":"豹鱼聋虾？","meaning":"Báo ngư điếc tôm hả?"},{"start":35.17,"end":36.08,"text":"真的吗老大","meaning":"Thiệt hả đại ca?"},{"start":36.04,"end":37.12,"text":"不许叫我老大","meaning":"Cấm gọi tui là đại ca!"},{"start":37.12,"end":38.04,"text":"从今天起","meaning":"Từ hôm nay trở đi,"},{"start":38,"end":39.25,"text":"你是我的老大","meaning":"ông mới là đại ca của tui."},{"start":39.46,"end":39.91,"text":"牛哥！","meaning":"Ngưu ca!"},{"start":39.96,"end":40.37,"text":"啊？","meaning":"Hả?"},{"start":40.5,"end":41.45,"text":"收我做小弟吧","meaning":"Nhận em làm đàn em đi,"},{"start":41.42,"end":42.91,"text":"我想跟着你吃香喝辣！","meaning":"em muốn theo anh ăn sung mặc sướng!"},{"start":42.88,"end":45.25,"text":"啊？","meaning":"Hả?"},{"start":45.21,"end":46,"text":"牛猫王","meaning":"Ngưu Miêu Vương!"},{"start":45.96,"end":47.08,"text":"真没想到","meaning":"Thiệt không ngờ"},{"start":47.04,"end":48.45,"text":"你才是我们牛粪山","meaning":"cậu mới là"},{"start":48.42,"end":49.7,"text":"真正的青年才俊","meaning":"thanh niên tài tuấn thật sự của núi Phân Trâu,"},{"start":49.67,"end":50.95,"text":"帅气逼人","meaning":"đẹp trai ngời ngời."},{"start":50.92,"end":51.95,"text":"去年你是不是说","meaning":"Năm ngoái cậu có nói"},{"start":51.92,"end":53.12,"text":"要和我交往来着","meaning":"là muốn quen tui đúng không?"},{"start":53.29,"end":53.91,"text":"呃……","meaning":"Ờ..."},{"start":53.88,"end":54.83,"text":"我答应你了！","meaning":"Tui đồng ý rồi nha!"},{"start":54.79,"end":55.16,"text":"啊？","meaning":"Hả?"},{"start":55.17,"end":55.83,"text":"算了！","meaning":"Thôi bỏ đi!"},{"start":55.79,"end":57.16,"text":"现在交往太晚了！","meaning":"Giờ mới quen thì trễ quá rồi!"},{"start":57.12,"end":57.5,"text":"啊？","meaning":"Hả?"},{"start":57.79,"end":59.33,"text":"我蛙芙蓉·鸾拉氏","meaning":"Tui là Ếch Phù Dung Loan Lạp Thị,"},{"start":59.29,"end":61.12,"text":"正式向牛猫王求婚","meaning":"chính thức cầu hôn Ngưu Miêu Vương!"},{"start":61.08,"end":62.04,"text":"从今往后","meaning":"Từ nay về sau,"},{"start":62,"end":63.5,"text":"我家的10亩荷塘","meaning":"ao sen mười mẫu nhà tui,"},{"start":63.46,"end":64.37,"text":"百里牧场","meaning":"trang trại trăm dặm,"},{"start":64.33,"end":65.16,"text":"还有祖传的","meaning":"còn có"},{"start":65.12,"end":67.08,"text":"窖藏了500年的老坛酸菜","meaning":"hũ dưa chua ủ năm trăm năm gia truyền,"},{"start":67.04,"end":68.08,"text":"价值连城","meaning":"giá trị liên thành,"},{"start":68.04,"end":69.5,"text":"一律倒贴给你","meaning":"tui xin tặng không cho cậu hết,"},{"start":69.46,"end":71.5,"text":"只求你真心爱我","meaning":"chỉ xin cậu thật lòng yêu tui,"},{"start":71.5,"end":72.71,"text":"娶我做老婆好吗","meaning":"cưới tui làm vợ nha?"},{"start":72.67,"end":73.75,"text":"拜托拜托","meaning":"Làm ơn làm ơn mà!"},{"start":73.71,"end":75,"text":"收我做小弟好吗","meaning":"Nhận em làm đàn em nha?"},{"start":74.96,"end":76.21,"text":"拜托拜托","meaning":"Làm ơn làm ơn mà!"},{"start":77.42,"end":79.29,"text":"我这不会是在做梦吧","meaning":"Chắc tui không phải đang nằm mơ chứ?"},{"start":80.42,"end":80.91,"text":"哎哟","meaning":"Ái da!"},{"start":81.62,"end":82.33,"text":"真的？","meaning":"Thiệt hả?"},{"start":83.25,"end":84.12,"text":"哎","meaning":"Ê!"},{"start":85.25,"end":86.91,"text":"有钱了","meaning":"Giàu rồi!"},{"start":86.92,"end":88.79,"text":"哈哈哈啊","meaning":"Ha ha ha!"},{"start":91.33,"end":91.79,"text":"我！","meaning":"Tui nè!"},{"start":91.75,"end":92.41,"text":"啊！","meaning":"Á!"}]}