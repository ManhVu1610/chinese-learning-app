{"videoId":"u5r54R34oks","title":"牛猫王：不好了，哪吒来救唐僧啦！！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":121,"source":"ocr","order":21,"segments":[{"start":3.58,"end":4.29,"text":"还吃","meaning":"Còn dám ăn à"},{"start":4.58,"end":6.08,"text":"收你们来了","meaning":"Tới thu phục các ngươi đây"},{"start":8.5,"end":9.33,"text":"啊","meaning":"Á"},{"start":10.12,"end":10.95,"text":"妖怪莫逃","meaning":"Yêu quái đứng lại, đừng hòng chạy"},{"start":10.92,"end":11.79,"text":"交出唐僧","meaning":"Giao Đường Tăng ra đây"},{"start":12.33,"end":13.87,"text":"不好了 老大","meaning":"Không xong rồi đại ca"},{"start":16.25,"end":17.7,"text":"有个神仙来救唐僧","meaning":"Có một vị thần tiên tới cứu Đường Tăng"},{"start":17.67,"end":19,"text":"还说要收了我们","meaning":"Còn nói là sẽ thu phục tụi mình nữa"},{"start":19.12,"end":19.83,"text":"啊","meaning":"Hả"},{"start":19.96,"end":21.41,"text":"那不是我们要玩完了","meaning":"Vậy chẳng phải tụi mình toang rồi sao"},{"start":21.38,"end":22.29,"text":"嗯 嗯嗯","meaning":"Ừ ừ ừ"},{"start":22.25,"end":23.54,"text":"怎么办","meaning":"Giờ tính sao đây"},{"start":23.54,"end":25.08,"text":"我房贷还没还完呢","meaning":"Tui còn chưa trả hết nợ nhà nữa"},{"start":25.96,"end":27.37,"text":"这个时候还想什么房贷","meaning":"Lúc này còn nghĩ tới nợ nhà làm gì"},{"start":27.38,"end":28.79,"text":"先想想怎么活命吧你","meaning":"Lo nghĩ cách giữ mạng trước đi mày"},{"start":28.88,"end":30.58,"text":"老大 我不想死啊","meaning":"Đại ca, em không muốn chết đâu"},{"start":30.79,"end":31.62,"text":"走 先去报告大王","meaning":"Đi, báo cáo đại vương trước đã"},{"start":31.67,"end":32.16,"text":"好","meaning":"Dạ"},{"start":33.33,"end":33.91,"text":"就是他","meaning":"Chính là hắn"},{"start":33.88,"end":34.33,"text":"啊","meaning":"Hả"},{"start":36.33,"end":37.45,"text":"你是说","meaning":"Ý mày là"},{"start":37.46,"end":38.75,"text":"他要来救唐僧？","meaning":"Hắn tới cứu Đường Tăng á?"},{"start":38.79,"end":39.37,"text":"嗯嗯","meaning":"Ừ ừ"},{"start":39.58,"end":41.16,"text":"他还要 收了我们？","meaning":"Hắn còn đòi thu phục tụi mình nữa á?"},{"start":41.21,"end":42.25,"text":"嗯 嗯嗯","meaning":"Ừ ừ ừ"},{"start":43.29,"end":45.04,"text":"哈哈哈哈哈","meaning":"Ha ha ha ha ha"},{"start":45,"end":46.08,"text":"一个三岁的小屁孩","meaning":"Một thằng nhóc ba tuổi"},{"start":46.04,"end":46.87,"text":"把你吓成这样？","meaning":"Mà dọa mày ra nông nỗi này hả?"},{"start":46.83,"end":47.7,"text":"呃","meaning":"Ờ"},{"start":47.96,"end":48.66,"text":"你看他那吊儿郎当的样","meaning":"Nhìn cái bộ dạng lơ ngơ của nó kìa"},{"start":49.46,"end":50.79,"text":"估计 连奶都还没断吧","meaning":"Chắc còn chưa cai sữa nữa đó"},{"start":50.75,"end":52.2,"text":"我感觉他很厉害的","meaning":"Em thấy hắn lợi hại lắm đó"},{"start":52.33,"end":53.7,"text":"不要轻敌啊 老大","meaning":"Đừng coi thường địch nha đại ca"},{"start":53.83,"end":54.41,"text":"怕什么？","meaning":"Sợ cái gì?"},{"start":54.58,"end":55.79,"text":"我堂堂狂飙鸡","meaning":"Ta đường đường là Gà Cuồng Phong"},{"start":55.75,"end":56.95,"text":"会怕一个小孩","meaning":"Mà đi sợ một thằng nhóc à"},{"start":56.92,"end":60.08,"text":"你叫他过来打我噻","meaning":"Mày gọi nó qua đây đánh ta đi"},{"start":60.21,"end":61.04,"text":"来打我噻","meaning":"Lại đây đánh ta đi"},{"start":61.17,"end":61.95,"text":"来打…","meaning":"Lại đánh đi..."},{"start":63.17,"end":66.87,"text":"呃……","meaning":"Ờ......"},{"start":67.38,"end":69.29,"text":"第一次听说有这种要求","meaning":"Lần đầu nghe có yêu cầu kỳ vậy"},{"start":69.92,"end":71.08,"text":"你要不要 也来一下？","meaning":"Ngươi có muốn thử một cái không?"},{"start":71.21,"end":71.79,"text":"啊","meaning":"Hả"},{"start":71.83,"end":72.83,"text":"不不不用了","meaning":"Không không, khỏi đi"},{"start":73.71,"end":74.54,"text":"没劲","meaning":"Chán òm"},{"start":74.71,"end":75.5,"text":"唐僧在哪？","meaning":"Đường Tăng đâu?"},{"start":75.58,"end":76.21,"text":"那边","meaning":"Bên kia"},{"start":81.54,"end":82.41,"text":"喂","meaning":"Này"},{"start":82.75,"end":83.46,"text":"干什么？","meaning":"Làm gì đó?"},{"start":83.75,"end":84.46,"text":"就走了啊？","meaning":"Đi luôn vậy hả?"},{"start":84.67,"end":85.25,"text":"是啊","meaning":"Ừ chứ sao"},{"start":85.38,"end":86.12,"text":"去哪里啊？","meaning":"Đi đâu vậy?"},{"start":86.21,"end":87.04,"text":"下山呐","meaning":"Xuống núi chứ đâu"},{"start":87.58,"end":88.41,"text":"然后呢？","meaning":"Rồi sao nữa?"},{"start":88.54,"end":89.54,"text":"去取经啊","meaning":"Đi thỉnh kinh chứ sao"},{"start":90.17,"end":91.66,"text":"不下山 行不行啊？","meaning":"Không xuống núi được không?"},{"start":91.75,"end":93.08,"text":"不下山你养我啊？","meaning":"Không xuống núi chắc ông nuôi tui hả?"},{"start":93.04,"end":93.87,"text":"呃","meaning":"Ờ"},{"start":94.62,"end":95.16,"text":"拜拜","meaning":"Bái bai"},{"start":95.67,"end":96.25,"text":"哦","meaning":"Ò"},{"start":97.12,"end":98.33,"text":"当当 当当当","meaning":"Cốp cốp cốp cốp cốp"},{"start":99.04,"end":99.5,"text":"喂","meaning":"Này"},{"start":100.29,"end":101.33,"text":"又干嘛呀？","meaning":"Lại gì nữa đây?"},{"start":102.54,"end":103.75,"text":"我养你啊","meaning":"Tui nuôi ông nè"},{"start":109.58,"end":110.41,"text":"啊","meaning":"Hả"},{"start":111.83,"end":113.29,"text":"偶像剧看多了吧你","meaning":"Chắc xem phim thần tượng nhiều quá rồi ha"},{"start":113.5,"end":114.66,"text":"管好你自己吧你","meaning":"Lo cho bản thân đi"},{"start":115.33,"end":115.83,"text":"走","meaning":"Đi thôi"}]}