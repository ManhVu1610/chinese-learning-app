{"videoId":"l9oLYkWHt3o","title":"当诈骗遇上笨蛋，反转不断。","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":148,"source":"ocr","order":22,"segments":[{"start":0.42,"end":1.29,"text":"天地宝到账","meaning":"Tiền Thiên Địa Bảo đã về ví!"},{"start":1.33,"end":2.33,"text":"200万元","meaning":"Hai trăm vạn tệ!"},{"start":2.42,"end":3.25,"text":"呦 小样","meaning":"Ồ hô, nhóc con."},{"start":3.21,"end":4.5,"text":"没啥钱还装大款","meaning":"Nghèo rớt mồng tơi mà còn bày đặt làm đại gia."},{"start":4.58,"end":5.96,"text":"铃声挺别致的嘛","meaning":"Nhạc chuông cũng độc đáo đấy chứ."},{"start":5.96,"end":7.12,"text":"这不是铃声","meaning":"Đây không phải nhạc chuông."},{"start":7.08,"end":7.58,"text":"哦？","meaning":"Hả?"},{"start":8.25,"end":9.58,"text":"真有200万呐","meaning":"Có thật hai trăm vạn luôn hả trời."},{"start":9.54,"end":10.33,"text":"哪来的","meaning":"Ở đâu ra vậy?"},{"start":10.33,"end":11.58,"text":"是阿蛤给我的","meaning":"A Cáp cho tui đó."},{"start":11.54,"end":12.25,"text":"啊哈？","meaning":"A Cáp á?"},{"start":12.21,"end":13.41,"text":"是那个……","meaning":"Là cái cô..."},{"start":13.38,"end":13.87,"text":"啊哈","meaning":"A Cáp."},{"start":13.83,"end":15.5,"text":"给我一杯忘情水","meaning":"Cho tui ly nước quên tình đi."},{"start":15.46,"end":16.7,"text":"那个啊哈？","meaning":"A Cáp nào cơ?"},{"start":16.67,"end":17.25,"text":"不是","meaning":"Không phải."},{"start":17.25,"end":18.16,"text":"那就是……","meaning":"Vậy thì là..."},{"start":18.12,"end":19.25,"text":"娘子","meaning":"Nương tử."},{"start":19.25,"end":20.08,"text":"啊哈","meaning":"A Cáp."},{"start":20.29,"end":21.16,"text":"这个啊哈","meaning":"A Cáp này nè."},{"start":22.08,"end":23.08,"text":"不是","meaning":"Không phải."},{"start":23.04,"end":24.25,"text":"阿蛤 是蛙芙蓉","meaning":"A Cáp là Ếch Phù Dung."},{"start":24.21,"end":25.62,"text":"是那个蛤蟆呀？","meaning":"Là con cóc đó hả?"},{"start":25.71,"end":28.04,"text":"她哪来那么多钱给你啊","meaning":"Cổ lấy đâu ra nhiều tiền vậy mà đưa ông?"},{"start":28,"end":29.12,"text":"只是暂存","meaning":"Chỉ gửi tạm thôi."},{"start":29.08,"end":30.91,"text":"过几天要转回去给她的","meaning":"Vài hôm nữa phải chuyển lại cho cổ."},{"start":32.04,"end":32.5,"text":"诈骗？","meaning":"Lừa đảo hả?"},{"start":32.54,"end":33.58,"text":"我来整整他","meaning":"Để tui chỉnh hắn một trận."},{"start":34.29,"end":34.7,"text":"喂","meaning":"Alo."},{"start":34.67,"end":35.54,"text":"萨瓦迪卡","meaning":"Sawadika."},{"start":35.62,"end":37.62,"text":"您所拨打的用户正在数钱","meaning":"Thuê bao quý khách vừa gọi đang đếm tiền."},{"start":37.62,"end":38.79,"text":"请稍后再拨","meaning":"Xin vui lòng gọi lại sau."},{"start":38.92,"end":39.79,"text":"数钱","meaning":"Đếm tiền."},{"start":40.42,"end":40.83,"text":"哼","meaning":"Hừ."},{"start":40.79,"end":42.91,"text":"嘿嘿嘿","meaning":"Hê hê hê."},{"start":43.62,"end":45.33,"text":"喂，数钱数完了吗","meaning":"Alo, đếm tiền xong chưa?"},{"start":45.79,"end":46.95,"text":"哦 对不起","meaning":"À, xin lỗi."},{"start":46.96,"end":48.08,"text":"你所拨打的用户","meaning":"Thuê bao ông vừa gọi"},{"start":48.04,"end":49.79,"text":"数钱数到抽过去啦","meaning":"đếm tiền đếm đến xỉu rồi nha."},{"start":49.75,"end":50.75,"text":"啊？","meaning":"Hả?"},{"start":50.83,"end":52.29,"text":"嘿嘿嘿","meaning":"Hê hê hê."},{"start":52.33,"end":53.45,"text":"别给我装神弄鬼","meaning":"Đừng có giả thần giả quỷ với tao."},{"start":53.58,"end":54.83,"text":"蛙芙蓉被我绑了","meaning":"Ếch Phù Dung bị tao bắt cóc rồi."},{"start":54.79,"end":56.45,"text":"赶紧给我转20万过来（赎人）","meaning":"Mau chuyển cho tao 20 vạn (tiền chuộc)."},{"start":56.46,"end":57.16,"text":"否则我就撕票","meaning":"Không thì tao xử con tin đó!"},{"start":57.54,"end":58.29,"text":"哦","meaning":"Ồ."},{"start":58.5,"end":59.79,"text":"阿蛤被绑了","meaning":"A Cáp bị bắt cóc rồi."},{"start":60.17,"end":61.12,"text":"绑匪先生","meaning":"Ông bắt cóc ơi."},{"start":61.17,"end":62.12,"text":"我没有20万","meaning":"Tui làm gì có 20 vạn."},{"start":62.79,"end":63.83,"text":"没有吗？","meaning":"Không có hả?"},{"start":64.46,"end":65.41,"text":"我只有200万","meaning":"Tui chỉ có hai trăm vạn thôi."},{"start":65.62,"end":66.25,"text":"哦","meaning":"Ồ."},{"start":66.29,"end":67.79,"text":"但是 但是","meaning":"Nhưng mà, nhưng mà"},{"start":67.75,"end":68.75,"text":"就是不给你","meaning":"tui không đưa cho ông đó."},{"start":69.21,"end":70.75,"text":"嘿嘿嘿","meaning":"Hê hê hê."},{"start":70.71,"end":71.21,"text":"救救我呀","meaning":"Cứu em với!"},{"start":71.21,"end":71.75,"text":"牛猫王","meaning":"Ngưu Miêu Vương!"},{"start":71.71,"end":74.25,"text":"我真的被他们绑架了","meaning":"Em bị tụi nó bắt cóc thật mà!"},{"start":74.21,"end":75.41,"text":"他们要打算撕票啦","meaning":"Tụi nó định giết con tin rồi!"},{"start":75.38,"end":75.83,"text":"啊！","meaning":"A!"},{"start":75.88,"end":77.04,"text":"不要伤害我的阿蛤","meaning":"Đừng có động vào A Cáp của tui!"},{"start":77,"end":78.75,"text":"我马上给你转20万过来","meaning":"Tui chuyển 20 vạn cho ông ngay đây!"},{"start":78.79,"end":79.41,"text":"不不不","meaning":"Không không không."},{"start":79.42,"end":82.25,"text":"你刚刚不是说你有200万吗","meaning":"Ban nãy ông chẳng nói có hai trăm vạn hả?"},{"start":82.21,"end":82.66,"text":"啊","meaning":"Hả?"},{"start":82.67,"end":83.83,"text":"全部给我转过来","meaning":"Chuyển hết cho tao."},{"start":83.88,"end":85.29,"text":"否则我就让你的阿蛤…","meaning":"Không thì tao cho A Cáp của mày..."},{"start":85.25,"end":85.79,"text":"啊哈","meaning":"A Cáp!"},{"start":86.12,"end":87.62,"text":"阿蛤的钱保不住了","meaning":"Tiền của A Cáp không giữ nổi rồi."},{"start":87.88,"end":88.46,"text":"呜呜呜","meaning":"Huhuhu."},{"start":88.42,"end":89.37,"text":"谁让你嘚瑟","meaning":"Ai biểu ông khoe khoang chi."},{"start":89.38,"end":90.79,"text":"别哭了 救人要紧","meaning":"Đừng khóc nữa, cứu người quan trọng hơn."},{"start":90.79,"end":91.83,"text":"赶快转钱呐","meaning":"Mau chuyển tiền đi!"},{"start":91.83,"end":92.21,"text":"哦","meaning":"Ờ."},{"start":92.62,"end":93.71,"text":"举起手来","meaning":"Giơ tay lên!"},{"start":94.83,"end":96.16,"text":"你知道他们是诈骗吗","meaning":"Ông biết tụi nó là lừa đảo không?"},{"start":96.12,"end":96.79,"text":"不是诈骗！","meaning":"Không phải lừa đảo!"},{"start":96.75,"end":97.54,"text":"检察官","meaning":"Kiểm sát viên ơi,"},{"start":97.5,"end":98.91,"text":"阿蛤是真的被绑架了","meaning":"A Cáp bị bắt cóc thật mà."},{"start":98.92,"end":100.33,"text":"我都听到她的声音了","meaning":"Tui còn nghe giọng cổ rồi nè."},{"start":100.54,"end":101.58,"text":"那你听听这个","meaning":"Vậy ông nghe thử cái này đi."},{"start":101.54,"end":102.12,"text":"狂飙鸡","meaning":"Gà Cuồng Phong"},{"start":102.08,"end":102.91,"text":"我被抓了","meaning":"Tôi bị bắt rồi."},{"start":102.88,"end":104.33,"text":"要交一笔保证金","meaning":"Cần nộp một khoản tiền bảo lãnh."},{"start":104.29,"end":105.41,"text":"江湖救急","meaning":"Giang hồ cứu gấp!"},{"start":105.75,"end":107.41,"text":"诶 这不是我的声音吗","meaning":"Ơ, đây không phải giọng tui sao?"},{"start":107.46,"end":108.71,"text":"我没有说过这个话啊","meaning":"Tui có nói câu này bao giờ đâu!"},{"start":108.83,"end":110.29,"text":"跟刚刚的蛙芙蓉一样","meaning":"Giống y chang Ếch Phù Dung hồi nãy."},{"start":110.25,"end":112.08,"text":"他们都是用AI克隆的声音","meaning":"Tụi nó đều dùng AI nhái giọng hết."},{"start":112.04,"end":113,"text":"别说声音了","meaning":"Đừng nói giọng nữa,"},{"start":112.96,"end":113.79,"text":"他们还会换脸呢","meaning":"tụi nó còn biết đổi mặt nữa kìa."},{"start":113.75,"end":114.21,"text":"嗯","meaning":"Ừm."},{"start":114.42,"end":116.21,"text":"我是牛猫王我被抓了","meaning":"Tôi là Ngưu Miêu Vương, tôi bị bắt rồi."},{"start":116.79,"end":117.58,"text":"这张脸","meaning":"Cái mặt này"},{"start":117.71,"end":119.29,"text":"还是长在我自己身上帅啦","meaning":"vẫn là gắn trên người tui đẹp trai hơn."},{"start":120.17,"end":120.62,"text":"对了 那也就是说","meaning":"À mà, vậy nghĩa là"},{"start":121.42,"end":122.91,"text":"阿蛤没有被绑架哦？","meaning":"A Cáp không bị bắt cóc hả?"},{"start":122.88,"end":124.12,"text":"蛙芙蓉涉嫌洗钱","meaning":"Ếch Phù Dung bị tình nghi rửa tiền,"},{"start":124.08,"end":125.41,"text":"已经被警方控制了","meaning":"đã bị cảnh sát khống chế rồi."},{"start":125.38,"end":127.33,"text":"这事我们已经提前介入了","meaning":"Vụ này bên tôi đã vào cuộc từ sớm."},{"start":127.29,"end":127.91,"text":"介入？","meaning":"Vào cuộc?"},{"start":127.88,"end":130.2,"text":"是介入我和阿蛤的感情吗","meaning":"Là chen vào tình cảm của tui với A Cáp hả?"},{"start":131.08,"end":133.16,"text":"是介入案件 引导侦查","meaning":"Là vào cuộc vụ án, hướng dẫn điều tra."},{"start":133.12,"end":133.79,"text":"哦！","meaning":"Ồ!"},{"start":133.75,"end":135.04,"text":"那阿蛤被抓了","meaning":"Vậy A Cáp bị bắt rồi"},{"start":135.04,"end":136.58,"text":"那我不就见不到她了","meaning":"thì tui chẳng phải không gặp được cổ nữa sao?"},{"start":136.54,"end":137.2,"text":"放心吧","meaning":"Yên tâm đi."},{"start":137.17,"end":138.45,"text":"你们是有机会团聚的","meaning":"Hai người có cơ hội đoàn tụ mà."},{"start":138.96,"end":139.33,"text":"哦","meaning":"Ồ."},{"start":139.29,"end":139.87,"text":"真的吗","meaning":"Thật hả?"},{"start":139.83,"end":141.58,"text":"你可能会被关进去","meaning":"Ông có thể sẽ bị tống vô đó."},{"start":141.88,"end":142.33,"text":"啊","meaning":"Hả?"},{"start":142.38,"end":143.2,"text":"因为你的行为","meaning":"Vì hành vi của ông"},{"start":143.21,"end":144.7,"text":"也涉嫌帮助洗钱","meaning":"cũng bị nghi giúp rửa tiền."},{"start":144.67,"end":145.58,"text":"来说说你的事吧","meaning":"Nào, nói chuyện của ông đi."},{"start":145.75,"end":146.45,"text":"啊？","meaning":"Hả?"}]}