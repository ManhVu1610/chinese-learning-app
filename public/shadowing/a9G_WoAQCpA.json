{"videoId":"a9G_WoAQCpA","title":"特别篇：今年有兔兔","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":42,"source":"ocr","order":81,"segments":[{"start":3.73,"end":5.37,"text":"今年有兔兔","meaning":"Năm nay có Thỏ Thỏ,"},{"start":5.33,"end":7.17,"text":"你帅的着不住","meaning":"Đẹp trai không giấu nổi nha!"},{"start":7.4,"end":9.24,"text":"今年有兔兔","meaning":"Năm nay có Thỏ Thỏ,"},{"start":9.27,"end":10.84,"text":"减掉小肚肚","meaning":"Giảm bớt cái bụng bự,"},{"start":11.07,"end":13,"text":"升职又加薪","meaning":"Thăng chức lại tăng lương,"},{"start":12.97,"end":14.57,"text":"好运常相伴","meaning":"Vận may luôn kề bên,"},{"start":14.73,"end":17.34,"text":"兔年你要大进步","meaning":"Năm Thỏ mày phải tiến bộ vượt bậc!"},{"start":22.17,"end":24,"text":"今年有兔兔","meaning":"Năm nay có Thỏ Thỏ,"},{"start":24,"end":25.64,"text":"财神爷光顾","meaning":"Thần Tài ghé chơi,"},{"start":25.87,"end":27.67,"text":"今年有兔兔","meaning":"Năm nay có Thỏ Thỏ,"},{"start":27.73,"end":29.54,"text":"你一夜暴富","meaning":"Mày một đêm giàu sang!"},{"start":29.57,"end":32.8,"text":"去年那谁对你爱搭不理","meaning":"Năm ngoái cái người đó coi mày như không khí"},{"start":32.77,"end":33.3,"text":"哼！","meaning":"Hứ!"},{"start":33.3,"end":39.44,"text":"今年要让他羡慕","meaning":"Năm nay phải cho người ta ghen tị luôn!"}]}