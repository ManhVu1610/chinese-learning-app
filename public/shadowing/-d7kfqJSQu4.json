{"videoId":"-d7kfqJSQu4","title":"飞行勇士，人生癫疯！！","playlist":"DaihuaXiyou","channel":"DaihuaXiyou","duration":112,"source":"ocr","order":40,"segments":[{"start":2.38,"end":3.37,"text":"你俩跟伍佰","meaning":"Hai đứa mày với Ngũ Bách"},{"start":3.33,"end":4.79,"text":"是不是很熟啊","meaning":"có thân lắm không đấy?"},{"start":4.83,"end":5.5,"text":"为什么","meaning":"Sao cơ?"},{"start":5.54,"end":6.91,"text":"我看你俩扑腾的样子","meaning":"Tao thấy hai đứa mày quẫy đạp kiểu đó"},{"start":6.92,"end":7.96,"text":"挺像两个二百五","meaning":"y chang hai thằng ngố"},{"start":8.75,"end":9.75,"text":"你才二百五","meaning":"Mày mới là đồ ngố!"},{"start":11.12,"end":12.33,"text":"在陆地上学游泳","meaning":"Đi học bơi trên cạn"},{"start":12.29,"end":13.5,"text":"怎么不搞两个设备啊","meaning":"Sao không kiếm hai cái thiết bị đi?"},{"start":14.25,"end":15.12,"text":"什么设备啊","meaning":"Thiết bị gì cơ?"},{"start":15.08,"end":15.95,"text":"陆游器啊","meaning":"Máy bơi cạn đó"},{"start":16.67,"end":17.5,"text":"呃","meaning":"Ơ"},{"start":18.88,"end":20.2,"text":"我们不是在游泳啦","meaning":"Tụi tui đâu có bơi"},{"start":20.17,"end":22.83,"text":"我们是在练习飞行","meaning":"Tụi tui đang tập bay đó"},{"start":23.21,"end":23.95,"text":"为什么？","meaning":"Tại sao?"},{"start":23.92,"end":24.62,"text":"大王要攻打","meaning":"Đại vương sắp đánh"},{"start":24.58,"end":26.16,"text":"对面山的黄疯怪","meaning":"Hoàng Phong Quái ở núi bên kia"},{"start":26.12,"end":27.75,"text":"正在大量招募飞行员","meaning":"Bên đó đang tuyển phi công ầm ầm"},{"start":27.79,"end":28.5,"text":"选中了","meaning":"Mà được chọn rồi"},{"start":28.46,"end":30,"text":"说不定能走上人生…","meaning":"biết đâu lại bước lên đỉnh cao…"},{"start":29.96,"end":31.37,"text":"…妖生的巅峰呢","meaning":"…của yêu sinh đó chứ"},{"start":31.54,"end":32.45,"text":"哦","meaning":"Ồ"},{"start":32.88,"end":33.37,"text":"哎","meaning":"Haizz"},{"start":33.33,"end":34.41,"text":"他我就不说了","meaning":"Thằng này thì tao khỏi nói"},{"start":34.38,"end":35.54,"text":"你连个翅膀都没有","meaning":"Mày còn chẳng có cái cánh nào"},{"start":35.5,"end":36.79,"text":"你走什么巅峰","meaning":"Đỉnh cao cái nỗi gì"},{"start":36.75,"end":38.33,"text":"你只能走上疯癫吧你","meaning":"Mày chỉ lên được đỉnh điên thôi"},{"start":39,"end":40,"text":"疯癫人生","meaning":"Đời điên đảo"},{"start":40,"end":40.95,"text":"你懂什么","meaning":"Mày biết cái gì!"},{"start":40.92,"end":41.75,"text":"我只要每天","meaning":"Tao chỉ cần mỗi ngày"},{"start":41.71,"end":43.04,"text":"用手做飞行的姿势","meaning":"dùng tay làm động tác bay"},{"start":43.04,"end":43.66,"text":"早晚有一天","meaning":"Sớm muộn gì có ngày"},{"start":43.62,"end":44.95,"text":"会长出翅膀的","meaning":"cũng mọc cánh thôi"},{"start":45,"end":47.45,"text":"进化论没听过吗","meaning":"Chưa nghe thuyết tiến hóa à?"},{"start":48.25,"end":49.83,"text":"希望你能活到你进化那天","meaning":"Hy vọng mày sống được tới ngày mày tiến hóa"},{"start":49.79,"end":50.62,"text":"呵呵","meaning":"Hề hề"},{"start":51.46,"end":52.7,"text":"哎别笑我了","meaning":"Ê đừng cười tui nữa"},{"start":52.67,"end":54.41,"text":"为什么老大明明有翅膀","meaning":"Sao đại ca rõ ràng có cánh"},{"start":54.54,"end":56.95,"text":"他也飞不起来啊","meaning":"mà cũng bay không nổi vậy?"},{"start":56.92,"end":58.5,"text":"他本来就是只走地鸡","meaning":"Ổng vốn là con gà đi bộ mà"},{"start":58.46,"end":58.91,"text":"啊","meaning":"Hả"},{"start":59.08,"end":60,"text":"什么走地鸡","meaning":"Gà đi bộ cái gì?"},{"start":60.25,"end":61.75,"text":"鸡的祖先是霸王龙","meaning":"Tổ tiên của gà là khủng long bạo chúa đó"},{"start":61.71,"end":63.08,"text":"你见过霸王龙飞吗","meaning":"Mày thấy khủng long bạo chúa bay bao giờ chưa?"},{"start":63.25,"end":64.12,"text":"霸王龙","meaning":"Khủng long bạo chúa"},{"start":67.38,"end":68.66,"text":"嘿嘿嘿","meaning":"Hê hê hê"},{"start":68.67,"end":70.16,"text":"你笑什么？","meaning":"Mày cười cái gì?"},{"start":70.25,"end":71.41,"text":"我想起高兴的事","meaning":"Tui nhớ ra chuyện vui"},{"start":71.38,"end":72.54,"text":"我老婆生孩子","meaning":"Vợ tui đẻ con"},{"start":72.5,"end":72.96,"text":"哈哈哈哈哈哈","meaning":"Ha ha ha ha ha ha"},{"start":72.96,"end":73.83,"text":"啊？","meaning":"Hả?"},{"start":75.92,"end":77.54,"text":"我太奶上小学了","meaning":"Cụ nhà tui đi học tiểu học rồi"},{"start":78.54,"end":79.21,"text":"这样啊","meaning":"Ra là vậy"},{"start":79.17,"end":80.46,"text":"那确实值得高兴","meaning":"Vậy đúng là đáng mừng thật"},{"start":80.42,"end":81,"text":"啊","meaning":"À"},{"start":81.29,"end":81.91,"text":"啊什么","meaning":"À cái gì mà à"},{"start":81.92,"end":83.37,"text":"他太奶确实没上过小学","meaning":"Cụ nhà nó đúng là chưa từng học tiểu học"},{"start":83.33,"end":84.66,"text":"他们一家人都是文盲","meaning":"Cả nhà nó mù chữ hết"},{"start":84.62,"end":85.46,"text":"啊？","meaning":"Hả?"},{"start":88.46,"end":90.04,"text":"哎 攻打黄疯怪","meaning":"Ê, đánh Hoàng Phong Quái"},{"start":90,"end":91.33,"text":"我建议你还是不要去了","meaning":"tao khuyên mày đừng đi thì hơn"},{"start":91.29,"end":92.08,"text":"凭什么？","meaning":"Dựa vào đâu?"},{"start":92.04,"end":92.87,"text":"我就要去","meaning":"Tao cứ đòi đi đó"},{"start":92.83,"end":93.79,"text":"你听我劝嘛","meaning":"Nghe tao khuyên đi mà"},{"start":93.92,"end":94.54,"text":"要你管","meaning":"Kệ tao, mắc gì mày lo"},{"start":94.71,"end":95.37,"text":"我就要","meaning":"Tao cứ đòi đó"},{"start":95.33,"end":96.54,"text":"我还要当先锋呢","meaning":"Tao còn muốn làm tiên phong nữa kìa"},{"start":96.62,"end":97.08,"text":"哼","meaning":"Hứ"},{"start":97.96,"end":98.87,"text":"啊啊啊","meaning":"A a a"},{"start":98.83,"end":99.79,"text":"救命啊","meaning":"Cứu mạng!"},{"start":99.83,"end":101.21,"text":"我不当先锋了","meaning":"Tui không làm tiên phong nữa!"},{"start":101.54,"end":102.41,"text":"救命啊","meaning":"Cứu mạng với!"},{"start":102.46,"end":102.96,"text":"啊啊啊","meaning":"A a a"},{"start":103.46,"end":105.66,"text":"黄疯怪到底是什么妖怪","meaning":"Hoàng Phong Quái rốt cuộc là yêu quái gì vậy?"},{"start":105.62,"end":106.12,"text":"哦","meaning":"Ồ"},{"start":106.17,"end":107.46,"text":"是黄鼠狼成的精","meaning":"Là chồn vàng thành tinh đó"},{"start":107.42,"end":108.16,"text":"啊","meaning":"Hả"},{"start":108.42,"end":109.41,"text":"他先锋没当上","meaning":"Nó chưa kịp làm tiên phong"},{"start":109.38,"end":110.66,"text":"自己先疯了","meaning":"thì tự mình điên trước rồi"}]}